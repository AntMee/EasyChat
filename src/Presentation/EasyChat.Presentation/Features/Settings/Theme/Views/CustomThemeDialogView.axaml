<UserControl x:Class="EasyChat.Presentation.Features.Settings.Theme.Views.CustomThemeDialogView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:lang="clr-namespace:EasyChat.Presentation.Lang"
             xmlns:vm="clr-namespace:EasyChat.Presentation.Features.Settings.Theme"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
             d:DesignHeight="420"
             d:DesignWidth="400"
             x:DataType="vm:CustomThemeDialogViewModel"
             mc:Ignorable="d"
             MinWidth="360"
             MaxWidth="420"
             Width="400">
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Padding="22,18,22,0">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <Border Width="40" Height="40" CornerRadius="11"
                        Background="{DynamicResource PrimaryColor10}">
                    <icons:MaterialIcon Kind="PaletteOutline"
                                        Width="20" Height="20"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource PrimaryColor}" />
                </Border>
                <TextBlock Grid.Column="1"
                           Classes="Large" TextWrapping="Wrap"
                           Text="{Binding DialogTitle}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Margin="0,14,0,0" Padding="22,0" MaxHeight="480" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">
                <StackPanel>
                    <TextBlock Classes="Small" Margin="0,0,0,6" Text="{x:Static lang:Resources.ThemeName}" />
                    <TextBox Text="{Binding DisplayName}" shad:ControlAssist.Label="{x:Static lang:Resources.ThemeName}" />
                </StackPanel>

                <StackPanel>
                    <TextBlock Classes="Small" Margin="0,0,0,6" Text="{x:Static lang:Resources.PrimaryColor}" />
                    <ColorPicker Color="{Binding PrimaryColor, Mode=TwoWay}"
                                 IsAlphaEnabled="True"
                                 HorizontalAlignment="Stretch" />
                </StackPanel>

                <StackPanel>
                    <TextBlock Classes="Small" Margin="0,0,0,6" Text="{x:Static lang:Resources.AccentColor}" />
                    <ColorPicker Color="{Binding AccentColor, Mode=TwoWay}"
                                 IsAlphaEnabled="True"
                                 HorizontalAlignment="Stretch" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Classes="DialogFooter" Margin="0,12,0,0" Padding="22,14,22,18">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button Command="{Binding CancelCommand}"
                        Classes="Ghost"
                        MinWidth="88"
                        Content="{x:Static lang:Resources.Cancel}" />
                <Button Command="{Binding TryCreateThemeCommand}"
                        Classes="Primary"
                        MinWidth="96"
                        Content="{Binding SubmitLabel}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
