<UserControl x:Class="EasyChat.Presentation.Features.Settings.Prompts.Views.PromptView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:lang="clr-namespace:EasyChat.Presentation.Lang;assembly=EasyChat.Presentation"
             xmlns:viewModels="clr-namespace:EasyChat.Presentation.Features.Settings.Prompts;assembly=EasyChat.Presentation"
             xmlns:state="clr-namespace:EasyChat.Presentation.Features.Settings.State;assembly=EasyChat.Presentation"
             xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
             x:DataType="viewModels:PromptViewModel"
             mc:Ignorable="d"
             Focusable="True"
             Background="{DynamicResource GhostColor}">

    <Grid
          RowDefinitions="Auto,*" Margin="32,28,32,28" MaxWidth="1120" HorizontalAlignment="Stretch">

        <Grid RowDefinitions="Auto,Auto,Auto"
              ColumnDefinitions="*,Auto"
              Margin="0,0,0,8"
              ColumnSpacing="16">
            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="{x:Static lang:Resources.Prompts}"
                       Classes="h2"
                       VerticalAlignment="Center"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       AutomationProperties.Name="{x:Static lang:Resources.Prompts}" />

            <ContentControl Grid.Row="0" Grid.Column="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right">
                <Button Classes="Primary" Command="{Binding AddPromptCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <avalonia:MaterialIcon Kind="Plus" Width="16" Height="16" />
                        <TextBlock Text="{x:Static lang:Resources.AddPrompt}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </ContentControl>

            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                       Text="{x:Static lang:Resources.PromptParametersHint}"
                       LineHeight="20"
                       Foreground="{DynamicResource MutedColor}"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0"
                       MaxWidth="720"
                       HorizontalAlignment="Left" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <shad:Card
                    HasShadow="True"
                    IsVisible="{Binding HasNoPrompts}"
                    VerticalAlignment="Top">
                <StackPanel Spacing="12" HorizontalAlignment="Center" MaxWidth="420">
                    <avalonia:MaterialIcon Kind="TextBox"
                                           Width="36" Height="36"
                                           Foreground="{DynamicResource MutedColor}"
                                           HorizontalAlignment="Center" />
                    <TextBlock Text="{x:Static lang:Resources.PromptParametersHint}"
                               Classes="Muted"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center" />
                    <Button Classes="Primary"
                            HorizontalAlignment="Center"
                            Command="{Binding AddPromptCommand}"
                            Content="{x:Static lang:Resources.AddPrompt}" />
                </StackPanel>
            </shad:Card>

            <ScrollViewer IsVisible="{Binding HasPrompts}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Prompts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="state:PromptEntryState">
                            <shad:Card
                                    HasShadow="True"
                                    Margin="0,0,0,12"
                                    HorizontalAlignment="Stretch">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <Button
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Command="{Binding $parent[ItemsControl].((viewModels:PromptViewModel)DataContext).EditPromptCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="{x:Static lang:Resources.Edit}"
                                            VerticalContentAlignment="Center"
                                            Background="Transparent"
                                            BorderThickness="0">
                                        <StackPanel Spacing="8">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="{Binding Name}"
                                                           Classes="Large"
                                                           Foreground="{DynamicResource ForegroundColor}" />
                                                <shad:Badge IsVisible="{Binding IsDefault}"
                                                            Content="{x:Static lang:Resources.DefaultPrompt}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding ContentPreview}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource MutedColor}" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Row body already opens edit; keep default + delete only. -->
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="4"
                                                VerticalAlignment="Center">
                                        <Button Classes="Icon"
                                                Command="{Binding $parent[ItemsControl].((viewModels:PromptViewModel)DataContext).SetDefaultCommand}"
                                                CommandParameter="{Binding}"
                                                IsVisible="{Binding !IsDefault}"
                                                ToolTip.Tip="{x:Static lang:Resources.SetAsDefault}">
                                            <avalonia:MaterialIcon Kind="StarOutline" Width="16" Height="16" />
                                        </Button>
                                        <Button Classes="Destructive"
                                                Command="{Binding $parent[ItemsControl].((viewModels:PromptViewModel)DataContext).RemovePromptCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="{x:Static lang:Resources.Delete}">
                                            <avalonia:MaterialIcon Kind="TrashCan" Width="16" Height="16" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </shad:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
