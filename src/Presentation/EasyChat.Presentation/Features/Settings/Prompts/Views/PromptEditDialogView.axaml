<UserControl x:Class="EasyChat.Presentation.Features.Settings.Prompts.Views.PromptEditDialogView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:lang="clr-namespace:EasyChat.Presentation.Lang;assembly=EasyChat.Presentation"
             xmlns:dialogs="clr-namespace:EasyChat.Presentation.Features.Settings.Prompts;assembly=EasyChat.Presentation"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:DataType="dialogs:PromptEditDialogViewModel"
             mc:Ignorable="d"
             MinWidth="480"
             MaxWidth="600"
             MinHeight="520"
             MaxHeight="680"
             Width="560"
             Height="600">

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Padding="22,18,22,0">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <Border Width="40" Height="40" CornerRadius="11"
                        Background="{DynamicResource GhostColor}">
                    <icons:MaterialIcon Kind="TextBoxOutline"
                                        Width="20" Height="20"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource PrimaryColor}" />
                </Border>
                <TextBlock Grid.Column="1"
                           Classes="Large"
                           TextWrapping="Wrap"
                           Text="{x:Static lang:Resources.EditPrompt}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="0,14,0,0"
                Padding="22,0"
                HorizontalAlignment="Stretch"
                ClipToBounds="True">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          HorizontalContentAlignment="Stretch"
                          VerticalScrollBarVisibility="Auto">
                <Grid RowDefinitions="Auto,Auto"
                      RowSpacing="14"
                      HorizontalAlignment="Stretch">
                    <StackPanel Grid.Row="0" HorizontalAlignment="Stretch">
                        <TextBlock Classes="Small"
                                   Margin="0,0,0,6"
                                   Text="{x:Static lang:Resources.PromptName}" />
                        <TextBox Text="{Binding Name, Mode=TwoWay}"
                                 HorizontalAlignment="Stretch"
                                 MinWidth="0" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" HorizontalAlignment="Stretch">
                        <TextBlock Classes="Small"
                                   Margin="0,0,0,6"
                                   Text="{x:Static lang:Resources.PromptContent}" />
                        <TextBox Text="{Binding Content, Mode=TwoWay}"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 AcceptsReturn="True"
                                 MinHeight="250"
                                 MaxHeight="320"
                                 HorizontalAlignment="Stretch"
                                 MinWidth="0" />
                        <TextBlock Text="{x:Static lang:Resources.PromptParametersHint}"
                                   Classes="Muted"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2"
                Classes="DialogFooter"
                Margin="0,12,0,0"
                Padding="22,14,22,18">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="10">
                <Button Content="{x:Static lang:Resources.Cancel}"
                        Classes="Ghost"
                        MinWidth="88"
                        Command="{Binding CancelCommand}" />
                <Button Content="{x:Static lang:Resources.Save}"
                        Classes="Primary"
                        MinWidth="96"
                        Command="{Binding SaveCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
