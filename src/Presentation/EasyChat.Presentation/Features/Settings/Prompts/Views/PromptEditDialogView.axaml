<UserControl x:Class="EasyChat.Presentation.Features.Settings.Prompts.Views.PromptEditDialogView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:lang="clr-namespace:EasyChat.Presentation.Lang;assembly=EasyChat.Presentation"
             xmlns:dialogs="clr-namespace:EasyChat.Presentation.Features.Settings.Prompts;assembly=EasyChat.Presentation"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
             x:DataType="dialogs:PromptEditDialogViewModel"
             mc:Ignorable="d"
             MinWidth="480"
             MaxWidth="600"
             Width="560">

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Padding="22,18,22,0">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <Border Width="40" Height="40" CornerRadius="11"
                        Background="{DynamicResource PrimaryColor10}">
                    <icons:MaterialIcon Kind="TextBoxOutline"
                                        Width="20" Height="20"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource PrimaryColor}" />
                </Border>
                <TextBlock Grid.Column="1"
                           Classes="Large" TextWrapping="Wrap"
                           Text="{x:Static lang:Resources.EditPrompt}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Margin="0,14,0,0" Padding="22,0" MaxHeight="480" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">
                <StackPanel>
                    <TextBlock Classes="Small" Margin="0,0,0,6" Text="{x:Static lang:Resources.PromptName}" />
                    <TextBox Text="{Binding Name, Mode=TwoWay}"
                             shad:ControlAssist.Label="{x:Static lang:Resources.PromptName}" />
                </StackPanel>

                <StackPanel>
                    <TextBlock Classes="Small" Margin="0,0,0,6" Text="{x:Static lang:Resources.PromptContent}" />
                    <TextBox Text="{Binding Content, Mode=TwoWay}"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             AcceptsReturn="True"
                             MinHeight="200"
                             MaxHeight="300"
                             shad:ControlAssist.Label="{x:Static lang:Resources.PromptContent}" />
                    <TextBlock Text="{x:Static lang:Resources.PromptParametersHint}"
                               Classes="Muted" TextWrapping="Wrap"
                               Margin="0,6,0,0" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Margin="0,12,0,0" Padding="22,14,22,18" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Background="{DynamicResource CardBackgroundColor}" CornerRadius="{DynamicResource LgCornerRadius}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button Content="{x:Static lang:Resources.Cancel}"
                        Classes="Ghost"
                        MinWidth="88"
                        Command="{Binding CancelCommand}" />
                <Button Content="{x:Static lang:Resources.Save}"
                        Classes="Primary"
                        MinWidth="96"
                        Command="{Binding SaveCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
