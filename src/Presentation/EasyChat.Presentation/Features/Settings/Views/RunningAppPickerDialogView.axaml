<UserControl x:Class="EasyChat.Presentation.Features.Settings.Views.RunningAppPickerDialogView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:lang="clr-namespace:EasyChat.Presentation.Lang;assembly=EasyChat.Presentation"
             xmlns:dialogs="clr-namespace:EasyChat.Presentation.Features.Settings;assembly=EasyChat.Presentation"
             xmlns:converts="clr-namespace:EasyChat.Presentation.Foundation.Formatting;assembly=EasyChat.Presentation"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:DataType="dialogs:RunningAppPickerDialogViewModel"
             mc:Ignorable="d"
             MinWidth="520"
             MaxWidth="640"
             MinHeight="480"
             MaxHeight="640"
             Width="580"
             Height="540">

    <UserControl.Styles>
        <Style Selector="Button.RunningAppRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.RunningAppRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource GhostColor}" />
        </Style>
        <Style Selector="Button.RunningAppRow:pressed">
            <Setter Property="Opacity" Value="0.86" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <Border Padding="22,18,22,0">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <Border Width="40" Height="40" CornerRadius="11"
                        Background="{DynamicResource GhostColor}">
                    <icons:MaterialIcon Kind="Apps"
                                        Width="20" Height="20"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource PrimaryColor}" />
                </Border>
                <TextBlock Grid.Column="1"
                           Classes="Large"
                           TextWrapping="Wrap"
                           Text="{x:Static lang:Resources.RunningAppPickerTitle}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="22,14,22,0">
            <TextBox Text="{Binding SearchText, Mode=TwoWay}"
                     PlaceholderText="{x:Static lang:Resources.SearchRunningApps}"
                     HorizontalAlignment="Stretch"
                     MinWidth="0" />
        </Border>

        <Border Grid.Row="2" Margin="22,10,22,0" ClipToBounds="True">
            <Panel>
                <ProgressBar IsIndeterminate="True"
                             IsVisible="{Binding IsLoading}"
                             VerticalAlignment="Top" />
                <TextBlock Text="{x:Static lang:Resources.NoRunningApps}"
                           Classes="Muted"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsVisible="{Binding HasNoApps}" />
                <TextBlock Text="{x:Static lang:Resources.NoRunningAppSearchResults}"
                           Classes="Muted"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsVisible="{Binding HasNoFilteredResults}" />
                <TextBlock Text="{Binding ErrorMessage}"
                           Classes="Muted"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsVisible="{Binding HasError}" />
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Stretch"
                              VerticalScrollBarVisibility="Auto"
                              IsVisible="{Binding HasFilteredApps}">
                    <ItemsControl ItemsSource="{Binding FilteredApps}" HorizontalAlignment="Stretch">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Classes="RunningAppRow"
                                        Margin="0,0,0,6"
                                        Command="{Binding $parent[ItemsControl].((dialogs:RunningAppPickerDialogViewModel)DataContext).ToggleAppSelectionCommand}"
                                        CommandParameter="{Binding}">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <Border Width="30" Height="30" CornerRadius="7"
                                                Background="{DynamicResource GhostColor}"
                                                ClipToBounds="True">
                                            <Image Source="{Binding IconPng, Converter={x:Static converts:PngBytesToBitmapConverter.Instance}}"
                                                   Stretch="Uniform"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       Classes="Small"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle}"
                                                       Classes="Muted"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis"
                                                       IsVisible="{Binding Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="2"
                                                  IsChecked="{Binding IsSelected}"
                                                  IsHitTestVisible="False"
                                                  VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Panel>
        </Border>

        <Border Grid.Row="3"
                Classes="DialogFooter"
                Margin="0,12,0,0"
                Padding="22,14,22,18">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="10">
                <Button Content="{x:Static lang:Resources.Cancel}"
                        Classes="Ghost"
                        MinWidth="88"
                        Command="{Binding CancelCommand}" />
                <Button Content="{x:Static lang:Resources.AddToAppList}"
                        Classes="Primary"
                        MinWidth="96"
                        Command="{Binding ConfirmCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
