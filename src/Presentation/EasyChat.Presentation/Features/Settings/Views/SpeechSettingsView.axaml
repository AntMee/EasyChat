<UserControl x:Class="EasyChat.Presentation.Features.Settings.Views.SpeechSettingsView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:EasyChat.Presentation.Features.Settings"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
             xmlns:speech="clr-namespace:EasyChat.Contracts.Speech;assembly=EasyChat.Contracts"
             xmlns:converts="clr-namespace:EasyChat.Presentation.Foundation.Formatting;assembly=EasyChat.Presentation"
             xmlns:lang="clr-namespace:EasyChat.Presentation.Lang;assembly=EasyChat.Presentation"
             x:DataType="viewModels:SettingViewModel"
             mc:Ignorable="d">
        <UserControl.Styles>
        <Style Selector="ProgressBar.ModelProgress">
            <Setter Property="Height" Value="7" />
            <Setter Property="MinHeight" Value="7" />
            <Setter Property="MaxHeight" Value="7" />
            <Setter Property="Background" Value="{DynamicResource BorderColor30}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryColor}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="ProgressBar.ModelProgress /template/ Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="ProgressBar.ModelProgress /template/ Rectangle">
            <Setter Property="RadiusX" Value="4" />
            <Setter Property="RadiusY" Value="4" />
        </Style>
        <Style Selector="Button.AsrManualDownloadLink">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
    </UserControl.Styles>
    <StackPanel
                VerticalAlignment="Top"
                HorizontalAlignment="Stretch" Spacing="0">
            <Border Classes="SettingsSearchRow"
                    Classes.SearchResult="{Binding IsSearchMode}"
                    IsVisible="{Binding SearchText, Converter={x:Static viewModels:SettingsFieldVisibleConverter.Instance}, ConverterParameter='tts provider voice tts provider 语音 提供商'}">
            <Grid ColumnDefinitions="*,420"
                  MinHeight="40"
                  Margin="8,0"
                  ColumnSpacing="16"
                  >
                <TextBlock Text="{x:Static lang:Resources.Tts_Provider}"
                           Classes="Small"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
                <ContentControl Classes="SettingsField" Grid.Column="1"
                                MinWidth="180"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Stretch">
                    <ComboBox ItemsSource="{Binding TtsProviders}"
                              SelectedItem="{Binding SelectedTtsProvider}"
                              HorizontalAlignment="Stretch" />
                </ContentControl>
            </Grid>
            </Border>

            <Border Classes="SettingsSearchRow"
                    Classes.SearchResult="{Binding IsSearchMode}"
                    IsVisible="{Binding SearchText, Converter={x:Static viewModels:SettingsFieldVisibleConverter.Instance}, ConverterParameter='tts configure voices tts voice configure 配置语音 音色 配置 语音'}">
            <Button Content="{x:Static lang:Resources.Tts_ConfigureVoices}"
                    Command="{Binding ConfigureTtsCommand}"
                    HorizontalAlignment="Stretch"
                    Classes="Outline"
                    Margin="8,8,8,0"
                    />
            </Border>

        <Separator Margin="8,10" IsVisible="{Binding IsBrowseMode}" />
        <StackPanel Spacing="2" Margin="12,6,12,10"
                    IsVisible="{Binding SearchText, Converter={x:Static viewModels:SettingsFieldVisibleConverter.Instance}, ConverterParameter='asr models speech recognition model import delete ASR 模型 语音识别 导入 删除 语音识别 模型 导入 删除'}">
            <TextBlock Classes="Caption" FontWeight="Bold"
                       Text="{x:Static lang:Resources.AsrModels}" />
            <TextBlock Classes="Muted" TextWrapping="Wrap"
                       Text="{x:Static lang:Resources.AsrModelsDescription}" />
            <TextBlock Classes="Muted" TextWrapping="Wrap"
                       Text="{x:Static lang:Resources.AsrModelDownloadNotice}" />
        </StackPanel>

        <ItemsControl ItemsSource="{Binding VisibleAsrModelItems}"
                      Margin="4,0,8,0"
                      HorizontalAlignment="Stretch"
                      IsVisible="{Binding SearchText, Converter={x:Static viewModels:SettingsFieldVisibleConverter.Instance}, ConverterParameter='asr models speech recognition model download import delete ASR 模型 语音识别 下载 导入 删除'}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="viewModels:SpeechRecognitionModelDownloadItemViewModel">
                    <shad:Card HasShadow="False"
                               Padding="10,8"
                               Margin="0,0,0,6"
                               MinWidth="0"
                               HorizontalAlignment="Stretch">
                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="6" MinWidth="0">
                            <Border Width="24" Height="16" CornerRadius="2" ClipToBounds="True" VerticalAlignment="Center">
                                <Image Source="{Binding Model.Icon, Converter={x:Static converts:LanguageFlagConverters.ToIcon}}"
                                       Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="4" MinWidth="0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock FontWeight="SemiBold"
                                               Foreground="{DynamicResource ForegroundColor}"
                                               Text="{Binding DisplayName}" />
                                    <TextBlock Classes="Caption" VerticalAlignment="Center" Text="{Binding Id}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Classes="Muted"
                                               Foreground="{DynamicResource MutedColor}"
                                               Text="{Binding StatusText}" />
                                    <TextBlock Classes="Muted" Text="{Binding ProgressText}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button Classes="Icon"
                                        Command="{Binding $parent[ItemsControl].((viewModels:SettingViewModel)DataContext).DownloadAsrModelCommand}"
                                        CommandParameter="{Binding}"
                                        IsEnabled="{Binding $parent[ItemsControl].((viewModels:SettingViewModel)DataContext).CanDownloadAsrModel}"
                                        ToolTip.Tip="{Binding ActionText}"
                                        IsVisible="{Binding IsActionVisible}">
                                    <avalonia:MaterialIcon Kind="Download" Width="16" Height="16" />
                                </Button>
                                <Button Classes="Icon"
                                        Command="{Binding $parent[ItemsControl].((viewModels:SettingViewModel)DataContext).CancelAsrModelCommand}"
                                        CommandParameter="{Binding}"
                                        ToolTip.Tip="{x:Static lang:Resources.Cancel}"
                                        IsVisible="{Binding IsCancelVisible}">
                                    <avalonia:MaterialIcon Kind="Cancel" Width="16" Height="16" />
                                </Button>
                                <Button Classes="Icon"
                                        Command="{Binding $parent[ItemsControl].((viewModels:SettingViewModel)DataContext).DeleteAsrModelCommand}"
                                        CommandParameter="{Binding Model}"
                                        IsEnabled="{Binding $parent[ItemsControl].((viewModels:SettingViewModel)DataContext).CanImportAsrModel}"
                                        ToolTip.Tip="{x:Static lang:Resources.Delete}"
                                        IsVisible="{Binding IsDeleteVisible}">
                                    <avalonia:MaterialIcon Kind="Delete" Width="16" Height="16"
                                                           Foreground="{DynamicResource DestructiveColor}" />
                                </Button>
                            </StackPanel>
                            <ProgressBar Grid.Row="1" Grid.ColumnSpan="3"
                                         Classes="ModelProgress"
                                         Minimum="0" Maximum="1"
                                         Value="{Binding Progress}"
                                         Height="6"
                                         Margin="0,0,2,0"
                                         IsIndeterminate="{Binding IsProgressIndeterminate}" />
                            <TextBlock Grid.Row="2" Grid.ColumnSpan="3"
                                       Classes="Muted"
                                       Text="{Binding ErrorMessage}"
                                       IsVisible="{Binding IsFailed}"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </shad:Card>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button HorizontalAlignment="Center"
                Classes="Icon"
                Command="{Binding ToggleAsrModelListCommand}"
                ToolTip.Tip="{Binding AsrModelListToggleText}"
                IsVisible="{Binding IsAsrModelListToggleVisible}">
            <avalonia:MaterialIcon Kind="{Binding AsrModelListToggleIcon}" />
        </Button>

        <Grid ColumnDefinitions="Auto,Auto,*,Auto"
              ColumnSpacing="8"
              HorizontalAlignment="Stretch"
              Margin="8,0,8,8"
              IsVisible="{Binding SearchText, Converter={x:Static viewModels:SettingsFieldVisibleConverter.Instance}, ConverterParameter='asr models speech recognition model download import delete ASR 模型 语音识别 下载 导入 删除'}">
            <Button Grid.Column="0"
                    Classes="Ghost"
                    Click="ImportAsrModelFolder_OnClick"
                    IsEnabled="{Binding CanImportAsrModel}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <avalonia:MaterialIcon Kind="FolderOpen" Width="16" Height="16" />
                    <TextBlock Text="{x:Static lang:Resources.ImportAsrModelFolder}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Grid.Column="1"
                    Classes="Ghost"
                    Click="ImportAsrModelArchive_OnClick"
                    IsEnabled="{Binding CanImportAsrModel}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <avalonia:MaterialIcon Kind="ArchiveArrowUp" Width="16" Height="16" />
                    <TextBlock Text="{x:Static lang:Resources.ImportAsrModelArchive}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Grid.Column="3"
                    Classes="AsrManualDownloadLink"
                    HorizontalAlignment="Right"
                    Command="{Binding OpenAsrModelDownloadsCommand}"
                    ToolTip.Tip="{x:Static lang:Resources.ManualDownloadAsrModels}">
                <TextBlock Text="{x:Static lang:Resources.ManualDownloadAsrModels}"
                           Foreground="{DynamicResource PrimaryColor}"
                           TextDecorations="Underline" />
            </Button>
        </Grid>

        <Border IsVisible="{Binding SearchText, Converter={x:Static viewModels:SettingsFieldVisibleConverter.Instance}, ConverterParameter='asr models speech recognition model import delete ASR 模型 语音识别 导入 删除 语音识别 模型 导入 删除'}">
        <ProgressBar Classes="ModelProgress"
                     IsIndeterminate="True"
                     Margin="8,2,8,0"
                     IsVisible="{Binding IsImportingAsrModel}" />
        </Border>

        <Border IsVisible="{Binding SearchText, Converter={x:Static viewModels:SettingsFieldVisibleConverter.Instance}, ConverterParameter='asr models speech recognition model import delete ASR 模型 语音识别 导入 删除 语音识别 模型 导入 删除'}">
        <TextBlock Classes="Muted"
                   Text="{x:Static lang:Resources.NoAsrModels}"
                   IsVisible="{Binding HasNoAsrModels}"
                   HorizontalAlignment="Center"
                   Margin="0,8" />
        </Border>

        <Border IsVisible="{Binding SearchText, Converter={x:Static viewModels:SettingsFieldVisibleConverter.Instance}, ConverterParameter='asr models speech recognition model import delete ASR 模型 语音识别 导入 删除 语音识别 模型 导入 删除'}">
        <ItemsControl
                      ItemsSource="{Binding VisibleAsrModels}"
                      IsVisible="{Binding HasImportedAsrModels}"
                      Margin="4,0,4,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="speech:SpeechRecognitionModel">
                    <shad:Card HasShadow="False"
                            Padding="8,6"
                            Margin="0,0,0,4"
                            HorizontalAlignment="Stretch">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" MinHeight="28">
                            <Border Width="24" Height="16" CornerRadius="2" ClipToBounds="True"
                                    VerticalAlignment="Center">
                                <Image Source="{Binding Icon, Converter={x:Static converts:LanguageFlagConverters.ToIcon}}"
                                       Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Converter={x:Static converts:SpeechRecognitionModelConverters.ToDisplayName}}"
                                           Foreground="{DynamicResource ForegroundColor}" />
                                <TextBlock Classes="Caption" VerticalAlignment="Center" Text="{Binding Id}" />
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Classes="Icon"
                                    Command="{Binding $parent[ItemsControl].((viewModels:SettingViewModel)DataContext).DeleteAsrModelCommand}"
                                    CommandParameter="{Binding}"
                                    IsEnabled="{Binding $parent[ItemsControl].((viewModels:SettingViewModel)DataContext).CanImportAsrModel}"
                                    ToolTip.Tip="{x:Static lang:Resources.Delete}">
                                <avalonia:MaterialIcon Kind="Delete" Width="16" Height="16"
                                                       Foreground="{DynamicResource DestructiveColor}" />
                            </Button>
                        </Grid>
                    </shad:Card>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        </Border>
</StackPanel>
</UserControl>
