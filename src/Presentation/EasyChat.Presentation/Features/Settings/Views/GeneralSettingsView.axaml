<UserControl x:Class="EasyChat.Presentation.Features.Settings.Views.GeneralSettingsView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:EasyChat.Presentation.Features.Settings"
             xmlns:lang="clr-namespace:EasyChat.Presentation.Lang;assembly=EasyChat.Presentation"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
             xmlns:converts="clr-namespace:EasyChat.Presentation.Foundation.Formatting;assembly=EasyChat.Presentation"
             xmlns:speech="clr-namespace:EasyChat.Contracts.Speech;assembly=EasyChat.Contracts"
             xmlns:ec="clr-namespace:EasyChat.Presentation.Shared.Controls;assembly=EasyChat.Presentation.Shared"
             x:DataType="viewModels:SettingViewModel"
             mc:Ignorable="d">
    <UserControl.Styles>
        <Style Selector="ProgressBar.ModelProgress">
            <Setter Property="Height" Value="7" />
            <Setter Property="MinHeight" Value="7" />
            <Setter Property="MaxHeight" Value="7" />
            <Setter Property="Background" Value="{DynamicResource BorderColor30}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryColor}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="ProgressBar.ModelProgress /template/ Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="ProgressBar.ModelProgress /template/ Rectangle">
            <Setter Property="RadiusX" Value="4" />
            <Setter Property="RadiusY" Value="4" />
        </Style>
    </UserControl.Styles>
    <StackPanel
                VerticalAlignment="Top"
                HorizontalAlignment="Stretch"
                Spacing="6">

        <Grid ColumnDefinitions="Auto,*"
              MinHeight="44"
              Margin="8,2"
              ColumnSpacing="16">
            <TextBlock Text="{x:Static lang:Resources.DisplayLanguage}"
                       Classes="Small"
                       VerticalAlignment="Center"
                       MinWidth="180" />
            <ContentControl Grid.Column="1"
                            MinWidth="180"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Stretch">
                <ec:LanguageSelector Languages="{Binding DisplayLanguages}"
                                     SelectedLanguage="{Binding SelectedDisplayLanguage, Mode=TwoWay}"
                                     HorizontalAlignment="Stretch" />
            </ContentControl>
        </Grid>

        <Grid ColumnDefinitions="Auto,*"
              MinHeight="44"
              Margin="8,2"
              ColumnSpacing="16">
            <TextBlock Text="{x:Static lang:Resources.NativeLanguage}"
                       Classes="Small"
                       VerticalAlignment="Center"
                       MinWidth="180" />
            <ContentControl Grid.Column="1"
                            MinWidth="180"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Stretch">
                <ec:LanguageSelector Languages="{Binding NativeLanguages}"
                                     SelectedLanguage="{Binding SelectedNativeLanguage, Mode=TwoWay}"
                                     HorizontalAlignment="Stretch" />
            </ContentControl>
        </Grid>

        <Grid ColumnDefinitions="Auto,*"
              MinHeight="44"
              Margin="8,2"
              ColumnSpacing="16">
            <TextBlock Text="{x:Static lang:Resources.ClosingBehavior}"
                       Classes="Small"
                       VerticalAlignment="Center"
                       MinWidth="180" />
            <ContentControl Grid.Column="1"
                            MinWidth="180"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Stretch">
                <ComboBox ItemsSource="{Binding ClosingBehaviors}"
                          SelectedItem="{Binding SelectedClosingBehavior}"
                          HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={x:Static converts:EnumToDescriptionConverter.Instance}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </ContentControl>
        </Grid>

        <Separator Margin="8,10" />

        <StackPanel Margin="12,6,12,10" Spacing="2">
            <TextBlock Classes="Caption" FontWeight="Bold"
                       Text="{x:Static lang:Resources.ApplicationData}" />
            <TextBlock Classes="Muted" TextWrapping="Wrap"
                       Text="{x:Static lang:Resources.ApplicationDataDescription}" />
        </StackPanel>

        <Grid ColumnDefinitions="Auto,*"
              MinHeight="44"
              Margin="8,2"
              ColumnSpacing="16">
            <TextBlock Text="{x:Static lang:Resources.ApplicationData}"
                       Classes="Small"
                       VerticalAlignment="Center"
                       MinWidth="180" />
            <ContentControl Grid.Column="1"
                            MinWidth="180"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Stretch">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox IsReadOnly="True" Text="{Binding ApplicationDataRoot}" />
                    <Button Grid.Column="1"
                            Classes="Icon"
                            Click="ChangeApplicationDataLocation_OnClick"
                            IsEnabled="{Binding CanChangeDataLocation}"
                            ToolTip.Tip="{x:Static lang:Resources.ChangeApplicationDataLocation}">
                        <avalonia:MaterialIcon Kind="FolderEdit" Width="16" Height="16" />
                    </Button>
                </Grid>
            </ContentControl>
        </Grid>

        <Separator Margin="8,10" />

        <StackPanel Margin="12,6,12,10" Spacing="2">
            <TextBlock Classes="Caption" FontWeight="Bold"
                       Text="{x:Static lang:Resources.OcrModels}" />
        </StackPanel>

        <Grid ColumnDefinitions="Auto,*"
              MinHeight="44"
              Margin="8,2"
              ColumnSpacing="16">
            <TextBlock Text="{x:Static lang:Resources.ProxyUrl}"
                       Classes="Small"
                       VerticalAlignment="Center"
                       MinWidth="180" />
            <ContentControl Grid.Column="1"
                            MinWidth="180"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Stretch">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="6">
                    <TextBox Text="{Binding ProxyConf.ProxyUrl}"
                             PlaceholderText="{x:Static lang:Resources.ProxyAddrQuestion}"
                             HorizontalAlignment="Stretch" />
                    <CheckBox Grid.Row="1"
                              IsChecked="{Binding OcrConf.UseProxy}"
                              HorizontalAlignment="Left">
                        <TextBlock Text="{x:Static lang:Resources.OcrUseProxy}"
                                   TextWrapping="Wrap" />
                    </CheckBox>
                </Grid>
            </ContentControl>
        </Grid>

        <ItemsControl 
                      ItemsSource="{Binding VisibleOcrModelItems}"
                      Margin="4,4,4,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="viewModels:OcrModelDownloadItemViewModel">
                    <shad:Card HasShadow="False"
                            Padding="10,8"
                            Margin="0,0,0,6"
                            HorizontalAlignment="Stretch">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                            <StackPanel Spacing="4">
                                <TextBlock FontWeight="SemiBold"
                                           Foreground="{DynamicResource ForegroundColor}"
                                           Text="{Binding DisplayName}" />
                                <TextBlock Classes="Muted"
                                           Text="{Binding Description}"
                                           TextWrapping="Wrap" />
                                <TextBlock Classes="Muted"
                                           Text="{Binding SupportedLanguagesSummary}"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding IsSupportedLanguageListInline}" />
                                <StackPanel Orientation="Horizontal"
                                            Spacing="2"
                                            IsVisible="{Binding IsSupportedLanguageListCompact}">
                                    <TextBlock VerticalAlignment="Center"
                                               Classes="Muted"
                                               Text="{Binding SupportedLanguagesSummary}" />
                                    <Button Classes="Icon"
                                            Width="28" Height="28"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding $parent[ItemsControl].((viewModels:SettingViewModel)DataContext).ShowOcrModelLanguagesCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="{x:Static lang:Resources.ViewOcrSupportedLanguages}">
                                        <avalonia:MaterialIcon Kind="HelpCircleOutline"
                                                               Width="16"
                                                               Height="16" />
                                    </Button>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Classes="Muted"
                                               Foreground="{DynamicResource MutedColor}"
                                               Text="{Binding StatusText}" />
                                    <TextBlock Classes="Muted"
                                               Text="{Binding ProgressText}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="4"
                                        VerticalAlignment="Center">
                                <Button Classes="Icon"
                                        Command="{Binding $parent[ItemsControl].((viewModels:SettingViewModel)DataContext).DownloadOcrModelCommand}"
                                        CommandParameter="{Binding}"
                                        ToolTip.Tip="{Binding ActionText}"
                                        IsVisible="{Binding IsActionVisible}">
                                    <avalonia:MaterialIcon Kind="Download" Width="16" Height="16" />
                                </Button>
                                <Button Classes="Icon"
                                        Command="{Binding $parent[ItemsControl].((viewModels:SettingViewModel)DataContext).CancelOcrModelCommand}"
                                        CommandParameter="{Binding}"
                                        ToolTip.Tip="{x:Static lang:Resources.Cancel}"
                                        IsVisible="{Binding IsCancelVisible}">
                                    <avalonia:MaterialIcon Kind="Cancel" Width="16" Height="16" />
                                </Button>
                                <Button Classes="Icon"
                                        Command="{Binding $parent[ItemsControl].((viewModels:SettingViewModel)DataContext).DeleteOcrModelCommand}"
                                        CommandParameter="{Binding}"
                                        ToolTip.Tip="{x:Static lang:Resources.Delete}"
                                        IsVisible="{Binding IsDeleteVisible}">
                                    <avalonia:MaterialIcon Kind="Delete" Width="16" Height="16"
                                                           Foreground="{DynamicResource DestructiveColor}" />
                                </Button>
                            </StackPanel>
                            <ProgressBar Grid.Row="1" Grid.ColumnSpan="2"
                                         Classes="ModelProgress"
                                         Minimum="0" Maximum="1"
                                         Value="{Binding Progress}"
                                         Height="6"
                                         IsVisible="{Binding IsProgressVisible}"
                                         IsIndeterminate="{Binding IsProgressIndeterminate}" />
                            <TextBlock Grid.Row="2" Grid.ColumnSpan="2"
                                       Classes="Muted"
                                       Text="{Binding ErrorMessage}"
                                       IsVisible="{Binding IsFailed}"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </shad:Card>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button HorizontalAlignment="Center"
                Classes="Icon"
                Command="{Binding ToggleOcrModelListCommand}"
                ToolTip.Tip="{Binding OcrModelListToggleText}"
                IsVisible="{Binding IsOcrModelListToggleVisible}">
            <avalonia:MaterialIcon Kind="{Binding OcrModelListToggleIcon}" />
        </Button>

        <Separator Margin="8,10" />

        <StackPanel Spacing="2" Margin="12,6,12,10">
            <TextBlock Classes="Caption" FontWeight="Bold"
                       Text="{x:Static lang:Resources.AsrModels}" />
            <TextBlock Classes="Muted" TextWrapping="Wrap"
                       Text="{x:Static lang:Resources.AsrModelsDescription}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal"
                    Spacing="8"
                    HorizontalAlignment="Stretch"
                    Margin="8,0,8,8">
            <Button Classes="Ghost"
                    Command="{Binding OpenAsrModelDownloadsCommand}"
                    IsEnabled="{Binding CanImportAsrModel}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <avalonia:MaterialIcon Kind="Download" Width="16" Height="16" />
                    <TextBlock Text="{x:Static lang:Resources.DownloadAsrModels}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Classes="Ghost"
                    Click="ImportAsrModelFolder_OnClick"
                    IsEnabled="{Binding CanImportAsrModel}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <avalonia:MaterialIcon Kind="FolderOpen" Width="16" Height="16" />
                    <TextBlock Text="{x:Static lang:Resources.ImportAsrModelFolder}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Classes="Ghost"
                    Click="ImportAsrModelArchive_OnClick"
                    IsEnabled="{Binding CanImportAsrModel}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <avalonia:MaterialIcon Kind="ArchiveArrowUp" Width="16" Height="16" />
                    <TextBlock Text="{x:Static lang:Resources.ImportAsrModelArchive}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>

        <ProgressBar Classes="ModelProgress"
                     IsIndeterminate="True"
                     Margin="8,2,8,0"
                     IsVisible="{Binding IsImportingAsrModel}" />

        <TextBlock Classes="Muted"
                   Text="{x:Static lang:Resources.NoAsrModels}"
                   IsVisible="{Binding HasNoAsrModels}"
                   HorizontalAlignment="Center"
                   Margin="0,8" />

        <ItemsControl 
                      ItemsSource="{Binding VisibleAsrModels}"
                      IsVisible="{Binding HasAsrModels}"
                      Margin="4,0,4,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="speech:SpeechRecognitionModel">
                    <shad:Card HasShadow="False"
                            Padding="8,6"
                            Margin="0,0,0,4"
                            HorizontalAlignment="Stretch">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" MinHeight="28">
                            <Border Width="24" Height="16" CornerRadius="2" ClipToBounds="True"
                                    VerticalAlignment="Center">
                                <Image Source="{Binding Icon, Converter={x:Static converts:LanguageFlagConverters.ToIcon}}"
                                       Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{Binding Converter={x:Static converts:SpeechRecognitionModelConverters.ToDisplayName}}"
                                           Foreground="{DynamicResource ForegroundColor}" />
                                <TextBlock Classes="Caption"
                                           Text="{Binding Id}" />
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Classes="Icon"
                                    Command="{Binding $parent[ItemsControl].((viewModels:SettingViewModel)DataContext).DeleteAsrModelCommand}"
                                    CommandParameter="{Binding}"
                                    IsEnabled="{Binding $parent[ItemsControl].((viewModels:SettingViewModel)DataContext).CanImportAsrModel}"
                                    ToolTip.Tip="{x:Static lang:Resources.Delete}">
                                <avalonia:MaterialIcon Kind="Delete" Width="16" Height="16"
                                                       Foreground="{DynamicResource DestructiveColor}" />
                            </Button>
                        </Grid>
                    </shad:Card>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button HorizontalAlignment="Center"
                Classes="Icon"
                Command="{Binding ToggleAsrModelListCommand}"
                ToolTip.Tip="{Binding AsrModelListToggleText}"
                IsVisible="{Binding IsAsrModelListToggleVisible}">
            <avalonia:MaterialIcon Kind="{Binding AsrModelListToggleIcon}" />
        </Button>
    </StackPanel>
</UserControl>
