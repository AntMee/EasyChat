<UserControl x:Class="EasyChat.Presentation.Features.Settings.Views.GeneralSettingsView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:viewModels="clr-namespace:EasyChat.Presentation.Features.Settings"
             xmlns:lang="clr-namespace:EasyChat.Presentation.Lang;assembly=EasyChat.Presentation"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:converts="clr-namespace:EasyChat.Presentation.Foundation.Formatting;assembly=EasyChat.Presentation"
             xmlns:speech="clr-namespace:EasyChat.Contracts.Speech;assembly=EasyChat.Contracts"
             xmlns:dataConverters="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             x:DataType="viewModels:SettingViewModel"
             mc:Ignorable="d">
    <StackPanel Spacing="12">
        <suki:GlassCard>
            <StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="30" Margin="0 5 0 5">
                    <TextBlock FontWeight="Bold" VerticalAlignment="Center"
                               Text="{x:Static lang:Resources.DisplayLanguage}" />
                    <ComboBox ItemsSource="{Binding DisplayLanguages}"
                              SelectedItem="{Binding SelectedDisplayLanguage}"
                              MinWidth="150">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border ClipToBounds="True" CornerRadius="2" Width="20" Height="14"
                                            IsVisible="{Binding Icon, Converter={x:Static dataConverters:StringConverters.IsNotNullOrEmpty}}">
                                        <Image Source="{Binding Icon, Converter={x:Static converts:LanguageFlagConverters.ToIcon}}"
                                               Stretch="UniformToFill" />
                                    </Border>
                                    <TextBlock Text="{Binding Converter={x:Static converts:LanguageSettingsConverters.ToDisplayName}}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource SukiText}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="30" Margin="0 5 0 5">
                    <TextBlock FontWeight="Bold" VerticalAlignment="Center"
                               Text="{x:Static lang:Resources.NativeLanguage}" />
                    <ComboBox ItemsSource="{Binding NativeLanguages}"
                              SelectedItem="{Binding SelectedNativeLanguage}"
                              MinWidth="150">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border ClipToBounds="True" CornerRadius="2" Width="20" Height="14"
                                            IsVisible="{Binding Icon, Converter={x:Static dataConverters:StringConverters.IsNotNullOrEmpty}}">
                                        <Image Source="{Binding Icon, Converter={x:Static converts:LanguageFlagConverters.ToIcon}}"
                                               Stretch="UniformToFill" />
                                    </Border>
                                    <TextBlock Text="{Binding Converter={x:Static converts:LanguageSettingsConverters.ToDisplayName}}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource SukiText}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="30" Margin="0 5 0 5">
                    <TextBlock FontWeight="Bold" VerticalAlignment="Center"
                               Text="{x:Static lang:Resources.ClosingBehavior}" />
                    <ComboBox ItemsSource="{Binding ClosingBehaviors}"
                              SelectedItem="{Binding SelectedClosingBehavior}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={x:Static converts:EnumToDescriptionConverter.Instance}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </StackPanel>
        </suki:GlassCard>

        <suki:GlassCard>
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                <TextBlock Grid.ColumnSpan="2" FontSize="16" FontWeight="Bold"
                           Text="{x:Static lang:Resources.ApplicationData}" />
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,10"
                           Foreground="{DynamicResource SukiLowText}"
                           Text="{x:Static lang:Resources.ApplicationDataDescription}"
                           TextWrapping="Wrap" />
                <TextBox Grid.Row="2" Margin="0,0,8,0" IsReadOnly="True"
                         Text="{Binding ApplicationDataRoot}" />
                <Button Grid.Row="2" Grid.Column="1" Width="36" Height="36" Padding="7"
                        Click="ChangeApplicationDataLocation_OnClick"
                        IsEnabled="{Binding CanChangeDataLocation}"
                        ToolTip.Tip="{x:Static lang:Resources.ChangeApplicationDataLocation}">
                    <avalonia:MaterialIcon Kind="FolderEdit" />
                </Button>
            </Grid>
        </suki:GlassCard>

        <suki:GlassCard>
            <StackPanel Spacing="10">
                <TextBlock FontSize="16" FontWeight="Bold"
                           Text="{x:Static lang:Resources.OcrModels}" />
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <TextBlock VerticalAlignment="Center" Text="{x:Static lang:Resources.ProxyUrl}" />
                    <TextBox MinWidth="300"
                             Text="{Binding ProxyConf.ProxyUrl}"
                             PlaceholderText="{x:Static lang:Resources.ProxyAddrQuestion}" />
                    <CheckBox Content="{x:Static lang:Resources.OcrUseProxy}"
                              IsChecked="{Binding OcrConf.UseProxy}"
                              VerticalAlignment="Center" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding VisibleOcrModelItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:OcrModelDownloadItemViewModel">
                            <Border Background="{DynamicResource SukiCardBackground}"
                                    BorderBrush="{DynamicResource SukiControlBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12"
                                    Margin="0 3">
                                <Grid ColumnDefinitions="2*,Auto" RowDefinitions="Auto,Auto,Auto">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Foreground="{DynamicResource SukiLowText}"
                                                       Text="{Binding StatusText}" />
                                            <TextBlock Foreground="{DynamicResource SukiLowText}"
                                                       Text="{Binding ProgressText}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <Button Width="32" Height="32" Padding="6"
                                                Command="{Binding $parent[ItemsControl].((viewModels:SettingViewModel)DataContext).DownloadOcrModelCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="{Binding ActionText}"
                                                IsVisible="{Binding IsActionVisible}">
                                            <avalonia:MaterialIcon Kind="Download" />
                                        </Button>
                                        <Button Width="32" Height="32" Padding="6"
                                                Command="{Binding $parent[ItemsControl].((viewModels:SettingViewModel)DataContext).CancelOcrModelCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="{x:Static lang:Resources.Cancel}"
                                                IsVisible="{Binding IsCancelVisible}">
                                            <avalonia:MaterialIcon Kind="Cancel" />
                                        </Button>
                                        <Button Width="32" Height="32" Padding="6"
                                                Command="{Binding $parent[ItemsControl].((viewModels:SettingViewModel)DataContext).DeleteOcrModelCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="{x:Static lang:Resources.Delete}"
                                                IsVisible="{Binding IsDeleteVisible}">
                                            <avalonia:MaterialIcon Kind="Delete" />
                                        </Button>
                                    </StackPanel>
                                    <ProgressBar Grid.Row="1" Grid.ColumnSpan="2"
                                                 Minimum="0" Maximum="1"
                                                 Value="{Binding Progress}"
                                                 Height="6"
                                                 IsVisible="{Binding IsProgressVisible}"
                                                 IsIndeterminate="{Binding IsProgressIndeterminate}"
                                                 Margin="0 8 0 0" />
                                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2"
                                               Foreground="{DynamicResource SukiLowText}"
                                               Text="{Binding ErrorMessage}"
                                               IsVisible="{Binding IsFailed}"
                                               TextWrapping="Wrap"
                                               Margin="0 6 0 0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button HorizontalAlignment="Center"
                        Width="32" Height="32" Padding="6"
                        Command="{Binding ToggleOcrModelListCommand}"
                        ToolTip.Tip="{Binding OcrModelListToggleText}"
                        IsVisible="{Binding IsOcrModelListToggleVisible}">
                    <avalonia:MaterialIcon Kind="{Binding OcrModelListToggleIcon}" />
                </Button>
            </StackPanel>
        </suki:GlassCard>

        <suki:GlassCard>
            <StackPanel Spacing="10">
                <StackPanel Spacing="3">
                    <TextBlock FontSize="16" FontWeight="Bold"
                               Text="{x:Static lang:Resources.AsrModels}" />
                    <TextBlock Foreground="{DynamicResource SukiLowText}"
                               Text="{x:Static lang:Resources.AsrModelsDescription}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <WrapPanel HorizontalAlignment="Right">
                    <Button Command="{Binding OpenAsrModelDownloadsCommand}"
                            Margin="4" IsEnabled="{Binding CanImportAsrModel}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <avalonia:MaterialIcon Kind="Download" />
                            <TextBlock Text="{x:Static lang:Resources.DownloadAsrModels}" />
                        </StackPanel>
                    </Button>
                    <Button Click="ImportAsrModelFolder_OnClick"
                            Margin="4" IsEnabled="{Binding CanImportAsrModel}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <avalonia:MaterialIcon Kind="FolderOpen" />
                            <TextBlock Text="{x:Static lang:Resources.ImportAsrModelFolder}" />
                        </StackPanel>
                    </Button>
                    <Button Click="ImportAsrModelArchive_OnClick"
                            Margin="4" IsEnabled="{Binding CanImportAsrModel}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <avalonia:MaterialIcon Kind="ArchiveArrowUp" />
                            <TextBlock Text="{x:Static lang:Resources.ImportAsrModelArchive}" />
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <ProgressBar Height="4" IsIndeterminate="True"
                             IsVisible="{Binding IsImportingAsrModel}" />

                <TextBlock Foreground="{DynamicResource SukiLowText}"
                           Text="{x:Static lang:Resources.NoAsrModels}"
                           IsVisible="{Binding HasNoAsrModels}" />
                <ItemsControl ItemsSource="{Binding AsrModels}"
                              IsVisible="{Binding HasAsrModels}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="speech:SpeechRecognitionModel">
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,3" MinHeight="36">
                                <Border Width="24" Height="16" CornerRadius="2" ClipToBounds="True"
                                        VerticalAlignment="Center">
                                    <Image Source="{Binding Icon, Converter={x:Static converts:LanguageFlagConverters.ToIcon}}"
                                           Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Converter={x:Static converts:SpeechRecognitionModelConverters.ToDisplayName}}" />
                                    <TextBlock Text="{Binding Id}" FontSize="11"
                                               Foreground="{DynamicResource SukiLowText}" />
                                </StackPanel>
                                <Button Grid.Column="2" Classes="Basic Danger" Width="32" Height="32" Padding="4"
                                        Command="{Binding $parent[ItemsControl].((viewModels:SettingViewModel)DataContext).DeleteAsrModelCommand}"
                                        CommandParameter="{Binding}"
                                        IsEnabled="{Binding $parent[ItemsControl].((viewModels:SettingViewModel)DataContext).CanImportAsrModel}"
                                        ToolTip.Tip="{x:Static lang:Resources.Delete}">
                                    <avalonia:MaterialIcon Kind="Delete" Width="18" Height="18" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </suki:GlassCard>
    </StackPanel>
</UserControl>
