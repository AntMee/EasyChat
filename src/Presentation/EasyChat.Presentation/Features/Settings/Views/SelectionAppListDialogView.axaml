<UserControl x:Class="EasyChat.Presentation.Features.Settings.Views.SelectionAppListDialogView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:lang="clr-namespace:EasyChat.Presentation.Lang;assembly=EasyChat.Presentation"
             xmlns:dialogs="clr-namespace:EasyChat.Presentation.Features.Settings;assembly=EasyChat.Presentation"
             xmlns:converts="clr-namespace:EasyChat.Presentation.Foundation.Formatting;assembly=EasyChat.Presentation"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:DataType="dialogs:SelectionAppListDialogViewModel"
             mc:Ignorable="d"
             MinWidth="520"
             MaxWidth="640"
             MinHeight="420"
             MaxHeight="600"
             Width="580"
             Height="520">

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Padding="22,18,22,0">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <Border Width="40" Height="40" CornerRadius="11"
                        Background="{DynamicResource GhostColor}">
                    <icons:MaterialIcon Kind="FormatListBulleted"
                                        Width="20" Height="20"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource PrimaryColor}" />
                </Border>
                <TextBlock Grid.Column="1"
                           Classes="Large"
                           TextWrapping="Wrap"
                           Text="{x:Static lang:Resources.SelectionAppListTitle}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      Margin="22,14,22,0"
                      MaxHeight="360"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="14">
                <ItemsControl ItemsSource="{Binding Apps}" IsVisible="{Binding HasApps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Classes="SelectionAppRow"
                                    Padding="10,6"
                                    Margin="0,0,0,6"
                                    CornerRadius="10">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <Border Width="26" Height="26" CornerRadius="6"
                                            Background="{DynamicResource GhostColor}"
                                            ClipToBounds="True">
                                        <Image Source="{Binding IconPng, Converter={x:Static converts:PngBytesToBitmapConverter.Instance}}"
                                               Stretch="Uniform"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Classes="Small"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Description}"
                                                   Classes="Muted"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            Classes="Icon"
                                            ToolTip.Tip="{x:Static lang:Resources.Delete}"
                                            Command="{Binding $parent[ItemsControl].((dialogs:SelectionAppListDialogViewModel)DataContext).RemoveAppCommand}"
                                            CommandParameter="{Binding}">
                                        <icons:MaterialIcon Kind="TrashCan" Width="16" Height="16"
                                                            Foreground="{DynamicResource DestructiveColor}" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{x:Static lang:Resources.SelectionFilterEmptyList}"
                           Classes="Muted"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Margin="0,12"
                           IsVisible="{Binding HasNoApps}" />

                <Button MinHeight="56"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Center"
                        Background="{DynamicResource PrimaryColor10}"
                        BorderBrush="{DynamicResource BorderColor60}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource LgCornerRadius}"
                        Padding="14,12"
                        Command="{Binding AddRunningAppsCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                        <icons:MaterialIcon Kind="Plus" Width="18" Height="18"
                                            Foreground="{DynamicResource PrimaryColor}" />
                        <TextBlock Text="{x:Static lang:Resources.AddRunningApps}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource ForegroundColor}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Classes="DialogFooter"
                Margin="0,12,0,0"
                Padding="22,14,22,18">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="{x:Static lang:Resources.Close}"
                        Classes="Ghost"
                        MinWidth="88"
                        Command="{Binding CloseCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
