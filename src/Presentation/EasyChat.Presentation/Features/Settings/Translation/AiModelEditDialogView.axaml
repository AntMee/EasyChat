<UserControl x:Class="EasyChat.Views.AiModels.AiModelEditDialogView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:EasyChat.ViewModels.AiModels"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:lang="clr-namespace:EasyChat.Lang;assembly=EasyChat.Presentation"
             xmlns:config="clr-namespace:EasyChat.Contracts.Settings;assembly=EasyChat.Contracts"
             xmlns:converts="clr-namespace:EasyChat.Converters;assembly=EasyChat.Presentation"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="400"
             x:DataType="viewModels:AiModelEditDialogViewModel"
             Width="400">
    <StackPanel Spacing="15">
        <!-- Model Type Selection -->
        <StackPanel Spacing="8">
            <TextBlock Text="{x:Static lang:Resources.ModelType}" FontWeight="SemiBold" />
            <ComboBox ItemsSource="{Binding AvailableModelTypes}"
                      SelectedItem="{Binding SelectedModelType}"
                      HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="config:AiModelType">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Panel Width="20" Height="20">
                                <Border ClipToBounds="True" CornerRadius="4">
                                    <Image Source="{Binding Converter={x:Static converts:AiModelTypeConverters.ToIcon}}"
                                           Stretch="UniformToFill" />
                                </Border>
                            </Panel>
                            <TextBlock Text="{Binding}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SukiText}" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <!-- Name (for all model types) -->
        <StackPanel Spacing="8">
            <TextBlock Text="{x:Static lang:Resources.ModelName}" FontWeight="SemiBold" />
            <TextBox Text="{Binding Name}"
                     PlaceholderText="{x:Static lang:Resources.ModelName}"
                     suki:TextBoxExtensions.AddDeleteButton="True" />
        </StackPanel>

        <!-- API URL -->
        <StackPanel Spacing="8">
            <TextBlock Text="API URL" FontWeight="SemiBold" />
            <TextBox Text="{Binding ApiUrl}"
                     PlaceholderText="https://api.example.com"
                     suki:TextBoxExtensions.AddDeleteButton="True" />
        </StackPanel>

        <!-- The key is needed by providers that protect their /models endpoint. -->
        <StackPanel Spacing="8">
            <TextBlock Text="API Key" FontWeight="SemiBold" />
            <TextBox Text="{Binding ApiKey}"
                     PlaceholderText="sk-..."
                     PasswordChar="*"
                     suki:TextBoxExtensions.AddDeleteButton="True" />
        </StackPanel>


        <!-- Model Selection -->
        <StackPanel Spacing="8">
            <TextBlock Text="{x:Static lang:Resources.Model}" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <ComboBox Grid.Column="0"
                          ItemsSource="{Binding AvailableModels}"
                          IsEditable="True"
                          SelectedItem="{Binding Model, Mode=TwoWay}"
                          Text="{Binding Model, Mode=TwoWay}"
                          HorizontalAlignment="Stretch" />
                <Button Grid.Column="1"
                        Width="32" Height="32" Padding="6"
                        Command="{Binding FetchModelsCommand}"
                        ToolTip.Tip="{x:Static lang:Resources.FetchModels}">
                    <avalonia:MaterialIcon Kind="Download" />
                </Button>
            </Grid>
            <TextBlock Text="{Binding FetchModelsError}"
                       IsVisible="{Binding FetchModelsError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Foreground="IndianRed"
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- Reasoning/thinking is opt-in because not every OpenAI-compatible provider supports it. -->
        <CheckBox Content="{x:Static lang:Resources.EnableThinking}"
                  IsChecked="{Binding EnableThinking}" />
        
        <!-- Use Proxy -->
        <CheckBox Content="{x:Static lang:Resources.UseProxy}"
                  IsChecked="{Binding UseProxy}" />

        <!-- Dialog Buttons -->
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0 15 0 0">
            <Button Content="{Binding ButtonText}"
                    Command="{Binding SaveCommand}"
                    Classes="Flat" />
            <Button Content="{x:Static lang:Resources.Cancel}"
                    Command="{Binding CancelCommand}" />
        </StackPanel>
    </StackPanel>
</UserControl>
