<Window xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
                 xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
                 xmlns:converters="clr-namespace:EasyChat.Presentation.Foundation.Formatting"
                 xmlns:lang="clr-namespace:EasyChat.Presentation.Lang"
                 xmlns:sharedControls="clr-namespace:EasyChat.Presentation.Shared.Controls;assembly=EasyChat.Presentation.Shared"
                 xmlns:vm="using:EasyChat.Presentation.Features.TextAssist"
                 x:Class="EasyChat.Presentation.Features.TextAssist.Views.TextAssistActionWindowView"
                 x:DataType="vm:TextAssistResultWindowViewModel"
                 Width="820" Height="520" WindowStartupLocation="CenterScreen" Title="{Binding Title}"
                 Foreground="{DynamicResource ForegroundColor}">
    <Grid Margin="24" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="14">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <icons:MaterialIcon Kind="{Binding WindowIcon}" Width="22" Height="22"
                                    Foreground="{DynamicResource PrimaryColor}" />
                <TextBlock Text="{Binding Title}" Classes="h4" />
            </StackPanel>
            <sharedControls:LanguageSelector Grid.Column="1"
                                             Width="180"
                                             Languages="{Binding Languages}"
                                             SelectedLanguage="{Binding SelectedSourceLanguage, Mode=TwoWay}"
                                             IsVisible="{Binding ShowLanguageSelector}" />
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="14">
            <shad:Card HasShadow="True" ClipToBounds="True">
                <TextBox Text="{Binding SourceText, Mode=TwoWay}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         BorderThickness="0"
                         Background="Transparent"
                         shad:ControlAssist.Label="{x:Static lang:Resources.TextAssistInputPlaceholderText}" />
            </shad:Card>
            <shad:Card Grid.Column="1" HasShadow="True" ClipToBounds="True">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding !IsBusy}">
                        <StackPanel Spacing="14">
                            <TextBlock Text="{Binding Result}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource ForegroundColor}" />
                            <StackPanel Spacing="8" IsVisible="{Binding HasPolishExplanations}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <icons:MaterialIcon Kind="BookOpenVariant" Foreground="{DynamicResource PrimaryColor}" />
                                    <TextBlock Text="{Binding PolishExplanationTitle}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource ForegroundColor}" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding PolishExplanations}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,7" Background="{DynamicResource GhostColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="{DynamicResource LgCornerRadius}" Padding="16">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="{Binding Category}" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource PrimaryColor}" />
                                                    <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource ForegroundColor}" />
                                                    <TextBlock Text="{Binding Revised}" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource MutedColor}"
                                                               IsVisible="{Binding HasRevised}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <shad:Loading IsVisible="{Binding IsBusy}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </shad:Card>
        </Grid>
        <TextBlock Grid.Row="2"
                   Text="{Binding ErrorMessage}"
                   Foreground="{DynamicResource DestructiveColor}"
                   TextWrapping="Wrap" />
        <!-- Sticky action bar: Retry + Copy as primary outcomes -->
        <shad:Card Grid.Row="3" HasShadow="False" Padding="16">
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <Button Classes="Ghost"
                        Command="{Binding RetryCommand}"
                        IsEnabled="{Binding !IsBusy}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <icons:MaterialIcon Kind="Refresh" Width="16" Height="16" />
                        <TextBlock Text="{x:Static lang:Resources.Retry}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="Primary"
                        Click="OnCopyClick"
                        IsEnabled="{Binding !IsBusy}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <icons:MaterialIcon Kind="ContentCopy" Width="16" Height="16" />
                        <TextBlock Text="{x:Static lang:Resources.Copy}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </shad:Card>
    </Grid>
</Window>
