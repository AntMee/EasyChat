<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EasyChat.Presentation.Features.TextAssist"
             xmlns:views="using:EasyChat.Presentation.Features.TextAssist.Views"
             xmlns:lang="clr-namespace:EasyChat.Presentation.Lang"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="EasyChat.Presentation.Features.TextAssist.Views.TextAssistView"
             x:DataType="vm:TextAssistViewModel">
    <Grid Margin="25" RowDefinitions="Auto,*" RowSpacing="16">
        <StackPanel Spacing="3">
            <TextBlock Text="{x:Static lang:Resources.TextAssistTranslate}" FontSize="28" FontWeight="Bold" />
            <TextBlock Text="{x:Static lang:Resources.TextAssistSubtitle}" Opacity="0.65" />
        </StackPanel>
        <views:TextAssistTranslationView Grid.Row="1" DataContext="{Binding Translation}" />
    </Grid>
</UserControl>
