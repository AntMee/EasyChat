<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EasyChat.Presentation.Features.TextAssist"
             xmlns:views="using:EasyChat.Presentation.Features.TextAssist.Views"
             xmlns:lang="clr-namespace:EasyChat.Presentation.Lang"
             xmlns:ec="clr-namespace:EasyChat.Presentation.Shared.Controls;assembly=EasyChat.Presentation.Shared"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
              x:Class="EasyChat.Presentation.Features.TextAssist.Views.TextAssistView"
             x:DataType="vm:TextAssistViewModel"
             Background="{DynamicResource GhostColor}">
    <Grid
          RowDefinitions="Auto,Auto,*"
          RowSpacing="12"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch" Margin="32,28,32,28" MaxWidth="1120">
        <Grid RowDefinitions="Auto,Auto,Auto"
              ColumnDefinitions="*,Auto"
              Margin="0,0,0,8"
              ColumnSpacing="16">
            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="{x:Static lang:Resources.TextAssist}"
                       Classes="h2"
                       VerticalAlignment="Center"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       AutomationProperties.Name="{x:Static lang:Resources.TextAssist}" />

            <ContentControl Grid.Row="0" Grid.Column="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right">
                <Panel>
                    <Button Classes="Primary"
                            Command="{Binding Translation.RunCommand}"
                            IsVisible="{Binding IsTranslationMode}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <avalonia:MaterialIcon Kind="Translate" Width="16" Height="16"
                                                   IsVisible="{Binding !Translation.IsBusy}" />
                            <TextBlock Text="{x:Static lang:Resources.TextAssistTranslate}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="Primary"
                            Command="{Binding Correction.RunCommand}"
                            IsVisible="{Binding IsCorrectionMode}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <avalonia:MaterialIcon Kind="Spellcheck" Width="16" Height="16"
                                                   IsVisible="{Binding !Correction.IsBusy}" />
                            <TextBlock Text="{x:Static lang:Resources.TextAssistCorrect}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Panel>
            </ContentControl>

            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                       Text="{x:Static lang:Resources.TextAssistSubtitle}"
                       Classes="Small"
                       LineHeight="20"
                       Foreground="{DynamicResource MutedColor}"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0"
                       MaxWidth="720"
                       HorizontalAlignment="Left" />


        </Grid>

        <TabControl Grid.Row="1"
                    HorizontalAlignment="Left"
                    SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <avalonia:MaterialIcon Kind="Translate" Width="16" Height="16"
                                               Foreground="{DynamicResource PrimaryColor}" />
                        <TextBlock Text="{x:Static lang:Resources.TextAssistTranslate}" FontWeight="SemiBold" />
                    </StackPanel>
                </TabItem.Header>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <avalonia:MaterialIcon Kind="Spellcheck" Width="16" Height="16"
                                               Foreground="{DynamicResource PrimaryColor}" />
                        <TextBlock Text="{x:Static lang:Resources.TextAssistCorrect}" FontWeight="SemiBold" />
                    </StackPanel>
                </TabItem.Header>
            </TabItem>
        </TabControl>

        <views:TextAssistTranslationView Grid.Row="2"
                                         DataContext="{Binding Translation}"
                                         HorizontalAlignment="Stretch"
                                         VerticalAlignment="Stretch"
                                         IsVisible="{Binding $parent[UserControl].((vm:TextAssistViewModel)DataContext).IsTranslationMode}" />
        <views:TextAssistCorrectionView Grid.Row="2"
                                        DataContext="{Binding Correction}"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        IsVisible="{Binding $parent[UserControl].((vm:TextAssistViewModel)DataContext).IsCorrectionMode}" />
    </Grid>
</UserControl>
