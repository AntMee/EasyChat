<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EasyChat.ViewModels.Pages"
             xmlns:views="using:EasyChat.Views.Pages"
             x:Class="EasyChat.Views.Pages.TextAssistTranslationPageView"
             x:DataType="vm:TextAssistTranslationPageViewModel">
    <Grid Margin="25">
        <views:TextAssistTranslationView DataContext="{Binding Translation}" />
    </Grid>
</UserControl>
