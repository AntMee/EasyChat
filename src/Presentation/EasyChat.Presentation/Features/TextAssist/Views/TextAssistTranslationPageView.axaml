<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EasyChat.Presentation.Features.TextAssist"
             xmlns:views="using:EasyChat.Presentation.Features.TextAssist.Views"
             x:Class="EasyChat.Presentation.Features.TextAssist.Views.TextAssistTranslationPageView"
             x:DataType="vm:TextAssistTranslationPageViewModel"
             Background="{DynamicResource GhostColor}"
             ClipToBounds="True">
    <Grid HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          Margin="24,20,24,20"
          MaxWidth="1120">
        <views:TextAssistTranslationView DataContext="{Binding Translation}"
                                         HorizontalAlignment="Stretch"
                                         VerticalAlignment="Stretch" />
    </Grid>
</UserControl>
