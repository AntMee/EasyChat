<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EasyChat.Presentation.Features.TextAssist"
             xmlns:controls="using:EasyChat.Presentation.Features.TextAssist.Controls"
             xmlns:dataConverters="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:converters="clr-namespace:EasyChat.Presentation.Foundation.Formatting"
             xmlns:lang="clr-namespace:EasyChat.Presentation.Lang"
             xmlns:sharedControls="clr-namespace:EasyChat.Presentation.Shared.Controls;assembly=EasyChat.Presentation.Shared"
             xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="EasyChat.Presentation.Features.TextAssist.Views.TextAssistCorrectionView"
             x:DataType="vm:TextAssistCorrectionViewModel">
    <UserControl.Styles>

        <Style Selector="StackPanel.EditorSections">
            <Setter Property="Spacing" Value="14" />
        </Style>
        <Style Selector="UserControl.Compact StackPanel.EditorSections">
            <Setter Property="Spacing" Value="8" />
        </Style>
        <Style Selector="TextBlock.SectionTitle">
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style Selector="UserControl.Compact TextBlock.SectionTitle">
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="shad|Card.OriginalEditorCard">
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style Selector="UserControl.Compact shad|Card.OriginalEditorCard">
            <Setter Property="Padding" Value="8" />
        </Style>
        <Style Selector="shad|Card.CorrectionResultCard">
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style Selector="UserControl.Compact shad|Card.CorrectionResultCard">
            <Setter Property="Padding" Value="8" />
        </Style>
        <Style Selector="Border.IssueCard">
            <Setter Property="Padding" Value="12" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="UserControl.Compact Border.IssueCard">
            <Setter Property="Padding" Value="8" />
        </Style>
        <!-- Floor only — parent * row grows the editor so the page is not hollow. -->
        <Style Selector="Grid.OriginalEditor">
            <Setter Property="MinHeight" Value="170" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="UserControl.Compact Grid.OriginalEditor">
            <Setter Property="MinHeight" Value="125" />
        </Style>
        <Style Selector="TextBox.OriginalTextBox">
            <Setter Property="MinHeight" Value="170" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="UserControl.Compact TextBox.OriginalTextBox">
            <Setter Property="MinHeight" Value="125" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="controls|CorrectionAnnotationLayer.OriginalAnnotation">
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="UserControl.Compact controls|CorrectionAnnotationLayer.OriginalAnnotation">
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="TextBox.VariantTextBox">
            <Setter Property="MinHeight" Value="55" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="UserControl.Compact TextBox.VariantTextBox">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Grid.EditorFooter">
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
        <Style Selector="UserControl.Compact Grid.EditorFooter">
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="*,Auto,Auto"
          RowSpacing="12"
          MinHeight="0"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">
        <Grid Grid.Row="0"
              MinHeight="0"
              ColumnDefinitions="1.05*,0.95*"
              ColumnSpacing="12">
            <shad:Card Grid.Column="0"
                       Classes="OriginalEditorCard"
                       VerticalAlignment="Stretch"
                       HorizontalAlignment="Stretch"
                       HasShadow="True"
                       ClipToBounds="True">
                <Grid RowDefinitions="Auto,*" RowSpacing="10" MinHeight="0">
                    <TextBlock Classes="SectionTitle"
                               Text="{x:Static lang:Resources.SourceLang}"
                               FontWeight="SemiBold" />
                    <Grid Grid.Row="1" Classes="OriginalEditor" MinHeight="0">
                        <TextBox x:Name="AnnotatedTextBox"
                                 Classes="OriginalTextBox"
                                 Text="{Binding InputText, Mode=TwoWay}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 PlaceholderText="{x:Static lang:Resources.TextAssistInputPlaceholderText}"
                                 VerticalAlignment="Stretch"
                                 VerticalContentAlignment="Top"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 PointerMoved="OnOriginalPointerMoved"
                                 PointerExited="OnOriginalPointerExited" />
                        <controls:CorrectionAnnotationLayer x:Name="AnnotationLayer"
                                                            Classes="OriginalAnnotation"
                                                            IsHitTestVisible="False"
                                                            Text="{Binding InputText}"
                                                            Issues="{Binding Issues}"
                                                            FontSize="16"
                                                            HorizontalAlignment="Stretch"
                                                            VerticalAlignment="Stretch" />
                        <Border x:Name="CorrectionHint"
                                IsVisible="False"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="12"
                                MaxWidth="420"
                                Background="{DynamicResource PrimaryColor}"
                                BorderBrush="{DynamicResource PrimaryColor}"
                                BorderThickness="1"
                                IsHitTestVisible="False"
                                CornerRadius="{DynamicResource LgCornerRadius}"
                                Padding="8,5">
                            <TextBlock x:Name="CorrectionHintText"
                                       Foreground="{DynamicResource PrimaryForegroundColor}"
                                       TextWrapping="Wrap" />
                        </Border>
                    </Grid>
                </Grid>
            </shad:Card>

            <shad:Card Grid.Column="1"
                       Classes="CorrectionResultCard"
                       HasShadow="True"
                       ClipToBounds="True">
                <Grid RowDefinitions="Auto,*"
                      RowSpacing="10"
                      MinHeight="0">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="8"
                          Margin="0,0,20,0">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="7">
                            <avalonia:MaterialIcon Kind="TextBoxEditOutline"
                                                   Width="16"
                                                   Height="16"
                                                   Foreground="{DynamicResource PrimaryColor}" />
                            <TextBlock Classes="SectionTitle"
                                       Text="{x:Static lang:Resources.TextAssistCorrectedResult}"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                        <shad:Loading Grid.Column="1"
                                      Width="18"
                                      Height="18"
                                      IsVisible="{Binding ShowResultLoadingIndicator}" />
                    </Grid>
                    <Grid Grid.Row="1" MinHeight="0">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Classes="EditorSections">
                                <TextBlock Text="{x:Static lang:Resources.TextAssistResultPlaceholder}"
                                           Classes="Muted"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding ShowResultPlaceholder}" />
                                <ItemsControl ItemsSource="{Binding CorrectionVariants}"
                                              IsVisible="{Binding HasCorrectedResults}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Classes="IssueCard"
                                                    Margin="0,0,0,8"
                                                    Background="{DynamicResource CardBackgroundColor}"
                                                    BorderBrush="{DynamicResource BorderColor}"
                                                    BorderThickness="1"
                                                    BoxShadow="{DynamicResource Shadow}"
                                                    ClipToBounds="True">
                                                <Grid ColumnDefinitions="*,Auto"
                                                      ColumnSpacing="8">
                                                    <StackPanel Spacing="6">
                                                        <TextBlock Text="{Binding Variant, StringFormat=方案 {0}}"
                                                                   Opacity="0.62"
                                                                   FontWeight="SemiBold" />
                                                        <TextBox Classes="VariantTextBox"
                                                                 Text="{Binding Text}"
                                                                 IsReadOnly="True"
                                                                 AcceptsReturn="True"
                                                                 TextWrapping="Wrap"
                                                                 FontSize="15"
                                                                 VerticalContentAlignment="Top"
                                                                 BorderThickness="0"
                                                                 Background="Transparent" />
                                                        <TextBlock Text="{Binding Translation}"
                                                                   Foreground="{DynamicResource ForegroundColor}"
                                                                   Opacity="0.58"
                                                                   TextWrapping="Wrap"
                                                                   IsVisible="{Binding Translation, Converter={x:Static dataConverters:StringConverters.IsNotNullOrEmpty}}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                            Classes="Icon"
                                                            Tag="{Binding}"
                                                            Click="OnCopyCorrectionClick"
                                                            ToolTip.Tip="{x:Static lang:Resources.Copy}"
                                                            VerticalAlignment="Top">
                                                        <avalonia:MaterialIcon Kind="ContentCopy" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Spacing="8"
                                            IsVisible="{Binding HasCorrectionIssues}">
                                    <TextBlock Classes="SectionTitle"
                                               Text="{x:Static lang:Resources.TextAssistIssues}"
                                               FontWeight="SemiBold" />
                                    <ItemsControl ItemsSource="{Binding Issues}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Classes="IssueCard"
                                                        Margin="0,0,0,6"
                                                        Background="{DynamicResource CardBackgroundColor}"
                                                        BorderBrush="{DynamicResource BorderColor}"
                                                        BorderThickness="1"
                                                        BoxShadow="{DynamicResource Shadow}"
                                                        ClipToBounds="True">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="{Binding DisplayCategory}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource ForegroundColor}" />
                                                        <TextBlock Text="{Binding Message}"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource ForegroundColor}" />
                                                        <TextBlock Text="{Binding Suggestion}"
                                                                   Foreground="{DynamicResource PrimaryColor}"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </shad:Card>
        </Grid>

        <shad:Card Grid.Row="1"
                IsVisible="{Binding IsConfigurationExpanded}" HasShadow="True" ClipToBounds="True">
            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Static lang:Resources.SourceLang}"
                                   Classes="Muted" />
                        <sharedControls:LanguageSelector Languages="{Binding Languages}"
                                                         SelectedLanguage="{Binding SelectedSourceLanguage, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="{x:Static lang:Resources.UsingAiModel}" Classes="Muted" Opacity="0.7" />
                        <ComboBox ItemsSource="{Binding AvailableAiModels}" SelectedItem="{Binding SelectedAiModel}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Panel Width="18" Height="18">
                                            <avalonia:MaterialIcon Kind="Translate" Opacity="0.65" />
                                            <Image Width="18" Height="18"
                                                   Source="{Binding ModelType, Converter={x:Static converters:AiModelTypeConverters.ToIcon}}" />
                                        </Panel>
                                        <TextBlock Text="{Binding Name}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Text="{x:Static lang:Resources.Prompts}" Classes="Muted" Opacity="0.7" />
                        <ComboBox ItemsSource="{Binding PromptEntries}"
                                  SelectedValue="{Binding SelectedPromptId}"
                                  SelectedValueBinding="{Binding Id}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </shad:Card>

        <Grid Grid.Row="2"
              Classes="EditorFooter"
              ColumnDefinitions="*,Auto,Auto,Auto"
              ColumnSpacing="8">
            <TextBlock Grid.Column="0"
                       Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource DestructiveColor}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Command="{Binding RunCommand}"
                    Classes="Primary EditorInlineRun"
                    HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <avalonia:MaterialIcon Kind="Spellcheck" IsVisible="{Binding !IsBusy}" />
                    <shad:Loading Width="18" Height="18" IsVisible="{Binding IsBusy}" />
                    <TextBlock Text="{x:Static lang:Resources.TextAssistCorrect}" />
                </StackPanel>
            </Button>
            <Button Grid.Column="2"
                    Command="{Binding CancelCommand}"
                    Classes="Ghost"
                    IsVisible="{Binding IsBusy}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <avalonia:MaterialIcon Kind="Stop" />
                    <TextBlock Text="{x:Static lang:Resources.Cancel}" />
                </StackPanel>
            </Button>
            <Button Grid.Column="3"
                    Classes="Ghost"
                    Command="{Binding ToggleConfigurationCommand}"
                    ToolTip.Tip="{Binding ConfigurationToggleText}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <avalonia:MaterialIcon Kind="{Binding ConfigurationToggleIcon}" Width="16" Height="16" />
                    <TextBlock Text="{Binding ConfigurationToggleText}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
