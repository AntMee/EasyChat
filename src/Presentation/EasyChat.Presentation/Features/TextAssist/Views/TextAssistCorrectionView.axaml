<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EasyChat.Presentation.Features.TextAssist"
             xmlns:controls="using:EasyChat.Presentation.Features.TextAssist.Controls"
             xmlns:dataConverters="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:converters="clr-namespace:EasyChat.Presentation.Foundation.Formatting"
             xmlns:lang="clr-namespace:EasyChat.Presentation.Lang"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="EasyChat.Presentation.Features.TextAssist.Views.TextAssistCorrectionView"
             x:DataType="vm:TextAssistCorrectionViewModel">
    <UserControl.Styles>
        <Style Selector="Button.ConfigurationToggle">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.ConfigurationRevealArea:pointerover Button.ConfigurationToggle">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
        <Style Selector="suki|GlassCard.EditorCard">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style Selector="UserControl.Compact suki|GlassCard.EditorCard">
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="9" />
        </Style>
        <Style Selector="StackPanel.EditorSections">
            <Setter Property="Spacing" Value="14" />
        </Style>
        <Style Selector="UserControl.Compact StackPanel.EditorSections">
            <Setter Property="Spacing" Value="8" />
        </Style>
        <Style Selector="TextBlock.SectionTitle">
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style Selector="UserControl.Compact TextBlock.SectionTitle">
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="suki|GlassCard.IssueCard">
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style Selector="UserControl.Compact suki|GlassCard.IssueCard">
            <Setter Property="Padding" Value="8" />
        </Style>
        <Style Selector="Grid.OriginalEditor">
            <Setter Property="MinHeight" Value="170" />
        </Style>
        <Style Selector="UserControl.Compact Grid.OriginalEditor">
            <Setter Property="MinHeight" Value="125" />
        </Style>
        <Style Selector="TextBox.OriginalTextBox">
            <Setter Property="MinHeight" Value="170" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style Selector="UserControl.Compact TextBox.OriginalTextBox">
            <Setter Property="MinHeight" Value="125" />
            <Setter Property="Padding" Value="8" />
        </Style>
        <Style Selector="controls|CorrectionAnnotationLayer.OriginalAnnotation">
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style Selector="UserControl.Compact controls|CorrectionAnnotationLayer.OriginalAnnotation">
            <Setter Property="Padding" Value="8" />
        </Style>
        <Style Selector="TextBox.VariantTextBox">
            <Setter Property="MinHeight" Value="55" />
        </Style>
        <Style Selector="UserControl.Compact TextBox.VariantTextBox">
            <Setter Property="MinHeight" Value="44" />
        </Style>
        <Style Selector="Grid.EditorFooter">
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
        <Style Selector="UserControl.Compact Grid.EditorFooter">
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="*,Auto,Auto,Auto" RowSpacing="0" MinHeight="0">
        <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Classes="EditorSections">
            <suki:GlassCard Classes="EditorCard">
                <StackPanel Spacing="10">
                    <TextBlock Classes="SectionTitle" Text="{x:Static lang:Resources.SourceLang}" FontWeight="SemiBold" />
                    <Grid Classes="OriginalEditor">
                        <TextBox x:Name="AnnotatedTextBox" Classes="OriginalTextBox" Text="{Binding InputText, Mode=TwoWay}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 PlaceholderText="{x:Static lang:Resources.TextAssistInputPlaceholderText}"
                                 VerticalContentAlignment="Top" BorderThickness="0" Background="Transparent"
                                 PointerMoved="OnOriginalPointerMoved"
                                 PointerExited="OnOriginalPointerExited" />
                        <controls:CorrectionAnnotationLayer x:Name="AnnotationLayer" Classes="OriginalAnnotation" IsHitTestVisible="False"
                                 Text="{Binding InputText}" Issues="{Binding Issues}"
                                 FontSize="16" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        <Border x:Name="CorrectionHint" IsVisible="False"
                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"
                                MaxWidth="420" Padding="10,7" Background="#F0293038"
                                CornerRadius="6" IsHitTestVisible="False">
                            <TextBlock x:Name="CorrectionHintText" Foreground="White"
                                       TextWrapping="Wrap" />
                        </Border>
                    </Grid>
                </StackPanel>
            </suki:GlassCard>

            <suki:GlassCard Classes="EditorCard" IsVisible="{Binding HasCorrectedResults}">
                <StackPanel Spacing="8">
                    <TextBlock Classes="SectionTitle" Text="{x:Static lang:Resources.TextAssistCorrectedResult}" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding CorrectionVariants}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                                    <StackPanel Spacing="3">
                                        <TextBox Classes="VariantTextBox" Text="{Binding Text}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                                 FontSize="18"
                                                 VerticalContentAlignment="Top" BorderThickness="0" Background="Transparent" />
                                        <TextBlock Text="{Binding Translation}" Foreground="{DynamicResource SukiText}" Opacity="0.58"
                                                   TextWrapping="Wrap" IsVisible="{Binding Translation, Converter={x:Static dataConverters:StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="Basic" Tag="{Binding}" Click="OnCopyCorrectionClick"
                                            ToolTip.Tip="{x:Static lang:Resources.Copy}" VerticalAlignment="Top">
                                        <avalonia:MaterialIcon Kind="ContentCopy" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </suki:GlassCard>

            <StackPanel Spacing="8" IsVisible="{Binding HasCorrectionIssues}">
                <TextBlock Classes="SectionTitle" Text="{x:Static lang:Resources.TextAssistIssues}" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding Issues}">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <suki:GlassCard Classes="IssueCard" Margin="0,0,0,6" CornerRadius="8">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding DisplayCategory}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Suggestion}" Foreground="{DynamicResource SukiPrimaryColor}" TextWrapping="Wrap" />
                            </StackPanel>
                        </suki:GlassCard>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

        </StackPanel>
        </ScrollViewer>

            <Border Grid.Row="1" Classes="ConfigurationRevealArea" Height="28"
                    Background="Transparent">
                <Grid>
                    <Border Height="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            Background="{DynamicResource SukiControlBorderBrush}" Opacity="0.8" />
                    <Button Classes="ConfigurationToggle" Width="42" Height="26" Padding="8,2"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="{DynamicResource SukiCardBackground}"
                            BorderBrush="{DynamicResource SukiControlBorderBrush}" BorderThickness="2"
                            Foreground="{DynamicResource SukiText}"
                            Command="{Binding ToggleConfigurationCommand}"
                            ToolTip.Tip="{Binding ConfigurationToggleText}">
                        <avalonia:MaterialIcon Kind="{Binding ConfigurationToggleIcon}" Width="20" Height="20" />
                    </Button>
                </Grid>
            </Border>

            <suki:GlassCard Grid.Row="2" Classes="EditorCard"
                            IsVisible="{Binding IsConfigurationExpanded}">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{x:Static lang:Resources.SourceLang}" FontSize="12" Opacity="0.7" />
                            <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedSourceLanguage}">
                            <ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="6">
                                <Panel Width="22" Height="16"><avalonia:MaterialIcon Kind="FlagOutline" Opacity="0.65" /><Image Width="22" Height="16" Source="{Binding Icon, Converter={x:Static converters:LanguageFlagConverters.ToIcon}}" /></Panel>
                                <TextBlock Text="{Binding Converter={x:Static converters:LanguageSettingsConverters.ToDisplayName}}" />
                            </StackPanel></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="{x:Static lang:Resources.UsingAiModel}" FontSize="12" Opacity="0.7" />
                            <ComboBox ItemsSource="{Binding AvailableAiModels}" SelectedItem="{Binding SelectedAiModel}">
                            <ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="6">
                                <Panel Width="18" Height="18"><avalonia:MaterialIcon Kind="Translate" Opacity="0.65" /><Image Width="18" Height="18" Source="{Binding ModelType, Converter={x:Static converters:AiModelTypeConverters.ToIcon}}" /></Panel>
                                <TextBlock Text="{Binding Name}" />
                            </StackPanel></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Text="{x:Static lang:Resources.Prompts}" FontSize="12" Opacity="0.7" />
                            <ComboBox ItemsSource="{Binding PromptEntries}" SelectedValue="{Binding SelectedPromptId}" SelectedValueBinding="{Binding Id}">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </suki:GlassCard>

            <Grid Grid.Row="3" Classes="EditorFooter" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                <Button Command="{Binding RunCommand}" Classes="Flat">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <avalonia:MaterialIcon Kind="Spellcheck" IsVisible="{Binding !IsBusy}" />
                        <suki:Loading Width="18" Height="18" IsVisible="{Binding IsBusy}" />
                        <TextBlock Text="{x:Static lang:Resources.TextAssistCorrect}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Command="{Binding CancelCommand}" Classes="Flat" IsVisible="{Binding IsBusy}">
                    <StackPanel Orientation="Horizontal" Spacing="6"><avalonia:MaterialIcon Kind="Stop" /><TextBlock Text="{x:Static lang:Resources.Cancel}" /></StackPanel>
                </Button>
                <TextBlock Grid.Column="2" Text="{Binding ErrorMessage}" Foreground="IndianRed" TextWrapping="Wrap" VerticalAlignment="Center" />
            </Grid>
    </Grid>
</UserControl>
