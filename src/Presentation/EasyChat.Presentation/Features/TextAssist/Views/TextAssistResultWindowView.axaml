<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EasyChat.Presentation.Features.TextAssist"
        xmlns:controls="using:EasyChat.Presentation.Features.TextAssist.Controls"
        xmlns:converters="clr-namespace:EasyChat.Presentation.Foundation.Formatting"
        xmlns:settings="clr-namespace:EasyChat.Contracts.Settings;assembly=EasyChat.Contracts"
        xmlns:sharedControls="clr-namespace:EasyChat.Presentation.Shared.Controls;assembly=EasyChat.Presentation.Shared"
        xmlns:lang="clr-namespace:EasyChat.Presentation.Lang"
        xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:md="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia"
        xmlns:suki="https://github.com/kikipoulet/SukiUI"
        x:Class="EasyChat.Presentation.Features.TextAssist.Views.TextAssistResultWindowView"
        x:DataType="vm:TextAssistResultWindowViewModel"
        Width="500" Height="420" MinWidth="380" MinHeight="180"
        WindowDecorations="None" TransparencyLevelHint="Transparent" Background="Transparent"
        TransparencyBackgroundFallback="Transparent" CornerRadius="8"
        Foreground="{DynamicResource SukiText}"
        Topmost="True" ShowInTaskbar="False" CanResize="True" Focusable="False" ShowActivated="False"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="TextAssistSurfaceBrush" Color="#FFFCFCFD" />
                    <SolidColorBrush x:Key="TextAssistRaisedSurfaceBrush" Color="#FFF1F4F6" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="TextAssistSurfaceBrush" Color="#FF202124" />
                    <SolidColorBrush x:Key="TextAssistRaisedSurfaceBrush" Color="#FF2A2D31" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Window.Styles>
        <Style Selector="Button.DangerClose">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="#D92D20" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.16" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="#F04438" />
                <Setter Property="RenderTransform" Value="scale(1.06)" />
            </Style>
            <Style Selector="^:pressed">
                <Setter Property="Background" Value="#B42318" />
                <Setter Property="RenderTransform" Value="scale(0.94)" />
            </Style>
        </Style>
    </Window.Styles>
    <Grid>
    <Border Padding="14" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource TextAssistSurfaceBrush}"
            BorderBrush="{DynamicResource SukiBorderBrush}" BorderThickness="1">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                <Border Grid.Column="0" Background="{DynamicResource TextAssistSurfaceBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <icons:MaterialIcon Kind="{Binding WindowIcon}" Width="19" Height="19"
                                            Foreground="{DynamicResource SukiPrimaryColor}" />
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <sharedControls:LanguageSelector Grid.Column="1" Width="160" Languages="{Binding Languages}" SelectedLanguage="{Binding SelectedSourceLanguage, Mode=TwoWay}"
                          IsVisible="{Binding ShowLanguageSelector}" />
                <Button Grid.Column="2" Classes="Basic" Command="{Binding RetryCommand}" ToolTip.Tip="{x:Static lang:Resources.Retry}">
                    <icons:MaterialIcon Kind="Refresh" />
                </Button>
                <Button Grid.Column="3" Classes="Basic" Click="OnCopyClick" ToolTip.Tip="{x:Static lang:Resources.Copy}">
                    <icons:MaterialIcon Kind="ContentCopy" />
                </Button>
                <Button Grid.Column="4" Classes="DangerClose" Click="OnCloseClick" ToolTip.Tip="{x:Static lang:Resources.Close}">
                    <icons:MaterialIcon Kind="Close" Foreground="White" />
                </Button>
            </Grid>
            <Grid Grid.Row="1" MinHeight="100">
                <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding !IsBusy}">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="12" IsVisible="{Binding ShowCorrectionResult}">
                            <Border Padding="12" CornerRadius="8" Background="{DynamicResource TextAssistRaisedSurfaceBrush}"
                                    BorderBrush="{DynamicResource SukiBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="7">
                                <TextBlock Text="{x:Static lang:Resources.TextAssistAnnotatedOriginal}" FontWeight="SemiBold" />
                                <Grid MinHeight="110">
                                    <Border Background="{DynamicResource TextAssistSurfaceBrush}"
                                            BorderBrush="{DynamicResource SukiBorderBrush}" BorderThickness="1" />
                                    <TextBlock x:Name="AnnotatedTextBlock" Text="{Binding SourceText}"
                                               TextWrapping="Wrap" Padding="10,8"
                                               FontFamily="{DynamicResource ContentControlThemeFontFamily}"
                                               FontSize="16" FontWeight="Normal" LineHeight="23" LetterSpacing="0"
                                               PointerMoved="OnOriginalPointerMoved" PointerExited="OnOriginalPointerExited" />
                                    <controls:CorrectionAnnotationLayer x:Name="AnnotationLayer" IsHitTestVisible="False"
                                             Text="{Binding SourceText}" Issues="{Binding Issues}"
                                             FontFamily="{DynamicResource ContentControlThemeFontFamily}"
                                             FontSize="16" FontWeight="Normal" LineHeight="23" Padding="10,8"
                                             HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                    <Border x:Name="CorrectionHint" IsVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"
                                            MaxWidth="390" Padding="9,6" Background="#293038" CornerRadius="6" IsHitTestVisible="False">
                                        <TextBlock x:Name="CorrectionHintText" Foreground="White" TextWrapping="Wrap" />
                                    </Border>
                                </Grid>
                            </StackPanel>
                            </Border>
                            <Border Padding="12" CornerRadius="8" Background="{DynamicResource TextAssistRaisedSurfaceBrush}"
                                    BorderBrush="{DynamicResource SukiBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="7">
                                <TextBlock Text="{x:Static lang:Resources.TextAssistCorrectedResult}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding CorrectedResult}" FontSize="17" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding CorrectionTranslation}" Opacity="0.6" TextWrapping="Wrap" />
                            </StackPanel>
                            </Border>
                            <StackPanel Spacing="8" IsVisible="{Binding HasCorrectionIssues}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <icons:MaterialIcon Kind="LightbulbOnOutline" Width="18" Height="18"
                                                        Foreground="{DynamicResource SukiPrimaryColor}" />
                                    <TextBlock Text="{x:Static lang:Resources.TextAssistIssues}" FontWeight="SemiBold" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Issues}">
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <Border Padding="11" Margin="0,0,0,6" CornerRadius="7"
                                                Background="{DynamicResource TextAssistRaisedSurfaceBrush}"
                                                BorderBrush="{DynamicResource SukiBorderBrush}" BorderThickness="1">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{Binding DisplayCategory}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SukiPrimaryColor}" />
                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Suggestion}" TextWrapping="Wrap" Opacity="0.72" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                        <Border Padding="18" CornerRadius="8" Background="{DynamicResource TextAssistRaisedSurfaceBrush}"
                                BorderBrush="SeaGreen" BorderThickness="1" IsVisible="{Binding IsCorrectionCorrect}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                <Border Width="44" Height="44" CornerRadius="22" Background="SeaGreen" VerticalAlignment="Center">
                                    <icons:MaterialIcon Kind="Check" Width="26" Height="26" Foreground="White"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CorrectionStatus}" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding CorrectionStatusDetail}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <StackPanel Spacing="12" IsVisible="{Binding IsPolish}">
                            <Border Padding="12" CornerRadius="8" Background="{DynamicResource TextAssistRaisedSurfaceBrush}"
                                    BorderBrush="{DynamicResource SukiBorderBrush}" BorderThickness="1">
                                <TextBlock Text="{Binding Result}" FontSize="17" TextWrapping="Wrap" />
                            </Border>
                            <StackPanel Spacing="8" IsVisible="{Binding HasPolishExplanations}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <icons:MaterialIcon Kind="BookOpenVariant" Width="18" Height="18"
                                                        Foreground="{DynamicResource SukiPrimaryColor}" />
                                    <TextBlock Text="{Binding PolishExplanationTitle}" FontWeight="SemiBold" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding PolishExplanations}">
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <Border Padding="11" Margin="0,0,0,6" CornerRadius="7"
                                                Background="{DynamicResource TextAssistRaisedSurfaceBrush}"
                                                BorderBrush="{DynamicResource SukiBorderBrush}" BorderThickness="1">
                                            <StackPanel Spacing="5">
                                                <TextBlock Text="{Binding Category}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SukiPrimaryColor}" />
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7" IsVisible="{Binding HasOriginal}">
                                                    <TextBlock Text="{Binding $parent[Window].((vm:TextAssistResultWindowViewModel)DataContext).PolishOriginalLabel}" Opacity="0.62" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Original}" TextWrapping="Wrap" />
                                                </Grid>
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7" IsVisible="{Binding HasRevised}">
                                                    <TextBlock Text="{Binding $parent[Window].((vm:TextAssistResultWindowViewModel)DataContext).PolishRevisedLabel}" Opacity="0.62" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Revised}" TextWrapping="Wrap" />
                                                </Grid>
                                                <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Opacity="0.76" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <Border Padding="14" CornerRadius="8" IsVisible="{Binding ShowPlainResult}"
                        Background="{DynamicResource TextAssistRaisedSurfaceBrush}"
                        BorderBrush="{DynamicResource SukiBorderBrush}" BorderThickness="1"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <Grid HorizontalAlignment="Stretch">
                            <md:MarkdownRenderer MarkdownBuilder="{Binding ResultMarkdown}"
                                                  HorizontalAlignment="Stretch" VerticalAlignment="Top" />
                        </Grid>
                    </ScrollViewer>
                </Border>
                <suki:Loading Width="24" Height="24" IsVisible="{Binding IsBusy}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Grid.Row="2" Text="{Binding ErrorMessage}" Foreground="IndianRed" TextWrapping="Wrap" />
        </Grid>
    </Border>
        <Border Width="5" HorizontalAlignment="Left" Background="Transparent"
                Cursor="LeftSide" Tag="West" PointerPressed="OnResizePointerPressed" />
        <Border Width="5" HorizontalAlignment="Right" Background="Transparent"
                Cursor="RightSide" Tag="East" PointerPressed="OnResizePointerPressed" />
        <Border Height="5" VerticalAlignment="Top" Background="Transparent"
                Cursor="TopSide" Tag="North" PointerPressed="OnResizePointerPressed" />
        <Border Height="5" VerticalAlignment="Bottom" Background="Transparent"
                Cursor="BottomSide" Tag="South" PointerPressed="OnResizePointerPressed" />

        <Border Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="Transparent" Cursor="TopLeftCorner" Tag="NorthWest"
                PointerPressed="OnResizePointerPressed" />
        <Border Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top"
                Background="Transparent" Cursor="TopRightCorner" Tag="NorthEast"
                PointerPressed="OnResizePointerPressed" />
        <Border Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Background="Transparent" Cursor="BottomLeftCorner" Tag="SouthWest"
                PointerPressed="OnResizePointerPressed" />
        <Border Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Background="Transparent" Cursor="BottomRightCorner" Tag="SouthEast"
                PointerPressed="OnResizePointerPressed">
            <icons:MaterialIcon Kind="ResizeBottomRight" Width="12" Height="12" Opacity="0.42"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2"
                                IsHitTestVisible="False" />
        </Border>
    </Grid>
</Window>
