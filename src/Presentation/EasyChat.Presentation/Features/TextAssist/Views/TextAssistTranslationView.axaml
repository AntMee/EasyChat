<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EasyChat.Presentation.Features.TextAssist"
             xmlns:textAssist="using:EasyChat.Presentation.Features.TextAssist"
             xmlns:lang="clr-namespace:EasyChat.Presentation.Lang"
             xmlns:dataConverters="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:converters="clr-namespace:EasyChat.Presentation.Foundation.Formatting"
             xmlns:sharedControls="clr-namespace:EasyChat.Presentation.Shared.Controls;assembly=EasyChat.Presentation.Shared"
             xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
             xmlns:md="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="EasyChat.Presentation.Features.TextAssist.Views.TextAssistTranslationView"
             x:Name="TranslationView"
             x:DataType="vm:TextAssistTranslationViewModel"
             ClipToBounds="True">
    <UserControl.Styles>
        <Style Selector="ComboBox /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
        </Style>
        <Style Selector="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
        </Style>
        <Style Selector="Border.LanguageSwapSurface">
            <Setter Property="Background" Value="{DynamicResource GhostColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor30}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.LanguageSwap:pointerover Border.LanguageSwapSurface">
            <Setter Property="Background" Value="{DynamicResource PrimaryColor10}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryColor}" />
        </Style>
        <Style Selector="Button.LanguageSwap:pressed Border.LanguageSwapSurface">
            <Setter Property="Background" Value="{DynamicResource BorderColor30}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryColor}" />
        </Style>
        <Style Selector="Grid.EditorContent">
            <Setter Property="RowSpacing" Value="5" />
        </Style>
        <Style Selector="UserControl.Compact Grid.EditorContent">
            <Setter Property="RowSpacing" Value="5" />
        </Style>
        <Style Selector="Grid.EditorPair">
            <Setter Property="MinHeight" Value="150" />
        </Style>
        <Style Selector="UserControl.Compact Grid.EditorPair">
            <Setter Property="MinHeight" Value="120" />
        </Style>
        <Style Selector="TextBox.EditorTextBox">
            <Setter Property="MinHeight" Value="100" />
        </Style>
        <Style Selector="UserControl.Compact TextBox.EditorTextBox">
            <Setter Property="MinHeight" Value="80" />
        </Style>
        <!-- Quick translation result keeps theme-aware text color and compact size. -->
        <Style Selector="md|MarkdownRenderer.TextAssistResultMarkdown">
            <Style Selector="^ md|MarkdownTextBlock">
                <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
                <Setter Property="FontSize" Value="18" />
            </Style>
        </Style>
        <Style Selector="Grid.EditorFooter">
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
        <Style Selector="UserControl.Compact Grid.EditorFooter">
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="*,Auto,Auto" RowSpacing="0" MinHeight="0">
        <Grid Grid.Row="0" RowSpacing="0" MinHeight="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="{Binding ShowAnnotations, Converter={x:Static converters:BoolToGridLengthConverter.Instance}, ConverterParameter=160}" />
            </Grid.RowDefinitions>
        <Grid Grid.Row="0" Classes="EditorPair" ColumnDefinitions="*,Auto,*" ColumnSpacing="4" VerticalAlignment="Stretch">
            <shad:Card Padding="4" HasShadow="True" ClipToBounds="True" VerticalAlignment="Stretch">
                <Grid Classes="EditorContent" RowDefinitions="Auto,32,4,*" RowSpacing="0" MinHeight="0" ClipToBounds="True">
                    <Grid Classes="LanguageHeader" ColumnDefinitions="*,Auto" ZIndex="100">
                        <TextBlock Classes="Muted" Text="{x:Static lang:Resources.SourceLang}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="Icon" Command="{Binding SpeakSourceCommand}"
                                ToolTip.Tip="{x:Static lang:Resources.ReadAloudMode_Source}">
                            <avalonia:MaterialIcon Kind="VolumeHigh" />
                        </Button>
                    </Grid>
                    <sharedControls:LanguageSelector Grid.Row="1" Height="32" MinHeight="0" ZIndex="100"
                                                     Languages="{Binding Languages}"
                                                     SelectedLanguage="{Binding SelectedSourceLanguage, Mode=TwoWay}" />
                    <Grid Grid.Row="3" Margin="0,0,4,0" MinHeight="0" ClipToBounds="True" VerticalAlignment="Stretch" ZIndex="0">
                        <TextBox x:Name="SourceTextBox" Classes="EditorTextBox" Text="{Binding InputText, Mode=TwoWay}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 PlaceholderText="{x:Static lang:Resources.TextAssistInputPlaceholderText}"
                                 VerticalAlignment="Stretch" VerticalContentAlignment="Top"
                                 BorderThickness="0" Background="Transparent" Padding="0" />
                    </Grid>
                </Grid>
            </shad:Card>

            <shad:Card Grid.Column="2" Padding="4" HasShadow="True" ClipToBounds="True" VerticalAlignment="Stretch">
                <Grid Classes="EditorContent" RowDefinitions="Auto,32,4,*" RowSpacing="0" MinHeight="0" ClipToBounds="True">
                    <Grid Classes="LanguageHeader" ColumnDefinitions="*,Auto,Auto" ZIndex="100">
                        <TextBlock Classes="Muted" Text="{x:Static lang:Resources.TargetLang}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="Icon" Click="OnCopyClick" ToolTip.Tip="{x:Static lang:Resources.Copy}">
                            <avalonia:MaterialIcon Kind="ContentCopy" />
                        </Button>
                        <Button Grid.Column="2" Classes="Icon" Command="{Binding SpeakResultCommand}"
                                ToolTip.Tip="{x:Static lang:Resources.ReadAloudMode_Target}">
                            <avalonia:MaterialIcon Kind="VolumeHigh" />
                        </Button>
                    </Grid>
                    <sharedControls:LanguageSelector Grid.Row="1" Height="32" MinHeight="0" ZIndex="100"
                                                     Languages="{Binding Languages}"
                                                     SelectedLanguage="{Binding SelectedTargetLanguage, Mode=TwoWay}" />
                    <Grid Grid.Row="3" Margin="0,0,4,0" MinHeight="0" ClipToBounds="True" VerticalAlignment="Stretch" ZIndex="0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <md:MarkdownRenderer x:Name="ResultMarkdownRenderer" Classes="TextAssistResultMarkdown"
                                                 MarkdownBuilder="{Binding ResultMarkdown}"
                                                 HorizontalAlignment="Stretch" VerticalAlignment="Top" />
                        </ScrollViewer>
                        <TextBox IsReadOnly="True" Text="{Binding TranslationResult}"
                                 PlaceholderText="{x:Static lang:Resources.TextAssistResultPlaceholder}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top" BorderThickness="0"
                                 Background="Transparent" Padding="0"
                                 IsVisible="{Binding TranslationResult, Converter={x:Static dataConverters:StringConverters.IsNullOrEmpty}}" />
                    </Grid>
                </Grid>
            </shad:Card>

            <Button Grid.Column="1" Classes="Icon LanguageSwap" VerticalAlignment="Top" Margin="0,42,0,0"
                    Command="{Binding SwapContentCommand}"
                    ToolTip.Tip="{x:Static lang:Resources.ReverseTranslateLanguageTip}">
                <Border Classes="LanguageSwapSurface" Width="28" Height="28" CornerRadius="999">
                    <avalonia:MaterialIcon Kind="SwapHorizontal" Width="16" Height="16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryColor}" />
                </Border>
            </Button>
        </Grid>

            <GridSplitter Grid.Row="1" Height="1" HorizontalAlignment="Stretch"
                          Margin="0,8,0,8"
                          Background="{DynamicResource BorderColor}"
                          Opacity="0.65" Cursor="SizeNorthSouth"
                          ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                          IsVisible="{Binding ShowAnnotations}" />

            <shad:Card Grid.Row="2" Padding="16" MinHeight="80" HasShadow="True" ClipToBounds="True"
                            IsVisible="{Binding ShowAnnotations}">
                <Grid RowDefinitions="Auto,*" RowSpacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <avalonia:MaterialIcon Kind="BookOpenVariant" Width="18" Height="18"
                                               Foreground="{DynamicResource PrimaryColor}" />
                        <TextBlock Text="{x:Static lang:Resources.TextAssistAnnotations}"
                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Annotations}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="textAssist:TextAssistAnnotationViewModel">
                                                <Border Margin="0,0,0,8" Padding="10" CornerRadius="6"
                                                        Background="{DynamicResource CardBackgroundColor}"
                                                        BorderBrush="{DynamicResource BorderColor}"
                                                        BorderThickness="1">
                                                    <StackPanel Spacing="5">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <Button Classes="Basic" Padding="0"
                                                                    Command="{Binding #TranslationView.((vm:TextAssistTranslationViewModel)DataContext).LookupAnnotationCommand}"
                                                                    CommandParameter="{Binding Term}"
                                                                    ToolTip.Tip="{x:Static lang:Resources.ResultWindowMode_Dictionary}">
                                                                <TextBlock Text="{Binding Term}" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource PrimaryColor}"
                                                                           TextDecorations="Underline" />
                                                            </Button>
                                                            <Border Padding="6,2" CornerRadius="4"
                                                                    Background="{DynamicResource BorderColor}">
                                                                <TextBlock Text="{Binding DisplayCategory}" FontSize="11" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Meaning}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Opacity="0.75"
                                                                   IsVisible="{Binding HasNote}" />
                                                        <StackPanel Orientation="Horizontal" Spacing="6"
                                                                    IsVisible="{Binding HasRelatedTerms}">
                                                            <TextBlock Text="{x:Static lang:Resources.TextAssistRelatedTerms}"
                                                                       FontSize="12" Opacity="0.65" VerticalAlignment="Center" />
                                                            <ItemsControl ItemsSource="{Binding RelatedTerms}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="x:String">
                                                                        <Button Classes="Basic" Padding="3,0"
                                                                                Command="{Binding #TranslationView.((vm:TextAssistTranslationViewModel)DataContext).LookupAnnotationCommand}"
                                                                                CommandParameter="{Binding}">
                                                                            <TextBlock Text="{Binding}"
                                                                                       Foreground="{DynamicResource PrimaryColor}"
                                                                                       TextDecorations="Underline" FontSize="12" />
                                                                        </Button>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </shad:Card>
        </Grid>

            <shad:Card Grid.Row="1" Padding="10" HasShadow="True" ClipToBounds="True"
                            IsVisible="{Binding IsConfigurationExpanded}">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{x:Static lang:Resources.TransEngine}" Classes="Muted" Opacity="0.7" />
                            <ComboBox ItemsSource="{Binding AvailableProviders}" SelectedItem="{Binding SelectedProvider}">
                            <ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="6">
                                <avalonia:MaterialIcon Kind="{Binding Converter={x:Static converters:TranslationEngineStringToIconKindConverter.Instance}}" Width="18" />
                                <TextBlock Text="{Binding}" />
                            </StackPanel></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4" IsVisible="{Binding IsAiProvider}">
                            <TextBlock Text="{x:Static lang:Resources.UsingAiModel}" Classes="Muted" Opacity="0.7" />
                            <ComboBox ItemsSource="{Binding AvailableAiModels}" SelectedItem="{Binding SelectedAiModel}">
                            <ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="6">
                                <Panel Width="18" Height="18"><avalonia:MaterialIcon Kind="Translate" Opacity="0.65" /><Image Width="18" Height="18" Source="{Binding ModelType, Converter={x:Static converters:AiModelTypeConverters.ToIcon}}" /></Panel>
                                <TextBlock Text="{Binding Name}" />
                            </StackPanel></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Text="{x:Static lang:Resources.Prompts}" Classes="Muted" Opacity="0.7" />
                            <ComboBox ItemsSource="{Binding PromptEntries}" SelectedValue="{Binding SelectedPromptId}" SelectedValueBinding="{Binding Id}">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" IsVisible="{Binding IsMachineProvider}">
                        <TextBlock Text="{x:Static lang:Resources.MachineTranslation}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding MachineProviders}" SelectedItem="{Binding SelectedMachineProvider}">
                            <ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="6">
                                <Panel Width="18" Height="18"><avalonia:MaterialIcon Kind="Translate" Opacity="0.65" /><Image Width="18" Height="18" Source="{Binding Converter={x:Static converters:EngineConverters.ToIcon}}" /></Panel>
                                <TextBlock Text="{Binding}" />
                            </StackPanel></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"
                          ToolTip.Tip="{x:Static lang:Resources.TextAssistDetailedExplanationTip}">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <avalonia:MaterialIcon Kind="BookEducationOutline" Width="18" Height="18" />
                            <TextBlock Text="{x:Static lang:Resources.TextAssistDetailedExplanation}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding DetailedExplanation}"
                                      IsEnabled="{Binding IsAiProvider}" OnContent="" OffContent="" />
                    </Grid>
                </StackPanel>
            </shad:Card>

            <Grid Grid.Row="2" Classes="EditorFooter" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Text="{Binding ErrorMessage}" Foreground="{DynamicResource DestructiveColor}"
                           TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="1" Command="{Binding RunCommand}" Classes="Primary EditorInlineRun"
                        HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <avalonia:MaterialIcon Kind="Translate" IsVisible="{Binding !IsBusy}" />
                        <shad:Loading Width="18" Height="18" IsVisible="{Binding IsBusy}" />
                        <TextBlock Text="{x:Static lang:Resources.TextAssistTranslate}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Command="{Binding CancelCommand}" Classes="Ghost" IsVisible="{Binding IsBusy}">
                    <StackPanel Orientation="Horizontal" Spacing="6"><avalonia:MaterialIcon Kind="Stop" /><TextBlock Text="{x:Static lang:Resources.Cancel}" /></StackPanel>
                </Button>
                <Button Grid.Column="3" Classes="Ghost" Command="{Binding ToggleConfigurationCommand}"
                        ToolTip.Tip="{Binding ConfigurationToggleText}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <avalonia:MaterialIcon Kind="{Binding ConfigurationToggleIcon}" Width="16" Height="16" />
                        <TextBlock Text="{Binding ConfigurationToggleText}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
    </Grid>
</UserControl>
