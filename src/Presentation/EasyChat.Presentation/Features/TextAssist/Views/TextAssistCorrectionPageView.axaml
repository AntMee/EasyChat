<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EasyChat.Presentation.Features.TextAssist"
             xmlns:views="using:EasyChat.Presentation.Features.TextAssist.Views"
             x:Class="EasyChat.Presentation.Features.TextAssist.Views.TextAssistCorrectionPageView"
             x:DataType="vm:TextAssistCorrectionPageViewModel"
             Background="{DynamicResource GhostColor}">
    <Grid Margin="25">
        <views:TextAssistCorrectionView DataContext="{Binding Correction}" />
    </Grid>
</UserControl>
