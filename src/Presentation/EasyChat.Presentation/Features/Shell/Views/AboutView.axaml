<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:EasyChat.Presentation.Features.Shell"
             xmlns:lang="clr-namespace:EasyChat.Presentation.Lang"
             xmlns:ec="clr-namespace:EasyChat.Presentation.Shared.Controls;assembly=EasyChat.Presentation.Shared"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
             x:DataType="viewModels:AboutViewModel"
             x:Class="EasyChat.Presentation.Features.Shell.Views.AboutView"
             mc:Ignorable="d"
             d:DesignWidth="1100"
             d:DesignHeight="740"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Background="{DynamicResource GhostColor}">
    <UserControl.Styles>
        <Style Selector="Button.AboutUpdateBadge">
            <Setter Property="Background" Value="{DynamicResource PrimaryColor10}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource FullCornerRadius}" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="Button.AboutUpdateBadge:pointerover">
            <Setter Property="Opacity" Value="0.92" />
        </Style>
        <Style Selector="Button.AboutUpdateBadge:pressed">
            <Setter Property="Opacity" Value="0.84" />
        </Style>
    </UserControl.Styles>
    <Grid
          RowDefinitions="*,Auto"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch" Margin="32,28,32,28" MaxWidth="1120">

        <ScrollViewer Grid.Row="0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="18" HorizontalAlignment="Stretch">

                <Grid RowDefinitions="Auto,Auto,Auto"
                      ColumnDefinitions="*,Auto"
                      Margin="0,0,0,8"
                      ColumnSpacing="16">
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="{x:Static lang:Resources.About}"
                               Classes="h2"
                               VerticalAlignment="Center"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               AutomationProperties.Name="{x:Static lang:Resources.About}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                               Text="{x:Static lang:Resources.AboutLine1}"
                               Classes="p"
                               Foreground="{DynamicResource MutedColor}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0"
                               MaxWidth="720"
                               HorizontalAlignment="Left" />
                </Grid>

                <!-- Identity -->
                <shad:Card HasShadow="True">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18">
                        <Border Width="56" Height="56"
                                CornerRadius="14"
                                Background="{DynamicResource PrimaryColor10}"
                                VerticalAlignment="Center">
                            <Image Source="avares://EasyChat.Desktop/Assets/easychat-logo.png"
                                   MaxWidth="36" MaxHeight="36"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="{x:Static lang:Resources.AppName}"
                                           Classes="Large"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource ForegroundColor}" />
                                <shad:Badge
                                        Background="{DynamicResource PrimaryColor10}"
                                        Padding="12,5"
                                        VerticalAlignment="Center" CornerRadius="{DynamicResource FullCornerRadius}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{x:Static lang:Resources.CurrentVersion}"
                                                   Classes="Muted"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Version}"
                                                   Classes="Caption"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource PrimaryColor}" />
                                    </StackPanel>
                                </shad:Badge>
                                <Button Classes="AboutUpdateBadge"
                                        IsVisible="{Binding IsUpdateAvailable}"
                                        Command="{Binding ShowUpdateToastCommand}"
                                        VerticalAlignment="Center"
                                        ToolTip.Tip="{x:Static lang:Resources.NewVersionAvailable}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <avalonia:MaterialIcon Kind="Download"
                                                               Width="14"
                                                               Height="14"
                                                               Foreground="{DynamicResource PrimaryColor}"
                                                               VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding LatestVersion}"
                                                   Classes="Caption"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource PrimaryColor}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="{x:Static lang:Resources.AboutLine2}"
                                       Classes="p"
                                       TextWrapping="Wrap"
                                       MaxWidth="640"
                                       Foreground="{DynamicResource MutedColor}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="10"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right">
                            <Button Classes="Primary"
                                    Command="{Binding OpenUrlCommand}"
                                    CommandParameter="https://github.com/SwaggyMacro/EasyChat">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <avalonia:MaterialIcon Kind="Github" Width="16" Height="16" />
                                    <TextBlock Text="{x:Static lang:Resources.OpenOnGithub}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Classes="Ghost"
                                    Command="{Binding OpenUrlCommand}"
                                    CommandParameter="https://github.com/SwaggyMacro/EasyChat/releases">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <avalonia:MaterialIcon Kind="Download" Width="16" Height="16" />
                                    <TextBlock Text="{x:Static lang:Resources.OpenReleases}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </shad:Card>

                <!-- Third-party: fixed content height, not stretched -->
                <shad:Card HasShadow="True" VerticalAlignment="Top">
                    <shad:Card.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <avalonia:MaterialIcon Kind="PackageVariant"
                                                   Width="16" Height="16"
                                                   Foreground="{DynamicResource MutedColor}"
                                                   VerticalAlignment="Center" />
                            <TextBlock Text="{x:Static lang:Resources.ThirdPartyLibraries}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedColor}" />
                        </StackPanel>
                    </shad:Card.Header>

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                        <shad:Card HasShadow="False">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Border Width="36" Height="36"
                                            CornerRadius="10"
                                            Background="{DynamicResource CardBackgroundColor}"
                                            BorderBrush="{DynamicResource BorderColor}"
                                            BorderThickness="1"
                                            VerticalAlignment="Center">
                                        <avalonia:MaterialIcon Kind="Application"
                                                               Width="16" Height="16"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource PrimaryColor}" />
                                    </Border>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="AvaloniaUI"
                                                   Classes="Small" />
                                        <TextBlock Text="Avalonia"
                                                   Classes="Muted" />
                                    </StackPanel>
                                </StackPanel>
                            </shad:Card>

                            <shad:Card Grid.Column="1" HasShadow="False">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Border Width="36" Height="36"
                                            CornerRadius="10"
                                            Background="{DynamicResource CardBackgroundColor}"
                                            BorderBrush="{DynamicResource BorderColor}"
                                            BorderThickness="1"
                                            VerticalAlignment="Center">
                                        <avalonia:MaterialIcon Kind="Palette"
                                                               Width="16" Height="16"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource PrimaryColor}" />
                                    </Border>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="ShadUI"
                                                   Classes="Small" />
                                        <TextBlock Text="accntech"
                                                   Classes="Muted" />
                                    </StackPanel>
                                </StackPanel>
                            </shad:Card>

                            <shad:Card Grid.Column="2" HasShadow="False">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Border Width="36" Height="36"
                                            CornerRadius="10"
                                            Background="{DynamicResource CardBackgroundColor}"
                                            BorderBrush="{DynamicResource BorderColor}"
                                            BorderThickness="1"
                                            VerticalAlignment="Center">
                                        <avalonia:MaterialIcon Kind="TextRecognition"
                                                               Width="16" Height="16"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource PrimaryColor}" />
                                    </Border>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="OpenVINO.NET"
                                                   Classes="Small" />
                                        <TextBlock Text="sdcb"
                                                   Classes="Muted" />
                                    </StackPanel>
                                </StackPanel>
                            </shad:Card>
                        </Grid>
                </shad:Card>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="1"
                   Text="{x:Static lang:Resources.Copyright}"
                   Classes="Muted"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Bottom"
                   Margin="2,16,0,0" />
    </Grid>
</UserControl>
