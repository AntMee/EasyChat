<UserControl x:Class="EasyChat.Presentation.Features.Shell.Views.HomeView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:EasyChat.Presentation.Features.Shell"
             xmlns:lang="clr-namespace:EasyChat.Presentation.Lang"
             xmlns:converters="clr-namespace:EasyChat.Presentation.Foundation.Formatting"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:ec="clr-namespace:EasyChat.Presentation.Shared.Controls;assembly=EasyChat.Presentation.Shared"
             xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
             d:DesignWidth="1100"
             d:DesignHeight="740"
             x:DataType="viewModels:HomeViewModel"
             mc:Ignorable="d"
             Background="{DynamicResource GhostColor}">
    <Grid Margin="28,22,28,24"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          RowDefinitions="Auto,Auto,Auto,Auto,Auto"
          RowSpacing="14">

        <!-- Hero: engine + 3 metric chips -->
        <shad:Card Grid.Row="0" HasShadow="True" Padding="18,16">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border Width="44" Height="44"
                            CornerRadius="12"
                            Background="{DynamicResource PrimaryColor10}"
                            VerticalAlignment="Center">
                        <avalonia:MaterialIcon Kind="RocketLaunch"
                                               Width="20" Height="20"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource PrimaryColor}" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding EngineSummaryText}"
                                       Classes="Large"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource ForegroundColor}"
                                       VerticalAlignment="Center" />
                        <shad:Badge CornerRadius="999"
                                    Padding="9,4"
                                    BorderThickness="1"
                                    VerticalAlignment="Center"
                                    Background="{Binding EngineStatusKind, Converter={x:Static converters:HomeStatusKindToBrushConverter.Background}}"
                                    BorderBrush="{Binding EngineStatusKind, Converter={x:Static converters:HomeStatusKindToBrushConverter.Border}}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="6" Height="6"
                                         VerticalAlignment="Center"
                                         Fill="{Binding EngineStatusKind, Converter={x:Static converters:HomeStatusKindToBrushConverter.Dot}}" />
                                <TextBlock Text="{Binding EngineStatusText}"
                                           Classes="Caption"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding EngineStatusKind, Converter={x:Static converters:HomeStatusKindToBrushConverter.Foreground}}" />
                            </StackPanel>
                        </shad:Badge>
                        </StackPanel>
                        <TextBlock Text="{Binding EngineKindText}"
                                   Classes="Small"
                                   Foreground="{DynamicResource MutedColor}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <Button Classes="Primary"
                                Command="{Binding NavigateToSettingsCommand}"
                                IsVisible="{Binding NeedsConfiguration}"
                                Content="{x:Static lang:Resources.HomeConfigureCta}" />
                        <Button Classes="Ghost"
                                Command="{Binding OpenEngineSettingsCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{x:Static lang:Resources.TransEngine}"
                                           VerticalAlignment="Center" />
                                <avalonia:MaterialIcon Kind="ChevronRight" Width="14" Height="14" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Real snapshot chips (not decorative filler) -->
                <UniformGrid Grid.Row="1" Columns="3">
                    <shad:Card Margin="0,0,8,0" HasShadow="False" Padding="12,10">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Static lang:Resources.HomeLanguagePair}"
                                       Classes="Caption"
                                       Foreground="{DynamicResource MutedColor}" />
                            <TextBlock Text="{Binding LanguagePairDisplay}"
                                       Classes="Small"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </shad:Card>
                    <shad:Card Margin="4,0" HasShadow="False" Padding="12,10">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Static lang:Resources.AIEngine}"
                                       Classes="Caption"
                                       Foreground="{DynamicResource MutedColor}" />
                            <TextBlock Text="{Binding ConfiguredModelCount, StringFormat={}{0}}"
                                       Classes="h4" />
                            <TextBlock Text="{Binding EngineKindText}"
                                       Classes="Caption"
                                       Foreground="{DynamicResource MutedColor}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </shad:Card>
                    <Button Margin="8,0,0,0"
                            Background="{DynamicResource GhostColor}"
                            BorderThickness="0"
                            Padding="12,10"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            VerticalContentAlignment="Top"
                            Command="{Binding NavigateToShortcutsCommand}"
                            Cursor="Hand">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Static lang:Resources.Shortcut}"
                                       Classes="Caption"
                                       Foreground="{DynamicResource MutedColor}" />
                            <TextBlock Text="{Binding ShortcutCount, StringFormat={}{0}}"
                                       Classes="h4" />
                            <TextBlock Text="{x:Static lang:Resources.HomeHealthActionOpenShortcuts}"
                                       Classes="Caption"
                                       Foreground="{DynamicResource PrimaryColor}" />
                        </StackPanel>
                    </Button>
                </UniformGrid>
            </Grid>
        </shad:Card>

        <!-- Onboarding -->
        <shad:Card Grid.Row="1"
                   IsVisible="{Binding ShowOnboarding}"
                   HasShadow="False"
                   Padding="16,12"
                   Background="{DynamicResource PrimaryColor10}"
                   BorderBrush="{DynamicResource PrimaryColor10}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Static lang:Resources.HomeOnboardingTitle}"
                               Classes="Small" />
                    <TextBlock Text="{x:Static lang:Resources.HomeOnboardingStep1}"
                               Classes="Caption"
                               Foreground="{DynamicResource MutedColor}" />
                    <TextBlock Text="{x:Static lang:Resources.HomeOnboardingStep2}"
                               Classes="Caption"
                               Foreground="{DynamicResource MutedColor}" />
                    <TextBlock Text="{x:Static lang:Resources.HomeOnboardingStep3}"
                               Classes="Caption"
                               Foreground="{DynamicResource MutedColor}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                        <Button Classes="Primary"
                                Command="{Binding NavigateToSettingsCommand}"
                                Content="{x:Static lang:Resources.HomeHealthActionOpenSettings}" />
                        <Button Classes="Ghost"
                                Command="{Binding NavigateToShortcutsCommand}"
                                Content="{x:Static lang:Resources.HomeHealthActionOpenShortcuts}" />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1"
                        Classes="Icon"
                        VerticalAlignment="Top"
                        Command="{Binding DismissOnboardingCommand}"
                        ToolTip.Tip="{x:Static lang:Resources.HomeOnboardingDismiss}">
                    <avalonia:MaterialIcon Kind="Close" Width="16" Height="16" />
                </Button>
            </Grid>
        </shad:Card>

        <shad:Card Grid.Row="2" HasShadow="True" Padding="18,16">
            <Grid ColumnDefinitions="*,20,*"
                  RowDefinitions="Auto,Auto"
                  RowSpacing="8">
                <TextBlock Text="{x:Static lang:Resources.TransEngine}"
                           Classes="Muted"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="2"
                           Text="{x:Static lang:Resources.HomeLanguagePair}"
                           Classes="Muted"
                           VerticalAlignment="Center" />

                <TabControl Grid.Row="1"
                            SelectedIndex="{Binding EngineTabIndex}"
                            HorizontalAlignment="Stretch">
                    <TabItem Header="{x:Static lang:Resources.AIEngine}">
                        <ComboBox HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding ConfiguredModels}"
                                  SelectedValue="{Binding GeneralConfig.UsingAiModelId}"
                                  SelectedValueBinding="{Binding Id}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Width="18" Height="18" CornerRadius="4" ClipToBounds="True">
                                            <Image Source="{Binding ModelType, Converter={x:Static converters:AiModelTypeConverters.ToIcon}}"
                                                   Stretch="UniformToFill" />
                                        </Border>
                                        <TextBlock Text="{Binding Name}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource ForegroundColor}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </TabItem>
                    <TabItem Header="{x:Static lang:Resources.MachineTranslation}">
                        <ComboBox HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding MachineTransProviders}"
                                  SelectedItem="{Binding GeneralConfig.UsingMachineTrans}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Panel Width="18" Height="18">
                                            <Border ClipToBounds="True" CornerRadius="4"
                                                    IsVisible="{Binding Converter={x:Static converters:EngineConverters.HasIcon}}">
                                                <Image Source="{Binding Converter={x:Static converters:EngineConverters.ToIcon}}"
                                                       Stretch="UniformToFill" />
                                            </Border>
                                            <avalonia:MaterialIcon Kind="Translate" Width="16" Height="16"
                                                                   IsVisible="{Binding Converter={x:Static converters:EngineConverters.HasNoIcon}}" />
                                        </Panel>
                                        <TextBlock Text="{Binding}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource ForegroundColor}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </TabItem>
                </TabControl>

                <StackPanel Grid.Row="1"
                            Grid.Column="2"
                            Spacing="8"
                            VerticalAlignment="Bottom">
                    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="8">
                        <StackPanel Spacing="5">
                            <TextBlock Text="{x:Static lang:Resources.SourceLang}"
                                       Classes="Caption"
                                       Foreground="{DynamicResource MutedColor}" />
                            <ec:LanguageSelector Languages="{Binding AvailableLanguages}"
                                                 SelectedLanguage="{Binding SelectedSourceLanguage, Mode=TwoWay}"
                                                 HorizontalAlignment="Stretch"
                                                 MinHeight="38" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Classes="Icon"
                                Command="{Binding SwapLanguagesCommand}"
                                ToolTip.Tip="{x:Static lang:Resources.HomeSwapLanguages}"
                                VerticalAlignment="Bottom">
                            <avalonia:MaterialIcon Kind="SwapHorizontal" Width="16" Height="16" />
                        </Button>
                        <StackPanel Grid.Column="2" Spacing="5">
                            <TextBlock Text="{x:Static lang:Resources.TargetLang}"
                                       Classes="Caption"
                                       Foreground="{DynamicResource MutedColor}" />
                            <ec:LanguageSelector Languages="{Binding AvailableLanguages}"
                                                 SelectedLanguage="{Binding SelectedTargetLanguage, Mode=TwoWay}"
                                                 HorizontalAlignment="Stretch"
                                                 MinHeight="38" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </shad:Card>

        <!-- Quick actions: compact fixed height (no * stretch, no oversized MinHeight) -->
        <shad:Card Grid.Row="3" HasShadow="True" Padding="14,12" VerticalAlignment="Top">
            <DockPanel>
                <TextBlock Text="{x:Static lang:Resources.HomeQuickActions}"
                           Classes="Muted"
                           DockPanel.Dock="Top"
                           Margin="2,0,0,10" />
                <ItemsControl ItemsSource="{Binding QuickActions}"
                              HorizontalAlignment="Stretch">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" Rows="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:HomeQuickAction">
                            <Button Margin="4"
                                    Height="64"
                                    Padding="12,10"
                                    Command="{Binding Command}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    VerticalContentAlignment="Center"
                                    Cursor="Hand">
                                <Button.Styles>
                                    <Style Selector="Button:pointerover /template/ Border#HoverBackground">
                                        <Setter Property="Background" Value="{DynamicResource PrimaryColor10}" />
                                    </Style>
                                </Button.Styles>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Width="32" Height="32"
                                            CornerRadius="9"
                                            Background="{DynamicResource CardBackgroundColor}"
                                            BorderBrush="{DynamicResource BorderColor}"
                                            BorderThickness="1"
                                            VerticalAlignment="Center">
                                        <avalonia:MaterialIcon Kind="{Binding Icon}"
                                                               Width="16" Height="16"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource PrimaryColor}" />
                                    </Border>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource ForegroundColor}" />
                                        <TextBlock Text="{Binding Description}"
                                                   Classes="Caption"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource MutedColor}" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </shad:Card>

        <!-- Footer: plain meta line with breathing room above -->
        <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="2,4,2,0">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="{x:Static lang:Resources.CurrentVersion}"
                           Classes="Small"
                           Foreground="{DynamicResource MutedColor}"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding CurrentVersion}"
                           Classes="Small"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedColor}"
                           VerticalAlignment="Center" />
                <TextBlock Text="·"
                           Classes="Small"
                           Foreground="{DynamicResource MutedColor}"
                           Margin="2,0"
                           VerticalAlignment="Center" />
                <TextBlock Text="{x:Static lang:Resources.LatestVersion}"
                           Classes="Small"
                           Foreground="{DynamicResource MutedColor}"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding LatestVersion}"
                           Classes="Small"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedColor}"
                           VerticalAlignment="Center" />
            </StackPanel>
            <Button Grid.Column="1"
                    Classes="Ghost"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Command="{Binding NavigateToAboutCommand}"
                    HorizontalContentAlignment="Right">
                <Button.Template>
                    <ControlTemplate>
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <TextBlock Text="{x:Static lang:Resources.About}"
                               Classes="Small"
                               Foreground="{DynamicResource MutedColor}"
                               VerticalAlignment="Center" />
                    <avalonia:MaterialIcon Kind="ChevronRight"
                                           Width="14" Height="14"
                                           Foreground="{DynamicResource MutedColor}" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
