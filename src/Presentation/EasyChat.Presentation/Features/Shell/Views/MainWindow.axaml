<shad:Window xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:vm="using:EasyChat.Presentation.Features.Shell"
                 xmlns:theme="using:EasyChat.Presentation.Features.Settings.Theme"
                 xmlns:navigation="using:EasyChat.Presentation.Foundation.Navigation"
                 xmlns:lang="clr-namespace:EasyChat.Presentation.Lang"
                 xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
                 xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
                 IsTitleBarVisible="{Binding TitleBarVisible, Mode=TwoWay}"
                 TransparencyLevelHint="None"
                 Width="1180"
                 Height="740"
                 MinWidth="960"
                 MinHeight="620"
                 x:Class="EasyChat.Presentation.Features.Shell.Views.MainWindow"
                 x:DataType="vm:MainWindowViewModel"
                 Icon="avares://EasyChat.Desktop/Assets/easychat-logo.ico"
                 WindowStartupLocation="CenterScreen"
                 Title="EasyChat">

    <Design.DataContext>
        <!-- ReSharper disable once Xaml.ConstructorWarning -->
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <shad:Window.LogoContent>
        <Border Width="28" Height="28"
                CornerRadius="8"
                Background="{DynamicResource PrimaryColor10}"
                VerticalAlignment="Center">
            <avalonia:MaterialIcon Width="16"
                                   Height="16"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryColor}"
                                   Kind="Translate" />
        </Border>
    </shad:Window.LogoContent>

    <shad:Window.RightWindowTitleBarContent>
        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,4,0">
            <Button Classes="Icon"
                    Command="{Binding CycleBaseThemeCommand}"
                    ToolTip.Tip="{Binding CurrentThemeModeName}"
                    AutomationProperties.Name="{Binding CurrentThemeModeName}"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
                <avalonia:MaterialIcon Kind="{Binding ThemeToggleIcon}"
                                       Width="18"
                                       Height="18" />
            </Button>
            <Button Classes="Icon"
                    ToolTip.Tip="{x:Static lang:Resources.Settings}"
                    AutomationProperties.Name="{x:Static lang:Resources.Settings}"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
                <avalonia:MaterialIcon Kind="DotsVertical"
                                       Width="18"
                                       Height="18" />
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedRight" ShowMode="Standard">
                        <shad:Card Width="268"
                                   Padding="16"
                                   HasShadow="False"
                                   Background="{DynamicResource DialogBackgroundColor}"
                                   BorderBrush="{DynamicResource BorderColor}"
                                   BorderThickness="1">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="Caption" FontWeight="Bold"
                                           Text="{x:Static lang:Resources.Settings}"
                                           Margin="8,2,8,6" />

                                <Button
                                        Command="{Binding ToggleFullScreenCommand}" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <avalonia:MaterialIcon Kind="Fullscreen" Width="18" Height="18" />
                                        <TextBlock VerticalAlignment="Center"
                                                   Text="{x:Static lang:Resources.FullScreen}" />
                                    </StackPanel>
                                </Button>

                                <Separator Margin="4,8" />
                                <TextBlock Classes="Caption" FontWeight="Bold"
                                           Text="{x:Static lang:Resources.Theme}"
                                           Margin="8,2,8,4" />
                                <ItemsControl ItemsSource="{Binding Themes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type theme:ColorThemeOption}">
                                            <Button
                                                    Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).ChangeThemeCommand}"
                                                    CommandParameter="{Binding}" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <Ellipse Width="12" Height="12"
                                                             Fill="{Binding PrimaryBrush}"
                                                             Stroke="{DynamicResource BorderColor60}"
                                                             StrokeThickness="1" />
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource ForegroundColor}" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button
                                        Command="{Binding CreateCustomThemeCommand}" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <avalonia:MaterialIcon Kind="Colorize" Width="18" Height="18" />
                                        <TextBlock VerticalAlignment="Center"
                                                   Text="{x:Static lang:Resources.CreateCustom}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </shad:Card>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </StackPanel>
    </shad:Window.RightWindowTitleBarContent>

    <shad:Window.Hosts>
        <shad:ToastHost Manager="{Binding ShadToastManager}" />
        <shad:ToastHost Manager="{Binding UpdateToastManager}" />
        <shad:DialogHost Manager="{Binding ShadDialogManager}" />
    </shad:Window.Hosts>

    <Grid ColumnDefinitions="Auto,*">
        <shad:Sidebar x:Name="NavigationSidebar"
                      Grid.Column="0"
                      Width="232"
                      MinWidth="56"
                      Padding="8"
                      Background="{DynamicResource SidebarBackgroundColor}"
                      BorderThickness="0,0,1,0"
                      ItemIconContentSpacing="12"
                      CurrentRoute="{Binding ActivePage.Route}">
            <shad:Sidebar.Footer>
                <ToggleButton Classes="Icon"
                              HorizontalAlignment="Center"
                              IsChecked="{Binding #NavigationSidebar.Expanded, Mode=TwoWay}"
                              AutomationProperties.Name="Toggle navigation sidebar">
                    <Panel Width="18" Height="18">
                        <avalonia:MaterialIcon Kind="ChevronLeft"
                                               Width="18" Height="18"
                                               IsVisible="{Binding #NavigationSidebar.Expanded}" />
                        <avalonia:MaterialIcon Kind="ChevronRight"
                                               Width="18" Height="18"
                                               IsVisible="{Binding !#NavigationSidebar.Expanded}" />
                    </Panel>
                </ToggleButton>
            </shad:Sidebar.Footer>

            <ItemsControl ItemsSource="{Binding Pages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type navigation:NavigationPageViewModel}">
                        <shad:SidebarItem Route="{Binding Route}"
                                          Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).SelectPageCommand}"
                                          CommandParameter="{Binding}"
                                          Foreground="{DynamicResource ForegroundColor}"
                                          AutomationProperties.Name="{Binding DisplayName}">
                            <shad:SidebarItem.Icon>
                                <Panel Width="22" Height="22">
                                    <Border Width="22" Height="22"
                                            CornerRadius="6"
                                            Background="{DynamicResource PrimaryColor10}" />
                                    <avalonia:MaterialIcon Kind="{Binding Icon}"
                                                           Width="15" Height="15"
                                                           Foreground="{DynamicResource ForegroundColor}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                    <Border Width="7" Height="7"
                                            CornerRadius="4"
                                            Background="{DynamicResource WarningColor}"
                                            BorderBrush="{DynamicResource SidebarBackgroundColor}"
                                            BorderThickness="1"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            IsVisible="{Binding ShowAttentionBadge}" />
                                </Panel>
                            </shad:SidebarItem.Icon>
                            <TextBlock Text="{Binding DisplayName}"
                                       Foreground="{DynamicResource ForegroundColor}"
                                       TextTrimming="CharacterEllipsis" />
                        </shad:SidebarItem>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </shad:Sidebar>

        <ContentControl Grid.Column="1" Content="{Binding ActivePage}" />
    </Grid>
</shad:Window>
