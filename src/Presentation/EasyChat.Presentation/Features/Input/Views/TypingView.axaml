<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lang="clr-namespace:EasyChat.Presentation.Lang"
        xmlns:vm="clr-namespace:EasyChat.Presentation.Features.Input"
        xmlns:converters="clr-namespace:EasyChat.Presentation.Foundation.Formatting"
        xmlns:controls="clr-namespace:EasyChat.Presentation.Shared.Controls;assembly=EasyChat.Presentation.Shared"
        xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="148"
        Height="148" MinWidth="560" SizeToContent="Width"
        x:Class="EasyChat.Presentation.Features.Input.Views.TypingView"
        x:DataType="vm:TypingViewModel"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        CornerRadius="16"
        TransparencyLevelHint="Blur"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Title="{x:Static lang:Resources.TranslateToWindow}">

    <Panel>
        <Border x:Name="MainCard"
                Classes="EcFloatShell"
                Padding="0">
            <Border Classes="EcFloatClip">
            <Grid RowDefinitions="*,Auto">
                <TextBox Name="InputBox"
                         Grid.Row="0"
                         Margin="14,12,14,8"
                         PlaceholderText="{x:Static lang:Resources.InputToTranslate}"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Stretch"
                         BorderThickness="0"
                         Background="Transparent"
                         FontSize="15"
                         MinHeight="40"
                         KeyDown="InputBox_OnKeyDown" />

                <!-- Action bar: language controls left, Submit primary + Close right -->
                <Border Grid.Row="1"
                        Background="{DynamicResource EcBgElevated}"
                        BorderBrush="{DynamicResource EcBorder}"
                        BorderThickness="0,1,0,0"
                        Padding="12,8">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <CheckBox Content="{x:Static lang:Resources.FollowConfig}"
                                      IsChecked="{Binding FollowGlobalLanguage}"
                                      VerticalAlignment="Center" />
                            <Border Background="Transparent"
                                    ToolTip.Tip="{x:Static lang:Resources.TypingFollowConfigTooltip}"
                                    VerticalAlignment="Center">
                                <avalonia:MaterialIcon Kind="InformationOutline" Width="15" Height="15" Opacity="0.55"
                                                       Foreground="{DynamicResource EcTextSecondary}" />
                            </Border>

                            <controls:LanguageSelector IsEnabled="{Binding !FollowGlobalLanguage}"
                                                       Languages="{Binding SourceLanguages}"
                                                       SelectedLanguage="{Binding SelectedSourceLanguage, Mode=TwoWay}"
                                                       MinWidth="110"
                                                       VerticalAlignment="Center" />

                            <Button Classes="EcIconRound"
                                    Width="34" Height="34"
                                    IsEnabled="{Binding !FollowGlobalLanguage}"
                                    Command="{Binding SwapLanguagesCommand}"
                                    ToolTip.Tip="{x:Static lang:Resources.HomeSwapLanguages}"
                                    VerticalAlignment="Center">
                                <avalonia:MaterialIcon Kind="SwapHorizontal" Width="14" Height="14" />
                            </Button>

                            <controls:LanguageSelector IsEnabled="{Binding !FollowGlobalLanguage}"
                                                       Languages="{Binding TargetLanguages}"
                                                       SelectedLanguage="{Binding SelectedTargetLanguage, Mode=TwoWay}"
                                                       MinWidth="110"
                                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <TextBlock Classes="EcMuted"
                                       Text="{x:Static lang:Resources.TypingEnterHint}"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Margin="0,0,4,0" />
                            <Button Classes="EcGhost" 
                                    Padding="10,6"
                                    Click="OnCloseClick"
                                    ToolTip.Tip="{x:Static lang:Resources.Close}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <avalonia:MaterialIcon Kind="Close" Width="14" Height="14" />
                                    <TextBlock Text="{x:Static lang:Resources.Close}"
                                               FontSize="12.5"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Classes="EcPrimary" 
                                    Padding="14,6"
                                    Click="OnSubmitClick"
                                    ToolTip.Tip="{x:Static lang:Resources.Action_InputTranslate}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <avalonia:MaterialIcon Kind="Send" Width="15" Height="15" />
                                    <TextBlock Text="{x:Static lang:Resources.Action_InputTranslate}"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
            </Border>
        </Border>
    </Panel>
</Window>
