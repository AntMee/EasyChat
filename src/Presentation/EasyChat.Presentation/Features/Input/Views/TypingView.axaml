<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lang="clr-namespace:EasyChat.Presentation.Lang"
        xmlns:vm="clr-namespace:EasyChat.Presentation.Features.Input"
        xmlns:converters="clr-namespace:EasyChat.Presentation.Foundation.Formatting"
        xmlns:controls="clr-namespace:EasyChat.Presentation.Shared.Controls;assembly=EasyChat.Presentation.Shared"
        xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="148"
        Width="720" Height="148" MinWidth="640"
        x:Class="EasyChat.Presentation.Features.Input.Views.TypingView"
        x:DataType="vm:TypingViewModel"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        CornerRadius="16"
        TransparencyLevelHint="Blur"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Title="{x:Static lang:Resources.TranslateToWindow}">

    <Border x:Name="WindowBackground"
            Background="Transparent"
            CornerRadius="16"
            ClipToBounds="True">
        <Border x:Name="MainCard"
                Padding="0" Background="{DynamicResource DialogBackgroundColor}" BorderThickness="0" CornerRadius="16" ClipToBounds="True">
            <Grid RowDefinitions="*,Auto">
                <TextBox Name="InputBox"
                         Grid.Row="0"
                         Margin="10,6,10,4"
                         Padding="4,2"
                         PlaceholderText="{x:Static lang:Resources.InputToTranslate}"
                         VerticalAlignment="Stretch"
                         HorizontalAlignment="Stretch"
                         VerticalContentAlignment="Top"
                         HorizontalContentAlignment="Left"
                         BorderThickness="0"
                         Background="Transparent"
                         FontSize="15"
                         MinWidth="600"
                         MinHeight="40"
                         TextWrapping="Wrap"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         KeyDown="InputBox_OnKeyDown" />

                <!-- Action bar: language controls left, Submit primary + Close right -->
                <Border Grid.Row="1"
                        Background="{DynamicResource EcDialogFooterBrush}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="0,1,0,0"
                        Padding="12,8" CornerRadius="0,0,16,16">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <CheckBox IsChecked="{Binding FollowGlobalLanguage}"
                                      ToolTip.Tip="{x:Static lang:Resources.FollowConfig}"
                                      AutomationProperties.Name="{x:Static lang:Resources.FollowConfig}"
                                      VerticalAlignment="Center">
                                <TextBlock Text="{x:Static lang:Resources.FollowConfig}"
                                           MaxWidth="140"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis" />
                            </CheckBox>
                            <Border Background="Transparent"
                                    ToolTip.Tip="{x:Static lang:Resources.TypingFollowConfigTooltip}"
                                    VerticalAlignment="Center">
                                <avalonia:MaterialIcon Kind="InformationOutline" Width="15" Height="15" Opacity="0.55"
                                                       Foreground="{DynamicResource MutedColor}" />
                            </Border>

                        </StackPanel>

                        <Grid Grid.Column="1" ColumnDefinitions="*,34,*" ColumnSpacing="8" MinWidth="0">
                            <controls:LanguageSelector Grid.Column="0"
                                                       IsEnabled="{Binding !FollowGlobalLanguage}"
                                                       Languages="{Binding SourceLanguages}"
                                                       SelectedLanguage="{Binding SelectedSourceLanguage, Mode=TwoWay}"
                                                       MinWidth="0"
                                                       HorizontalAlignment="Stretch"
                                                       VerticalAlignment="Center" />

                            <Button Grid.Column="1" Classes="Icon"
                                    Width="34" Height="34"
                                    IsEnabled="{Binding !FollowGlobalLanguage}"
                                    Command="{Binding SwapLanguagesCommand}"
                                    ToolTip.Tip="{x:Static lang:Resources.HomeSwapLanguages}"
                                    VerticalAlignment="Center">
                                <avalonia:MaterialIcon Kind="SwapHorizontal" Width="14" Height="14" />
                            </Button>

                            <controls:LanguageSelector Grid.Column="2"
                                                       IsEnabled="{Binding !FollowGlobalLanguage}"
                                                       Languages="{Binding TargetLanguages}"
                                                       SelectedLanguage="{Binding SelectedTargetLanguage, Mode=TwoWay}"
                                                       MinWidth="0"
                                                       HorizontalAlignment="Stretch"
                                                       VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <Button Classes="Icon"
                                    Width="34" Height="34" Padding="0"
                                    Click="OnCloseClick"
                                    ToolTip.Tip="{x:Static lang:Resources.Close}"
                                    AutomationProperties.Name="{x:Static lang:Resources.Close}">
                                <avalonia:MaterialIcon Kind="Close" Width="15" Height="15" />
                            </Button>
                            <Button Classes="Primary"
                                    Width="34" Height="34" Padding="0"
                                    Click="OnSubmitClick"
                                    ToolTip.Tip="{x:Static lang:Resources.Action_InputTranslate}"
                                    AutomationProperties.Name="{x:Static lang:Resources.Action_InputTranslate}">
                                <avalonia:MaterialIcon Kind="Send" Width="15" Height="15" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
