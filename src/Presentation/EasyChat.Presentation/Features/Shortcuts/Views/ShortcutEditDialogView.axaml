<UserControl x:Class="EasyChat.Presentation.Features.Shortcuts.Views.ShortcutEditDialogView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="clr-namespace:EasyChat.Presentation.Shared.Controls;assembly=EasyChat.Presentation.Shared"
             xmlns:langBoxes="clr-namespace:EasyChat.Presentation.Shared.Controls;assembly=EasyChat.Presentation.Shared"
             xmlns:lang="clr-namespace:EasyChat.Presentation.Lang;assembly=EasyChat.Presentation"
             xmlns:converts="clr-namespace:EasyChat.Presentation.Foundation.Formatting;assembly=EasyChat.Presentation"
             xmlns:settings="clr-namespace:EasyChat.Contracts.Settings;assembly=EasyChat.Contracts"
             xmlns:dialogs="clr-namespace:EasyChat.Presentation.Features.Shortcuts"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="450"
             x:DataType="dialogs:ShortcutEditDialogViewModel"
             Width="400">
    <StackPanel Spacing="20">
        <!-- Action Type Selection -->
        <StackPanel Spacing="10">
            <TextBlock Text="{x:Static lang:Resources.ActionType}" FontWeight="SemiBold" />
            <ComboBox ItemsSource="{Binding AvailableActions}"
                      SelectedItem="{Binding SelectedAction}"
                      HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="dialogs:ShortcutActionOption">
                        <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <StackPanel Spacing="8">
            <TextBlock Text="{x:Static lang:Resources.ShortcutRemark}" FontWeight="SemiBold" />
            <TextBox Text="{Binding Remark, Mode=TwoWay}"
                     MaxLength="100"
                     PlaceholderText="{x:Static lang:Resources.ShortcutRemarkPlaceholder}" />
        </StackPanel>

        <!-- Parameter Input (Standard) -->
        <StackPanel Spacing="10" IsVisible="{Binding SelectedAction.RequiresParameter}">
            
            <!-- Standard Parameter UI -->
            <StackPanel Spacing="10" IsVisible="{Binding !IsComplexSwitchAction}">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="{x:Static lang:Resources.Parameter}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SelectedAction.ParameterHint, StringFormat='({0})'}"
                               FontSize="12"
                               Opacity="0.7"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Helper Text if Options Available -->
                <ComboBox ItemsSource="{Binding AvailableParameterOptions}"
                          SelectedItem="{Binding Parameter}"
                          IsVisible="{Binding AvailableParameterOptions, Converter={x:Static ObjectConverters.IsNotNull}}"
                          HorizontalAlignment="Stretch" />

                <TextBox Text="{Binding Parameter}"
                         PlaceholderText="{Binding SelectedAction.ParameterHint}"
                         IsVisible="{Binding AvailableParameterOptions, Converter={x:Static ObjectConverters.IsNull}}" />
            </StackPanel>

            <!-- Complex Parameter UI (Engine, Source, Target) -->
            <StackPanel Spacing="10" IsVisible="{Binding IsComplexSwitchAction}">
                <!-- Engine -->
                <StackPanel>
                    <TextBlock Text="{x:Static lang:Resources.TransEngine}" FontWeight="SemiBold" Margin="0 0 0 5"/>
                    <ComboBox ItemsSource="{Binding AvailableEngineOptions}"
                              SelectedItem="{Binding SelectedEngineOption}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Panel Width="20" Height="20">
                                        <Border ClipToBounds="True" CornerRadius="4"
                                                IsVisible="{Binding Name, Converter={x:Static converts:EngineConverters.HasIcon}}">
                                            <Image Source="{Binding Name, Converter={x:Static converts:EngineConverters.ToIcon}}"
                                                   Stretch="UniformToFill" />
                                        </Border>
                                        <avalonia:MaterialIcon Kind="Robot" Width="20" Height="20"
                                                               Foreground="{DynamicResource SukiText}"
                                                               IsVisible="{Binding Name, Converter={x:Static converts:EngineConverters.HasNoIcon}}" />
                                    </Panel>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource SukiText}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <Grid ColumnDefinitions="*, 10, *">
                    <!-- Source -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{x:Static lang:Resources.Action_SwitchSourceLang}" FontWeight="SemiBold" Margin="0 0 0 5"/>
                        <langBoxes:LanguageSelector Languages="{Binding AvailableLanguages}"
                                  SelectedLanguage="{Binding SelectedSourceLang, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <!-- Target -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{x:Static lang:Resources.Action_SwitchTargetLang}" FontWeight="SemiBold" Margin="0 0 0 5"/>
                        <langBoxes:LanguageSelector Languages="{Binding AvailableLanguages}"
                                  SelectedLanguage="{Binding SelectedTargetLang, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </StackPanel>

        <CheckBox Content="{x:Static lang:Resources.ReadSelectedText}"
                  IsChecked="{Binding ReadSelectedText}"
                  IsEnabled="{Binding !IsReadSelectionLocked}"
                  IsVisible="{Binding IsTextAssistAction}" />

        <StackPanel Spacing="4" IsVisible="{Binding IsModeSelectableTextAssistAction}">
            <TextBlock Text="Mode" FontWeight="SemiBold" />
            <ComboBox ItemsSource="{Binding TextAssistModes}" SelectedItem="{Binding TextAssistMode}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="7" IsVisible="{Binding IsSelectionTranslateAction}">
            <CheckBox Content="{Binding SelectionToolbarOptionText}"
                      IsChecked="{Binding ShowSelectionToolbar}" VerticalAlignment="Center" />
            <Border Width="28" Height="28" CornerRadius="4" Cursor="Help" Background="Transparent"
                    VerticalAlignment="Center" ToolTip.ShowDelay="0"
                    ToolTip.Placement="Right" ToolTip.Tip="{Binding SelectionToolbarOptionTip}"
                    PointerEntered="OnSelectionToolbarInfoPointerEntered"
                    PointerExited="OnSelectionToolbarInfoPointerExited">
                <avalonia:MaterialIcon Kind="InformationOutline" Width="19" Height="19"
                                       Opacity="0.72" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" IsHitTestVisible="False" />
            </Border>
        </StackPanel>

        <StackPanel Spacing="10" IsVisible="{Binding IsInputTranslateAction}">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <CheckBox Content="{x:Static lang:Resources.ReplaceCurrentInput}"
                          IsChecked="{Binding ReplaceCurrentInput}" />
                <Border Background="Transparent"
                        Padding="2"
                        VerticalAlignment="Center"
                        ToolTip.Tip="{x:Static lang:Resources.ReplaceCurrentInputTip}">
                    <avalonia:MaterialIcon Kind="InformationOutline"
                                           Width="16"
                                           Height="16"
                                           Opacity="0.65"
                                           IsHitTestVisible="False" />
                </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{x:Static lang:Resources.InputTranslateSimulatedKeys}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Border Background="Transparent"
                        Padding="2"
                        VerticalAlignment="Center"
                        ToolTip.Tip="{x:Static lang:Resources.InputTranslateSimulatedKeysTip}">
                    <avalonia:MaterialIcon Kind="InformationOutline"
                                           Width="16"
                                           Height="16"
                                           Opacity="0.65"
                                           IsHitTestVisible="False" />
                </Border>
            </StackPanel>

            <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0"
                           Text="{x:Static lang:Resources.BeforeTextInput}"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Command="{Binding ToggleBeforeInputKeyRecordingCommand}"
                        HorizontalAlignment="Stretch"
                        Background="{DynamicResource SukiCardBackground}"
                        BorderBrush="{DynamicResource SukiLowContrastBorderBrush}"
                        BorderThickness="1"
                        ToolTip.Tip="{x:Static lang:Resources.RecordShortcut}">
                    <Grid ColumnDefinitions="*,Auto">
                        <controls:KeySequenceDisplay KeyCombination="{Binding DisplayedBeforeInputKey}"
                                                     IsVisible="{Binding DisplayedBeforeInputKey, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                     HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="0"
                                   Text="{x:Static lang:Resources.RecordingShortcut}"
                                   IsVisible="{Binding IsBeforeInputRecordingPromptVisible}"
                                   Foreground="{DynamicResource SukiPrimaryColor}"
                                   HorizontalAlignment="Center" />
                        <avalonia:MaterialIcon Grid.Column="1" Kind="Keyboard" Opacity="0.5" />
                    </Grid>
                </Button>
                <Button Grid.Column="2"
                        Classes="Flat Danger"
                        Width="26"
                        Height="26"
                        Padding="0"
                        CornerRadius="13"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Command="{Binding ClearBeforeInputKeyCommand}"
                        ToolTip.Tip="{x:Static lang:Resources.Delete}">
                    <avalonia:MaterialIcon Kind="Close" Width="14" Height="14" />
                </Button>
            </Grid>

            <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0"
                           Text="{x:Static lang:Resources.AfterTextInput}"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Command="{Binding ToggleAfterInputKeyRecordingCommand}"
                        HorizontalAlignment="Stretch"
                        Background="{DynamicResource SukiCardBackground}"
                        BorderBrush="{DynamicResource SukiLowContrastBorderBrush}"
                        BorderThickness="1"
                        ToolTip.Tip="{x:Static lang:Resources.RecordShortcut}">
                    <Grid ColumnDefinitions="*,Auto">
                        <controls:KeySequenceDisplay KeyCombination="{Binding DisplayedAfterInputKey}"
                                                     IsVisible="{Binding DisplayedAfterInputKey, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                     HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="0"
                                   Text="{x:Static lang:Resources.RecordingShortcut}"
                                   IsVisible="{Binding IsAfterInputRecordingPromptVisible}"
                                   Foreground="{DynamicResource SukiPrimaryColor}"
                                   HorizontalAlignment="Center" />
                        <avalonia:MaterialIcon Grid.Column="1" Kind="Keyboard" Opacity="0.5" />
                    </Grid>
                </Button>
                <Button Grid.Column="2"
                        Classes="Flat Danger"
                        Width="26"
                        Height="26"
                        Padding="0"
                        CornerRadius="13"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Command="{Binding ClearAfterInputKeyCommand}"
                        ToolTip.Tip="{x:Static lang:Resources.Delete}">
                    <avalonia:MaterialIcon Kind="Close" Width="14" Height="14" />
                </Button>
            </Grid>
        </StackPanel>

        <!-- Hotkey Recording -->
        <StackPanel Spacing="10">
            <TextBlock Text="{x:Static lang:Resources.KeyCombination}" FontWeight="SemiBold" />
            <Button Command="{Binding ToggleRecordingCommand}"
                    HorizontalAlignment="Stretch" Background="{DynamicResource SukiCardBackground}" BorderThickness="0">
                <Button.Styles>
                    <Style Selector="Border.RecordBorder">
                        <Setter Property="BorderBrush" Value="{DynamicResource SukiLowContrastBorderBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                    </Style>
                    <Style Selector="Border.RecordBorder.Recording">
                        <Setter Property="BorderBrush" Value="{DynamicResource SukiPrimaryColor}" />
                        <Setter Property="BorderThickness" Value="2" />
                    </Style>
                </Button.Styles>
                <Border Classes="RecordBorder"
                        Classes.Recording="{Binding IsRecording}"
                        Background="{DynamicResource SukiCardBackground}"
                        CornerRadius="8"
                        Padding="15">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <!-- Show the in-progress chord immediately as each key is pressed. -->
                            <controls:KeySequenceDisplay KeyCombination="{Binding DisplayedKeyCombination}"
                                                         IsVisible="{Binding DisplayedKeyCombination, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                         HorizontalAlignment="Center" />
                            <TextBlock Text="{x:Static lang:Resources.RecordingShortcut}"
                                       IsVisible="{Binding DisplayedKeyCombination, Converter={x:Static StringConverters.IsNullOrEmpty}}"
                                       Foreground="{DynamicResource SukiPrimaryColor}"
                                       FontSize="16"
                                       HorizontalAlignment="Center" />
                        </StackPanel>

                        <avalonia:MaterialIcon Grid.Column="1"
                                               Kind="Keyboard"
                                               Opacity="0.5" />
                    </Grid>
                </Border>
            </Button>
            <TextBlock Text="{x:Static lang:Resources.ClickToRecord}"
                       IsVisible="{Binding IsNotRecording}"
                       FontSize="12"
                       Opacity="0.6"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Dialog Buttons -->
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0 10 0 0">
            <Button Content="{Binding ButtonText}"
                    Command="{Binding SaveCommand}"
                    Classes="Flat" />
            <Button Content="{x:Static lang:Resources.Cancel}"
                    Command="{Binding CancelCommand}" />
        </StackPanel>
    </StackPanel>
</UserControl>
