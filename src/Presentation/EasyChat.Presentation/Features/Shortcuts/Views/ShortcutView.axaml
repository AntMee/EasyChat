<UserControl x:Class="EasyChat.Presentation.Features.Shortcuts.Views.ShortcutView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:lang="clr-namespace:EasyChat.Presentation.Lang;assembly=EasyChat.Presentation"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"

             xmlns:controls="clr-namespace:EasyChat.Presentation.Shared.Controls;assembly=EasyChat.Presentation.Shared"
             xmlns:viewModels="clr-namespace:EasyChat.Presentation.Features.Shortcuts"
             xmlns:settingsState="clr-namespace:EasyChat.Presentation.Features.Settings.State"
             x:DataType="viewModels:ShortcutViewModel"
             mc:Ignorable="d"
             Focusable="True">

    <Grid RowDefinitions="Auto,*" Margin="25">
        <!-- Header -->
        <TextBlock Text="{x:Static lang:Resources.Shortcut}"
                   FontSize="28"
                   FontWeight="Bold"
                   Margin="0 0 0 20" />

        <!-- Tab Control -->
        <TabControl Grid.Row="1">
            <!-- Basic Hotkeys Tab (includes translation and correction) -->
            <TabItem Header="{x:Static lang:Resources.BasicShortcuts}">
                <Grid RowDefinitions="*,Auto" RowSpacing="15" Margin="0 20">

                    <!-- Basic Shortcuts List -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding BasicShortcuts}">
                            <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="settingsState:ShortcutEntryState">
                                    <suki:GlassCard Margin="0 0 0 10" Padding="18">
                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                            <!-- Action Name -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayText}"
                                                           FontSize="15"
                                                           FontWeight="SemiBold" />
                                            </StackPanel>

                                            <!-- Key Combination Display -->
                                            <controls:KeySequenceDisplay Grid.Column="1"
                                                                         KeyCombination="{Binding KeyCombination}"
                                                                         MinWidth="130"
                                                                         Margin="10 0"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center" />

                                            <!-- Enable Toggle -->
                                            <ToggleSwitch Grid.Column="2"
                                                          IsChecked="{Binding IsEnabled}"
                                                          Margin="10 0" />

                                            <!-- Actions -->
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="0">
                                                <Button Classes="Flat"
                                                        CornerRadius="8,0,0,8"
                                                        Command="{Binding $parent[ItemsControl].((viewModels:ShortcutViewModel)DataContext).EditEntryCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="{x:Static lang:Resources.Edit}">
                                                    <Button.Content>
                                                        <avalonia:MaterialIcon Kind="Pencil" />
                                                    </Button.Content>
                                                </Button>
                                                <Button Classes="Flat Danger"
                                                        CornerRadius="0,8,8,0"
                                                        Command="{Binding $parent[ItemsControl].((viewModels:ShortcutViewModel)DataContext).RemoveEntryCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="{x:Static lang:Resources.Delete}">
                                                    <Button.Content>
                                                        <avalonia:MaterialIcon Kind="TrashCan" />
                                                    </Button.Content>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </suki:GlassCard>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Add Button -->
                    <Button Grid.Row="1"
                            Classes="Flat"
                            Command="{Binding AddEntryCommand}"
                            CommandParameter="Basic"
                            HorizontalAlignment="Left">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <avalonia:MaterialIcon Kind="Plus" />
                                <TextBlock Margin="5 0 0 0" Text="{x:Static lang:Resources.AddBasicShortcut}" />
                            </StackPanel>
                        </Button.Content>
                    </Button>
                </Grid>
            </TabItem>

            <!-- Language Switch Tab -->
            <TabItem Header="{x:Static lang:Resources.LanguageShortcuts}">
                <Grid RowDefinitions="*,Auto" RowSpacing="15" Margin="0 20">

                    <!-- Language Switch Shortcuts -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding LanguageShortcuts}">
                            <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="settingsState:ShortcutEntryState">
                                    <suki:GlassCard Margin="0 0 0 10" Padding="18">
                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                            <!-- Parameter Only (no action name) -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ParameterDisplayText}"
                                                           FontSize="15"
                                                           FontWeight="SemiBold" />
                                            </StackPanel>

                                            <!-- Key Combination -->
                                            <controls:KeySequenceDisplay Grid.Column="1"
                                                                         KeyCombination="{Binding KeyCombination}"
                                                                         MinWidth="130"
                                                                         Margin="10 0"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center" />

                                            <!-- Enable Toggle -->
                                            <ToggleSwitch Grid.Column="2"
                                                          IsChecked="{Binding IsEnabled}"
                                                          Margin="10 0" />

                                            <!-- Actions -->
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="0">
                                                <Button Classes="Flat"
                                                        CornerRadius="8,0,0,8"
                                                        Command="{Binding $parent[ItemsControl].((viewModels:ShortcutViewModel)DataContext).EditEntryCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="{x:Static lang:Resources.Edit}">
                                                    <Button.Content>
                                                        <avalonia:MaterialIcon Kind="Pencil" />
                                                    </Button.Content>
                                                </Button>
                                                <Button Classes="Flat Danger"
                                                        CornerRadius="0,8,8,0"
                                                        Command="{Binding $parent[ItemsControl].((viewModels:ShortcutViewModel)DataContext).RemoveEntryCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="{x:Static lang:Resources.Delete}">
                                                    <Button.Content>
                                                        <avalonia:MaterialIcon Kind="TrashCan" />
                                                    </Button.Content>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </suki:GlassCard>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Add Button -->
                    <Button Grid.Row="1"
                            Classes="Flat"
                            Command="{Binding AddEntryCommand}"
                            CommandParameter="Language"
                            HorizontalAlignment="Left">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <avalonia:MaterialIcon Kind="Plus" />
                                <TextBlock Margin="5 0 0 0" Text="{x:Static lang:Resources.AddLanguageShortcut}" />
                            </StackPanel>
                        </Button.Content>
                    </Button>
                </Grid>
            </TabItem>
        </TabControl>


    </Grid>
</UserControl>
