<UserControl x:Class="EasyChat.Presentation.Features.Shortcuts.Views.ShortcutView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:lang="clr-namespace:EasyChat.Presentation.Lang;assembly=EasyChat.Presentation"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="clr-namespace:EasyChat.Presentation.Shared.Controls;assembly=EasyChat.Presentation.Shared"
             xmlns:ec="clr-namespace:EasyChat.Presentation.Shared.Controls;assembly=EasyChat.Presentation.Shared"
             xmlns:viewModels="clr-namespace:EasyChat.Presentation.Features.Shortcuts"
             xmlns:settingsState="clr-namespace:EasyChat.Presentation.Features.Settings.State"
             xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
             x:DataType="viewModels:ShortcutViewModel"
             mc:Ignorable="d"
             Focusable="True"
             Background="{DynamicResource GhostColor}">

    <Grid
          RowDefinitions="Auto,Auto,*" Margin="32,28,32,28" MaxWidth="1120" HorizontalAlignment="Stretch">

        <Grid RowDefinitions="Auto,Auto,Auto"
              ColumnDefinitions="*,Auto"
              Margin="0,0,0,8"
              ColumnSpacing="16">
            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="{x:Static lang:Resources.Shortcut}"
                       Classes="h2"
                       VerticalAlignment="Center"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       AutomationProperties.Name="{x:Static lang:Resources.Shortcut}" />

            <ContentControl Grid.Row="0" Grid.Column="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right">
                <Button Classes="Primary"
                        Command="{Binding AddEntryCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <avalonia:MaterialIcon Kind="Plus" Width="16" Height="16" />
                        <TextBlock Text="{Binding AddButtonLabel}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </ContentControl>

            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                       Text="{Binding ActiveCategoryTitle}"
                       Classes="p"
                       Foreground="{DynamicResource MutedColor}"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0"
                       MaxWidth="720"
                       HorizontalAlignment="Left" />
        </Grid>

        <!-- Category switch (interaction, not TabControl chrome) -->
        <Border HorizontalAlignment="Left" Margin="0,4,0,16" Grid.Row="1" Background="{DynamicResource GhostColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="{DynamicResource LgCornerRadius}" Padding="16">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <RadioButton
                             Content="{x:Static lang:Resources.BasicShortcuts}"
                             IsChecked="{Binding IsBasicCategory}"
                             GroupName="ShortcutCategory" />
                <RadioButton
                             Content="{x:Static lang:Resources.LanguageShortcuts}"
                             IsChecked="{Binding IsLanguageCategory}"
                             GroupName="ShortcutCategory" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <!-- Empty state with primary CTA -->
            <shad:Card
                    IsVisible="{Binding HasNoActiveShortcuts}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    HasShadow="True">
                <StackPanel Spacing="12" HorizontalAlignment="Center" MaxWidth="420">
                    <avalonia:MaterialIcon Kind="Keyboard"
                                           Width="36" Height="36"
                                           Foreground="{DynamicResource MutedColor}"
                                           HorizontalAlignment="Center" />
                    <TextBlock Text="{x:Static lang:Resources.HomeHealthShortcutTodo}"
                               Classes="Caption" Foreground="{DynamicResource MutedColor}" TextWrapping="Wrap" Opacity="0.95"
                               TextAlignment="Center"
                               HorizontalAlignment="Center" />
                    <Button Classes="Primary"
                            HorizontalAlignment="Center"
                            Command="{Binding AddEntryCommand}"
                            Content="{Binding AddButtonLabel}" />
                </StackPanel>
            </shad:Card>

            <ScrollViewer IsVisible="{Binding HasActiveShortcuts}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding ActiveShortcuts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="settingsState:ShortcutEntryState">
                            <shad:Card
                                    Margin="0,0,0,10"
                                    HorizontalAlignment="Stretch"
                                    HasShadow="True">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                                    <!-- Primary hit: click row body to edit. -->
                                    <Button
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Command="{Binding $parent[ItemsControl].((viewModels:ShortcutViewModel)DataContext).EditEntryCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="{x:Static lang:Resources.Edit}" VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0">
                                        <StackPanel Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding DisplayTitle}"
                                                           Classes="Large"
                                                           Foreground="{DynamicResource ForegroundColor}" />
                                                <TextBlock Text="{Binding ActionDisplayText}"
                                                           IsVisible="{Binding HasRemark}"
                                                           Classes="Muted"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding ParameterDisplayText}"
                                                       IsVisible="{Binding ParameterDisplayText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                       Classes="Caption"
                                                       Foreground="{DynamicResource MutedColor}" />
                                        </StackPanel>
                                    </Button>

                                    <controls:KeySequenceDisplay Grid.Column="1"
                                                                 KeyCombination="{Binding KeyCombination}"
                                                                 MinWidth="130"
                                                                 VerticalAlignment="Center" />

                                    <ToggleSwitch Grid.Column="2"
                                                  IsChecked="{Binding IsEnabled}"
                                                  VerticalAlignment="Center" />

                                    <!-- Row body already opens edit; only keep destructive action here. -->
                                    <Button Grid.Column="3"
                                            Classes="Destructive"
                                            Command="{Binding $parent[ItemsControl].((viewModels:ShortcutViewModel)DataContext).RemoveEntryCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="{x:Static lang:Resources.Delete}"
                                            VerticalAlignment="Center">
                                        <avalonia:MaterialIcon Kind="TrashCan" Width="16" Height="16" />
                                    </Button>
                                </Grid>
                            </shad:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
