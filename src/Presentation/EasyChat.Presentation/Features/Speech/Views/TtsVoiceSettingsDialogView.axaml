<UserControl x:Class="EasyChat.Presentation.Features.Speech.Views.TtsVoiceSettingsDialogView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:EasyChat.Presentation.Features.Speech"
             xmlns:lang="clr-namespace:EasyChat.Presentation.Lang;assembly=EasyChat.Presentation"
             xmlns:converts="clr-namespace:EasyChat.Presentation.Foundation.Formatting;assembly=EasyChat.Presentation"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="500"
             x:DataType="viewModels:TtsVoiceSettingsDialogViewModel"
             MinWidth="560"
             MaxWidth="720"
             Width="640"
             Height="500">
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Padding="22,18,22,0">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                <Border Width="40" Height="40" CornerRadius="11"
                        Background="{DynamicResource PrimaryColor10}">
                    <avalonia:MaterialIcon Kind="VolumeHigh"
                                           Width="20" Height="20"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryColor}" />
                </Border>
                <TextBlock Grid.Column="1"
                           Classes="Large" TextWrapping="Wrap"
                           Text="{x:Static lang:Resources.Tts_Configuration}"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{x:Static lang:Resources.Tts_Provider}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedColor}" />
                    <ComboBox ItemsSource="{Binding AvailableProviders}"
                              SelectedItem="{Binding SelectedProvider}"
                              MinWidth="140" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="18,10,18,0">
            <Grid>
                <TextBlock Text="{x:Static lang:Resources.Tts_NoVoicesConfigured}"
                           IsVisible="{Binding !ConfiguredVoices.Count}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Classes="Muted" />
                <ListBox ItemsSource="{Binding ConfiguredVoices}"
                         SelectedItem="{Binding SelectedConfiguredVoice}"
                         Background="Transparent">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="190,*,Auto" ColumnSpacing="14" MinHeight="32" Margin="8,4">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalAlignment="Center">
                                    <Border Width="22" Height="16" CornerRadius="2" ClipToBounds="True"
                                            VerticalAlignment="Center">
                                        <Image Source="{Binding Language.Icon, Converter={x:Static converts:LanguageFlagConverters.ToIcon}}"
                                               Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Language.EnglishName}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ForegroundColor}" />
                                        <TextBlock Text="{Binding Language.ChineseName}" Classes="Muted" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8" Grid.Column="1"
                                            VerticalAlignment="Center">
                                    <avalonia:MaterialIcon Kind="AccountVoice" Width="16" Height="16"
                                                           Foreground="{DynamicResource MutedColor}" />
                                    <TextBlock Text="{Binding VoiceName}"
                                               Foreground="{DynamicResource ForegroundColor}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Text="{Binding VoiceLocale}" Grid.Column="2"
                                           VerticalAlignment="Center" Classes="Muted" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Classes="DialogFooter" Margin="0,12,0,0" Padding="22,14,22,18">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="Primary" Command="{Binding AddCommand}" Content="{x:Static lang:Resources.Add}" />
                    <Button Classes="Ghost" Command="{Binding EditCommand}"
                            CommandParameter="{Binding SelectedConfiguredVoice}"
                            IsEnabled="{Binding SelectedConfiguredVoice, Converter={x:Static ObjectConverters.IsNotNull}}"
                            Content="{x:Static lang:Resources.Edit}" />
                    <Button Classes="Destructive" Command="{Binding DeleteCommand}"
                            CommandParameter="{Binding SelectedConfiguredVoice}"
                            IsEnabled="{Binding SelectedConfiguredVoice, Converter={x:Static ObjectConverters.IsNotNull}}"
                            Content="{x:Static lang:Resources.Delete}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="{x:Static lang:Resources.Close}"
                        Classes="Ghost"
                        MinWidth="88"
                        Command="{Binding CloseCommand}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
