<UserControl x:Class="EasyChat.Presentation.Features.Speech.Views.SpeechRecognitionView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:EasyChat.Presentation.Features.Speech;assembly=EasyChat.Presentation"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
             xmlns:converts="clr-namespace:EasyChat.Presentation.Foundation.Formatting;assembly=EasyChat.Presentation"
             xmlns:lang="clr-namespace:EasyChat.Presentation.Lang;assembly=EasyChat.Presentation"
             xmlns:ec="clr-namespace:EasyChat.Presentation.Shared.Controls;assembly=EasyChat.Presentation.Shared"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:DataType="vm:SpeechRecognitionViewModel" Background="{DynamicResource GhostColor}">

    <UserControl.Styles>
        <Style Selector="FlyoutPresenter.AudioSourceFlyout">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>

    </UserControl.Styles>

    <Panel>
        <!-- Loading overlay - shown initially -->
        <Grid x:Name="LoadingOverlay" IsVisible="True">
            <Border Background="{DynamicResource GhostColor}" Opacity="0.92" />
            <StackPanel Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                <shad:Loading Width="24" Height="24"
                              HorizontalAlignment="Center"
                              Foreground="{DynamicResource PrimaryColor}" />
                <TextBlock Text="{x:Static lang:Resources.Loading}"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource MutedColor}" />
            </StackPanel>
        </Grid>

        <!-- Main Content - hidden initially -->
        <Grid x:Name="MainContent" IsVisible="False" RowDefinitions="Auto,Auto,*" Margin="32,28,32,28" MaxWidth="1120" HorizontalAlignment="Stretch">
            <Grid RowDefinitions="Auto,Auto,Auto"
                  ColumnDefinitions="*,Auto"
                  Margin="0,0,0,8"
                  ColumnSpacing="16"
                  IsVisible="{Binding IsSupported}">
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="{x:Static lang:Resources.Page_SpeechRecognition}"
                           Classes="h2"
                           VerticalAlignment="Center"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           AutomationProperties.Name="{x:Static lang:Resources.Page_SpeechRecognition}" />

                <ContentControl Grid.Row="0" Grid.Column="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right">
                    <Button Command="{Binding ToggleRecordingCommand}"
                            Classes="Primary">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <avalonia:MaterialIcon Kind="{Binding RecordingIcon}" Width="18" Height="18"/>
                            <TextBlock Text="{Binding RecordingText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </ContentControl>

                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                           Text="{x:Static lang:Resources.HomeQuickSpeechHint}"
                           Classes="Small"
                           LineHeight="20"
                           Foreground="{DynamicResource MutedColor}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"
                           MaxWidth="720"
                           HorizontalAlignment="Left" />
            </Grid>

            <!-- Workspace mode: Live / Overlay -->
            <TabControl Grid.Row="1"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,8"
                        IsVisible="{Binding IsSupported}"
                        SelectedIndex="{Binding WorkspaceTabIndex}">
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <avalonia:MaterialIcon Kind="Robot" Width="16" Height="16"
                                                   Foreground="{DynamicResource PrimaryColor}" />
                            <TextBlock Text="{x:Static lang:Resources.Tab_Recognition}" FontWeight="SemiBold" />
                        </StackPanel>
                    </TabItem.Header>
                </TabItem>
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <avalonia:MaterialIcon Kind="PictureInPictureBottomRight" Width="16" Height="16"
                                                   Foreground="{DynamicResource PrimaryColor}" />
                            <TextBlock Text="{x:Static lang:Resources.FloatingWindow}" FontWeight="SemiBold" />
                        </StackPanel>
                    </TabItem.Header>
                </TabItem>
            </TabControl>

            <Grid Grid.Row="2" IsVisible="{Binding IsSupported}">
            <!-- Live recognition workspace -->
            <Grid IsVisible="{Binding IsLiveWorkspace}" RowDefinitions="Auto,*">
                        <!-- Live session toolbar -->
                        <shad:Card Grid.Row="0" Margin="0,0,0,10" HasShadow="True">
                            <WrapPanel Orientation="Horizontal">
                                <StackPanel Orientation="Horizontal" Margin="0,4,18,4" VerticalAlignment="Center" Spacing="8">
                                    <TextBlock Text="{x:Static lang:Resources.Language}" Classes="Small"
                                               Margin="0"
                                               VerticalAlignment="Center"/>
                                    <ec:LanguageSelector Languages="{Binding RecognitionLanguages}"
                                                         SelectedLanguage="{Binding SelectedRecognitionModel, Mode=TwoWay}"
                                                         MinWidth="210" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,4,18,4" VerticalAlignment="Center" Spacing="12">
                                    <CheckBox Content="{x:Static lang:Resources.Speech_EnableTranslation}"
                                              IsChecked="{Binding IsTranslationEnabled}" />
                                    <CheckBox Content="{x:Static lang:Resources.Speech_RealTimePreview}"
                                              IsChecked="{Binding IsRealTimePreviewEnabled}"
                                              IsVisible="{Binding IsRealTimePreviewVisible}"
                                              ToolTip.Tip="{x:Static lang:Resources.Speech_RealTimePreviewTip}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,4,18,4"
                                            VerticalAlignment="Center"
                                            Spacing="8"
                                            IsVisible="{Binding IsPromptSelectionVisible}">
                                    <TextBlock Text="{x:Static lang:Resources.Prompts}"
                                               Classes="Small"
                                               Margin="0"
                                               VerticalAlignment="Center" />
                                    <ComboBox ItemsSource="{Binding PromptEntries}"
                                              SelectedValue="{Binding SelectedPromptId}"
                                              SelectedValueBinding="{Binding Id}"
                                              DisplayMemberBinding="{Binding Name}"
                                              MinWidth="160" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,4,18,4"
                                            VerticalAlignment="Center"
                                            Spacing="8"
                                            IsVisible="{Binding IsTranslationEnabled}">
                                    <TextBlock Text="{x:Static lang:Resources.TransEngine}" Classes="Small"
                                               Margin="0"
                                               VerticalAlignment="Center"/>
                                    <ComboBox ItemsSource="{Binding EngineOptions}"
                                              SelectedItem="{Binding SelectedEngineOption}"
                                              MinWidth="160">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Panel Width="20" Height="20">
                                                        <Border ClipToBounds="True" CornerRadius="4"
                                                                IsVisible="{Binding Name, Converter={x:Static converts:EngineConverters.HasIcon}}">
                                                            <Image Source="{Binding Name, Converter={x:Static converts:EngineConverters.ToIcon}}"
                                                                   Stretch="UniformToFill" />
                                                        </Border>
                                                        <avalonia:MaterialIcon Kind="Robot" Width="20" Height="20"
                                                                               Foreground="{DynamicResource MutedColor}"
                                                                               IsVisible="{Binding Name, Converter={x:Static converts:EngineConverters.HasNoIcon}}" />
                                                    </Panel>
                                                    <TextBlock Text="{Binding Name}"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource ForegroundColor}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,4,18,4"
                                            VerticalAlignment="Center"
                                            Spacing="8"
                                            IsVisible="{Binding IsTranslationEnabled}">
                                    <TextBlock Text="{x:Static lang:Resources.TargetLang}" Classes="Small"
                                               Margin="0"
                                               VerticalAlignment="Center"/>
                                    <ec:LanguageSelector Languages="{Binding TargetLanguages}"
                                                         SelectedLanguage="{Binding SelectedTargetLanguage, Mode=TwoWay}"
                                                         MinWidth="160" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,4,0,4" VerticalAlignment="Center" Spacing="8">
                                    <TextBlock Text="{x:Static lang:Resources.Speech_AudioSource}" Classes="Small"
                                               Margin="0"
                                               VerticalAlignment="Center"/>
                                    <Button Classes="Outline"
                                            Width="200"
                                            Padding="8,4"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Center">
                                        <Button.Flyout>
                                            <Flyout Placement="Bottom"
                                                    ShowMode="Standard"
                                                    FlyoutPresenterClasses="AudioSourceFlyout">
                                                <shad:Card MinWidth="280" MaxHeight="500" Background="{DynamicResource DialogBackgroundColor}" HasShadow="False">
                                                    <Grid RowDefinitions="Auto,*">
                                                        <Grid ColumnDefinitions="*,Auto" Margin="12,10">
                                                            <TextBlock Text="{x:Static lang:Resources.Speech_SelectSourceTitle}" Classes="Small"
                                                                       Margin="0"
                                                                       VerticalAlignment="Center"/>
                                                            <Button Grid.Column="1"
                                                                    Command="{Binding RefreshSourcesCommand}"
                                                                    Classes="Icon"
                                                                    ToolTip.Tip="{x:Static lang:Resources.Speech_Refresh}">
                                                                <avalonia:MaterialIcon Kind="Refresh" Width="16" Height="16"/>
                                                            </Button>
                                                        </Grid>
                                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="400">
                                                            <ItemsControl ItemsSource="{Binding AudioSources}" Margin="0">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <CheckBox IsChecked="{Binding IsSelected}"
                                                                                  HorizontalAlignment="Stretch"
                                                                                  Margin="0,2"
                                                                                  Padding="6,4"
                                                                                  Background="Transparent"
                                                                                  CornerRadius="4">
                                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                                <Image Source="{Binding AppIcon}"
                                                                                       Width="20" Height="20"
                                                                                       RenderOptions.BitmapInterpolationMode="HighQuality"
                                                                                       VerticalAlignment="Center" />
                                                                                <TextBlock Text="{Binding DisplayName}"
                                                                                           TextTrimming="CharacterEllipsis"
                                                                                           VerticalAlignment="Center"
                                                                                           Foreground="{DynamicResource ForegroundColor}"/>
                                                                            </StackPanel>
                                                                        </CheckBox>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </ScrollViewer>
                                                    </Grid>
                                                </shad:Card>
                                            </Flyout>
                                        </Button.Flyout>
                                        <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch">
                                            <TextBlock Text="{Binding SelectedSourcesSummary}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource ForegroundColor}"/>
                                            <avalonia:MaterialIcon Grid.Column="1"
                                                                   Kind="ChevronDown"
                                                                   Width="16" Height="16"
                                                                   Margin="8,0,0,0"
                                                                   Foreground="{DynamicResource MutedColor}"/>
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </WrapPanel>
                        </shad:Card>

                        <!-- Subtitles Display -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="{Binding IsTranslationEnabled, Converter={x:Static converts:BoolToGridLengthConverter.Instance}}" />
                            </Grid.ColumnDefinitions>

                            <shad:Card Grid.Column="0" Margin="0,0,6,0" HasShadow="True">
                                <shad:Card.Header>
                                    <Grid ColumnDefinitions="*, Auto">
                                        <shad:CardTitle Content="{x:Static lang:Resources.Speech_Recognized}"
                                                        VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Command="{Binding ClearHistoryCommand}"
                                                Classes="Icon"
                                                ToolTip.Tip="{x:Static lang:Resources.Speech_ClearHistory}">
                                            <avalonia:MaterialIcon Kind="DeleteSweep" Width="18" Height="18"
                                                                   Foreground="{DynamicResource MutedColor}"/>
                                        </Button>
                                    </Grid>
                                </shad:Card.Header>
                                <ScrollViewer>
                                        <ItemsControl ItemsSource="{Binding SubtitleItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource GhostColor}"
                                                            BorderBrush="{DynamicResource BorderColor}"
                                                            BorderThickness="1"
                                                            CornerRadius="{DynamicResource LgCornerRadius}"
                                                            Padding="10,12"
                                                            Margin="0,0,0,8">
                                                        <StackPanel Spacing="4">
                                                            <TextBlock Text="{Binding Timestamp, StringFormat=\{0:hh\\:mm\\:ss\}}"
                                                                       Classes="Caption"
                                                                       Foreground="{DynamicResource MutedColor}"/>
                                                            <TextBlock Text="{Binding OriginalText}"
                                                                       TextWrapping="Wrap"
                                                                       LineHeight="22"
                                                                       Foreground="{DynamicResource ForegroundColor}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                            </shad:Card>

                            <shad:Card Grid.Column="1" Margin="6,0,0,0" IsVisible="{Binding IsTranslationEnabled}" HasShadow="True">
                                <shad:Card.Header>
                                    <shad:CardTitle Content="{x:Static lang:Resources.Speech_Translated}" />
                                </shad:Card.Header>
                                <ScrollViewer>
                                         <ItemsControl ItemsSource="{Binding SubtitleItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource GhostColor}"
                                                            BorderBrush="{DynamicResource BorderColor}"
                                                            BorderThickness="1"
                                                            CornerRadius="{DynamicResource LgCornerRadius}"
                                                            Padding="10,12"
                                                            Margin="0,0,0,8">
                                                        <StackPanel Spacing="4">
                                                            <Grid>
                                                                <TextBlock Text="{Binding Timestamp, StringFormat=\{0:hh\\:mm\\:ss\}}"
                                                                           Classes="Caption"
                                                                           Foreground="{DynamicResource MutedColor}"
                                                                           HorizontalAlignment="Left"/>
                                                                <shad:Loading IsVisible="{Binding IsTranslating}" HorizontalAlignment="Right" Width="16" Height="16"/>
                                                            </Grid>
                                                            <TextBlock Text="{Binding TranslatedText}"
                                                                       TextWrapping="Wrap"
                                                                       LineHeight="22"
                                                                       Foreground="{DynamicResource PrimaryColor}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                            </shad:Card>
                        </Grid>
            </Grid>

            <!-- Overlay configuration workspace -->
            <ScrollViewer IsVisible="{Binding IsOverlayWorkspace}"
                          Margin="0,0,-15,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="14" Margin="0,0,15,8">

                    <!-- Actions -->
                    <shad:Card HasShadow="True">
                        <shad:Card.Header>
                            <StackPanel Spacing="4">
                                <shad:CardTitle Content="{x:Static lang:Resources.FloatingWindow_Config}" />
                                <shad:CardDescription>
                                    <TextBlock Text="{x:Static lang:Resources.HomeQuickSpeechHint}"
                                               TextWrapping="Wrap" LineHeight="18" Opacity="0.95"/>
                                </shad:CardDescription>
                            </StackPanel>
                        </shad:Card.Header>
                        <shad:Card.Footer>
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button Command="{Binding ToggleFloatingWindowCommand}"
                                        Classes="Primary">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <avalonia:MaterialIcon Kind="PictureInPictureBottomRight" Width="18" Height="18"/>
                                        <TextBlock VerticalAlignment="Center"
                                                   Text="{Binding IsFloatingWindowOpen, Converter={x:Static converts:BoolToTextConverter.Instance}, ConverterParameter='FloatingWindow_Open|FloatingWindow_Close'}"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ToggleLockCommand}"
                                        Classes="Ghost"
                                        IsVisible="{Binding IsFloatingWindowOpen}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <avalonia:MaterialIcon Width="18" Height="18"
                                                               Kind="{Binding IsFloatingWindowLocked, Converter={x:Static converts:BoolToIconConverter.Instance}, ConverterParameter='Lock;LockOpen'}"/>
                                        <TextBlock VerticalAlignment="Center"
                                                   Text="{Binding IsFloatingWindowLocked, Converter={x:Static converts:BoolToTextConverter.Instance}, ConverterParameter='FloatingWindow_Lock|FloatingWindow_Unlock'}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </shad:Card.Footer>
                    </shad:Card>

                    <!-- Presets -->
                    <shad:Card HasShadow="True">
                        <shad:Card.Header>
                            <StackPanel Spacing="4">
                                <shad:CardTitle Content="{x:Static lang:Resources.SubtitlePreset_Title}" />
                                <shad:CardDescription>
                                    <TextBlock Text="{x:Static lang:Resources.SubtitlePreset_Hint}"
                                               TextWrapping="Wrap" LineHeight="18" Opacity="0.95"/>
                                </shad:CardDescription>
                            </StackPanel>
                        </shad:Card.Header>
                        <ItemsControl ItemsSource="{Binding AppearancePresets}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SubtitleAppearancePreset">
                                        <Button Classes="Ghost"
                                                Margin="0,0,8,8"
                                                Command="{Binding $parent[UserControl].((vm:SpeechRecognitionViewModel)DataContext).ApplyAppearancePresetCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="{Binding Description}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border Width="14" Height="14" CornerRadius="4"
                                                        BorderThickness="1"
                                                        BorderBrush="{DynamicResource BorderColor}"
                                                        Background="{Binding PrimaryFontColor, Converter={x:Static converts:ColorToBrushConverter.Instance}}" />
                                                <Border Width="14" Height="14" CornerRadius="4"
                                                        BorderThickness="1"
                                                        BorderBrush="{DynamicResource BorderColor}"
                                                        Margin="-10,0,0,0"
                                                        Background="{Binding SecondaryFontColor, Converter={x:Static converts:ColorToBrushConverter.Instance}}" />
                                                <TextBlock Text="{Binding DisplayName}"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource ForegroundColor}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                    </shad:Card>

                    <!-- Primary / Secondary: label column Auto so CJK is never clipped -->
                    <Grid ColumnDefinitions="*,14,*">
                        <shad:Card HasShadow="True">
                            <shad:Card.Header>
                                <shad:CardTitle Content="{x:Static lang:Resources.Subtitle_Primary}"
                                                Foreground="{DynamicResource PrimaryColor}" />
                            </shad:Card.Header>
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto"
                                  RowSpacing="14" ColumnSpacing="16">
                                    <TextBlock Classes="Small" Foreground="{DynamicResource ForegroundColor}" Text="{x:Static lang:Resources.PromptContent}"
                                               VerticalAlignment="Center" MinWidth="72"/>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding MainSourceOptions}"
                                              SelectedValue="{Binding MainSubtitleSource}"
                                              SelectedValueBinding="{Binding Key}"
                                              DisplayMemberBinding="{Binding Value}"  HorizontalAlignment="Stretch"/>
                                    <TextBlock Grid.Row="1" Classes="Small" Text="{x:Static lang:Resources.FontFamily}"
                                               VerticalAlignment="Center" MinWidth="72"/>
                                    <ComboBox Grid.Row="1" Grid.Column="1"
                                              ItemsSource="{Binding AvailableFonts}"
                                              SelectedItem="{Binding PrimaryFontFamily}"  HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding .}"
                                                           FontFamily="{Binding ., Converter={x:Static converts:StringToFontFamilyConverter.Instance}}"
                                                           VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Grid.Row="2" Classes="Small" Text="{x:Static lang:Resources.FontSize}"
                                               VerticalAlignment="Center" MinWidth="72"/>
                                    <NumericUpDown Grid.Row="2" Grid.Column="1"
                                                   Value="{Binding PrimaryFontSize}" FormatString="F0"
                                                   Minimum="10" Maximum="100" 
                                                   HorizontalAlignment="Stretch"/>
                                    <TextBlock Grid.Row="3" Classes="Small" Text="{x:Static lang:Resources.FontColor}"
                                               VerticalAlignment="Center" MinWidth="72"/>
                                    <ColorPicker Grid.Row="3"
                                                 Grid.Column="1"
                                                 Color="{Binding PrimaryFontColor, Converter={x:Static converts:ColorToHexConverter.Instance}, Mode=TwoWay}"
                                                 IsAlphaEnabled="True"
                                                 HorizontalAlignment="Stretch" />
                                </Grid>
                        </shad:Card>

                        <shad:Card Grid.Column="2" HasShadow="True">
                            <shad:Card.Header>
                                <shad:CardTitle Content="{x:Static lang:Resources.Subtitle_Secondary}" />
                            </shad:Card.Header>
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto"
                                  RowSpacing="14" ColumnSpacing="16">
                                    <TextBlock Classes="Small" Foreground="{DynamicResource ForegroundColor}" Text="{x:Static lang:Resources.PromptContent}"
                                               VerticalAlignment="Center" MinWidth="72"/>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding SecondarySourceOptions}"
                                              SelectedValue="{Binding SecondarySubtitleSource}"
                                              SelectedValueBinding="{Binding Key}"
                                              DisplayMemberBinding="{Binding Value}"  HorizontalAlignment="Stretch"/>
                                    <TextBlock Grid.Row="1" Classes="Small" Text="{x:Static lang:Resources.FontFamily}"
                                               VerticalAlignment="Center" MinWidth="72"/>
                                    <ComboBox Grid.Row="1" Grid.Column="1"
                                              ItemsSource="{Binding AvailableFonts}"
                                              SelectedItem="{Binding SecondaryFontFamily}"  HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding .}"
                                                           FontFamily="{Binding ., Converter={x:Static converts:StringToFontFamilyConverter.Instance}}"
                                                           VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Grid.Row="2" Classes="Small" Text="{x:Static lang:Resources.FontSize}"
                                               VerticalAlignment="Center" MinWidth="72"/>
                                    <NumericUpDown Grid.Row="2" Grid.Column="1"
                                                   Value="{Binding SecondaryFontSize}" FormatString="F0"
                                                   Minimum="10" Maximum="100" 
                                                   HorizontalAlignment="Stretch"/>
                                    <TextBlock Grid.Row="3" Classes="Small" Text="{x:Static lang:Resources.FontColor}"
                                               VerticalAlignment="Center" MinWidth="72"/>
                                    <ColorPicker Grid.Row="3"
                                                 Grid.Column="1"
                                                 Color="{Binding SecondaryFontColor, Converter={x:Static converts:ColorToHexConverter.Instance}, Mode=TwoWay}"
                                                 IsAlphaEnabled="True"
                                                 HorizontalAlignment="Stretch" />
                                </Grid>
                        </shad:Card>
                    </Grid>

                    <!-- Window appearance: one field per cell, no jammed labels -->
                    <shad:Card HasShadow="True">
                        <shad:Card.Header>
                            <shad:CardTitle Content="{x:Static lang:Resources.Window_Appearance}" />
                        </shad:Card.Header>
                        <UniformGrid Columns="2" Rows="4">
                                <StackPanel Margin="0,0,20,14" Spacing="6">
                                    <TextBlock Classes="Small" Foreground="{DynamicResource ForegroundColor}" VerticalAlignment="Center" Text="{x:Static lang:Resources.Window_Background}"/>
                                    <ColorPicker Color="{Binding BackgroundColor, Converter={x:Static converts:ColorToHexConverter.Instance}, Mode=TwoWay}"
                                                 IsAlphaEnabled="True"
                                                 HorizontalAlignment="Stretch" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,14" Spacing="6">
                                    <TextBlock Classes="Small" Foreground="{DynamicResource ForegroundColor}" VerticalAlignment="Center" Text="{x:Static lang:Resources.Subtitle_Background}"/>
                                    <ColorPicker Color="{Binding SubtitleBackgroundColor, Converter={x:Static converts:ColorToHexConverter.Instance}, Mode=TwoWay}"
                                                 IsAlphaEnabled="True"
                                                 HorizontalAlignment="Stretch" />
                                </StackPanel>

                                <StackPanel Margin="0,0,20,14" Spacing="6">
                                    <TextBlock Classes="Small" Foreground="{DynamicResource ForegroundColor}" VerticalAlignment="Center" Text="{x:Static lang:Resources.Window_Opacity}"/>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <Slider Value="{Binding WindowOpacity}" Minimum="0.1" Maximum="1.0"
                                                TickFrequency="0.01" IsSnapToTickEnabled="True"
                                                SmallChange="0.01" LargeChange="0.05"
                                                VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding WindowOpacity, StringFormat=P0}"
                                                   MinWidth="44" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MutedColor}"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,14" Spacing="6">
                                    <TextBlock Classes="Small" Foreground="{DynamicResource ForegroundColor}" VerticalAlignment="Center" Text="{x:Static lang:Resources.Speech_DisplayMode}"/>
                                    <ComboBox ItemsSource="{Binding DisplayModeOptions}"
                                              SelectedValue="{Binding FloatingDisplayMode}"
                                              SelectedValueBinding="{Binding Key}"
                                              DisplayMemberBinding="{Binding Value}"  HorizontalAlignment="Stretch"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,20,14" Spacing="6">
                                    <TextBlock Classes="Small" Foreground="{DynamicResource ForegroundColor}" VerticalAlignment="Center" Text="{x:Static lang:Resources.Window_Orientation}"/>
                                    <ComboBox ItemsSource="{Binding OrientationOptions}"
                                              SelectedItem="{Binding FloatingWindowOrientation}"  HorizontalAlignment="Stretch"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,14" Spacing="6">
                                    <TextBlock Classes="Small" Foreground="{DynamicResource ForegroundColor}" VerticalAlignment="Center" Text="{x:Static lang:Resources.Speech_AutoClear}"/>
                                    <NumericUpDown Value="{Binding AutoClearInterval}" FormatString="F0"
                                                   Minimum="0" Maximum="3600" Increment="5"  HorizontalAlignment="Stretch"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,20,0" Spacing="6"
                                            IsVisible="{Binding IsMaxSentencesPerLineVisible}">
                                    <TextBlock Classes="Small" Foreground="{DynamicResource ForegroundColor}" VerticalAlignment="Center" Text="{x:Static lang:Resources.Speech_MaxSentencesPerLine}"/>
                                    <NumericUpDown Value="{Binding MaxSentencesPerLine}" FormatString="F0"
                                                   Minimum="1" Maximum="100"  HorizontalAlignment="Stretch"/>
                                </StackPanel>
                                <StackPanel Spacing="6" IsVisible="{Binding IsSegmentedMode}">
                                    <TextBlock Classes="Small" Foreground="{DynamicResource ForegroundColor}" VerticalAlignment="Center" Text="{x:Static lang:Resources.Speech_MaxHistory}"/>
                                    <NumericUpDown Value="{Binding MaxFloatingHistory}" FormatString="F0"
                                                   Minimum="1" Maximum="20"  HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </UniformGrid>
                    </shad:Card>
                </StackPanel>
            </ScrollViewer>
            </Grid>
            
            <StackPanel Grid.Row="0"
                        Grid.RowSpan="3"
                        IsVisible="{Binding IsNotSupported}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="16">
                 <avalonia:MaterialIcon Kind="AlertCircleOutline"
                                        Width="48" Height="48"
                                        Foreground="{DynamicResource MutedColor}"
                                        HorizontalAlignment="Center"/>
                 <TextBlock Text="{x:Static lang:Resources.Speech_NotSupported}"
                            Classes="Muted" TextWrapping="Wrap" LineHeight="18" Opacity="0.95"
                            TextAlignment="Center"
                            HorizontalAlignment="Center"
                            MaxWidth="420"/>
            </StackPanel>
        </Grid>
    </Panel>
</UserControl>
