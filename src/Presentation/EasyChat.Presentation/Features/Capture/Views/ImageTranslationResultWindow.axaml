<shad:Window xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
                 xmlns:icon="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
                 xmlns:lang="clr-namespace:EasyChat.Presentation.Lang"
                 x:Class="EasyChat.Presentation.Features.Capture.Views.ImageTranslationResultWindow"
                 Title="{x:Static lang:Resources.ImageTranslate}"
                 Icon="avares://EasyChat.Desktop/Assets/easychat-logo.ico"
                 Width="1100"
                 Height="760"
                 MinWidth="560"
                 MinHeight="420"
                 WindowStartupLocation="CenterScreen"
                 Background="{DynamicResource WindowBackgroundColor}"
                 Foreground="{DynamicResource ForegroundColor}"
                 IsTitleBarVisible="True">

    <shad:Window.LogoContent>
        <icon:MaterialIcon Kind="ImageText"
                           Width="20"
                           Height="20"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource PrimaryColor}" />
    </shad:Window.LogoContent>

    <Grid RowDefinitions="*,Auto,Auto"
          Background="{DynamicResource WindowBackgroundColor}">
        <Border Grid.Row="0"
                Margin="16,12,16,0"
                Background="{DynamicResource GhostColor}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1"
                ClipToBounds="True" CornerRadius="{DynamicResource LgCornerRadius}" Padding="16">
            <Grid>
                <Image x:Name="TranslatedImage"
                       Margin="16"
                       Stretch="Uniform"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch" />
                <Border x:Name="LoadingPanel" Background="#73000000">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="12">
                        <shad:Loading Width="36" Height="36" />
                        <TextBlock Text="{x:Static lang:Resources.Loading}"
                                   Foreground="White"
                                   FontSize="14" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <shad:Card x:Name="WarningPanel"
                   Grid.Row="1"
                   Margin="16,10,16,0"
                   HasShadow="False"
                   IsVisible="False">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <icon:MaterialIcon Kind="AlertCircleOutline"
                                   Width="18"
                                   Height="18"
                                   VerticalAlignment="Top"
                                   Foreground="{DynamicResource WarningColor}" />
                <TextBlock x:Name="WarningText"
                           Grid.Column="1"
                           MaxLines="3"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedColor}" />
            </Grid>
        </shad:Card>

        <Border Grid.Row="2"
                Margin="0,12,0,0"
                Background="{DynamicResource CardBackgroundColor}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="0,1,0,0" CornerRadius="{DynamicResource LgCornerRadius}" Padding="24">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedColor}"
                           Text="PNG" />

                <Button x:Name="CopyButton" Grid.Column="1"
                        Classes="Ghost"
                        IsEnabled="False"
                        Click="Copy_OnClick"
                        ToolTip.Tip="{x:Static lang:Resources.Copy}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <icon:MaterialIcon Kind="ContentCopy" Width="18" Height="18" />
                        <TextBlock VerticalAlignment="Center" Text="{x:Static lang:Resources.Copy}" />
                    </StackPanel>
                </Button>

                <Button x:Name="SaveButton" Grid.Column="2"
                        Classes="Primary"
                        IsEnabled="False"
                        Click="Save_OnClick"
                        ToolTip.Tip="{x:Static lang:Resources.Save}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <icon:MaterialIcon Kind="ContentSave" Width="18" Height="18" />
                        <TextBlock VerticalAlignment="Center" Text="{x:Static lang:Resources.Save}" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="3"
                        Classes="Icon"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Click="Close_OnClick"
                        ToolTip.Tip="{x:Static lang:Resources.Close}">
                    <icon:MaterialIcon Kind="Close" Width="18" Height="18" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</shad:Window>
