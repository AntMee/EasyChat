<UserControl x:Class="EasyChat.Presentation.Features.Capture.Views.FixedAreaFormDialogView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:EasyChat.Presentation.Features.Capture"
             xmlns:lang="clr-namespace:EasyChat.Presentation.Lang;assembly=EasyChat.Presentation"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="300"
             x:DataType="viewModels:FixedAreaFormDialogViewModel"
             MinWidth="360"
             MaxWidth="420"
             Width="400">
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Padding="22,18,22,0">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <Border Width="40" Height="40" CornerRadius="11"
                        Background="{DynamicResource PrimaryColor10}">
                    <avalonia:MaterialIcon Kind="Crop"
                                           Width="20" Height="20"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryColor}" />
                </Border>
                <TextBlock Grid.Column="1"
                           Classes="Large" TextWrapping="Wrap"
                           Text="{x:Static lang:Resources.Edit}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Margin="0,14,0,0" Padding="22,0" MaxHeight="480" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">
                <StackPanel>
                    <TextBlock Classes="Small" Margin="0,0,0,6" Text="{x:Static lang:Resources.Name}" />
                    <TextBox Classes="Clearable" Text="{Binding Name}" />
                </StackPanel>

                <shad:Card HasShadow="False">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <avalonia:MaterialIcon Kind="VectorSquare" Width="16" Height="16"
                                                   Foreground="{DynamicResource PrimaryColor}" />
                            <TextBlock Text="{x:Static lang:Resources.Area}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundColor}" />
                        </StackPanel>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <TextBlock Text="{Binding DisplayInfo}"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedColor}"
                                       FontFamily="Cascadia Mono, Consolas, Menlo, Monaco, Liberation Mono, monospace"
                                       TextWrapping="Wrap" />
                            <Button Grid.Column="1" Classes="Ghost" Command="{Binding ReselectAreaCommand}"
                                    ToolTip.Tip="{x:Static lang:Resources.ReselectArea}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <avalonia:MaterialIcon Kind="Crop" Width="16" Height="16" />
                                    <TextBlock Text="{x:Static lang:Resources.Select}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </shad:Card>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Margin="0,12,0,0" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Background="{DynamicResource CardBackgroundColor}" CornerRadius="{DynamicResource LgCornerRadius}" Padding="24">
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <Button Content="{x:Static lang:Resources.Cancel}"
                        Classes="Ghost"
                        Command="{Binding CancelCommand}" />
                <Button Content="{x:Static lang:Resources.Save}"
                        Command="{Binding ConfirmCommand}"
                        Classes="Primary" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
