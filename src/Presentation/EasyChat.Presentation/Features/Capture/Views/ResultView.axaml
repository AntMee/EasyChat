<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
        xmlns:md="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia"
        xmlns:lang="clr-namespace:EasyChat.Presentation.Lang"
        xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="EasyChat.Presentation.Features.Capture.Views.ResultView"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        CanResize="False"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        Topmost="True"
        TransparencyLevelHint="Blur"
        CornerRadius="16"
        Background="Transparent"
        Title="ResultView"
        SizeToContent="WidthAndHeight"
        KeyDown="OnKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="ClassicResultForeground" Color="#FFFFFFFF" />
            <x:Double x:Key="ClassicResultFontSize">18</x:Double>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="md|MarkdownRenderer.ClassicResultMarkdown">
            <Style Selector="^ md|MarkdownTextBlock">
                <Setter Property="Foreground" Value="{DynamicResource ClassicResultForeground}" />
                <Setter Property="FontSize" Value="{DynamicResource ClassicResultFontSize}" />
                <Setter Property="FontFamily" Value="{DynamicResource ClassicResultFontFamily}" />
            </Style>
        </Style>
    </Window.Styles>

    <Panel x:Name="WindowBackground">
        <Border x:Name="MainCard"
                Background="{DynamicResource DialogBackgroundColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" ClipToBounds="False" CornerRadius="{DynamicResource LgCornerRadius}" Padding="16">
            <Border ClipToBounds="True">
            <Grid RowDefinitions="*,Auto" MinWidth="160" MinHeight="44">
                <Panel Margin="16,14,16,10">
                    <shad:Loading x:Name="LoadingIndicator"
                                  Width="22" Height="22"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  IsVisible="True" />
                    <md:MarkdownRenderer x:Name="MarkdownResult"
                                         Classes="ClassicResultMarkdown"
                                         IsVisible="False"
                                         HorizontalAlignment="Stretch"
                                         VerticalAlignment="Top"
                                         MaxWidth="480" />
                </Panel>

                <!-- Action bar: Copy is primary, Close secondary. Esc closes. -->
                <Border Grid.Row="1"
                        x:Name="ResultToolbar"
                        IsVisible="False"
                        Background="{DynamicResource CardBackgroundColor}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="0,1,0,0" CornerRadius="{DynamicResource LgCornerRadius}" Padding="24">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock x:Name="CopyHint" FontSize="11" Foreground="{DynamicResource MutedColor}"
                                   VerticalAlignment="Center"
                                   Text="{x:Static lang:Resources.ResultCopyHint}"
                                   IsVisible="False" />
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    HorizontalAlignment="Right">
                            <Button x:Name="CopyButton"
                                    Classes="Icon"
                                    ToolTip.Tip="{x:Static lang:Resources.Copy}"
                                    Click="OnCopyClick"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    AutomationProperties.Name="{x:Static lang:Resources.Copy}">
                                <icons:MaterialIcon Kind="ContentCopy" Width="16" Height="16" />
                            </Button>
                            <Button Classes="Icon"
                                    ToolTip.Tip="{x:Static lang:Resources.Close}"
                                    Click="OnCloseClick"
                                    AutomationProperties.Name="{x:Static lang:Resources.Close}">
                                <icons:MaterialIcon Kind="Close" Width="16" Height="16" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
            </Border>
        </Border>
    </Panel>
</Window>
