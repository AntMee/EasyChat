<UserControl x:Class="EasyChat.Presentation.Features.Capture.Views.FixedAreaEditDialogView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:EasyChat.Presentation.Features.Capture"
             xmlns:lang="clr-namespace:EasyChat.Presentation.Lang;assembly=EasyChat.Presentation"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="500"
             x:DataType="viewModels:FixedAreaEditDialogViewModel"
             MinWidth="380"
             MaxWidth="440"
             Width="400"
             x:Name="Root">
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Padding="22,18,22,0">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <Border Width="40" Height="40" CornerRadius="11"
                        Background="{DynamicResource PrimaryColor10}">
                    <avalonia:MaterialIcon Kind="Fullscreen"
                                           Width="20" Height="20"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryColor}" />
                </Border>
                <TextBlock Grid.Column="1"
                           Classes="Large" TextWrapping="Wrap"
                           Text="{x:Static lang:Resources.FixedAreas}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Margin="0,14,0,0" Padding="22,0" MaxHeight="400" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">
                <ItemsControl ItemsSource="{Binding FixedAreas}" IsVisible="{Binding HasAreas}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                            <Border Margin="0,0,0,10"
                                    Background="{DynamicResource GhostColor}"
                                    BorderBrush="{DynamicResource BorderColor}"
                                    BorderThickness="1" CornerRadius="{DynamicResource LgCornerRadius}" Padding="16">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ForegroundColor}" />
                                        <TextBlock Text="{Binding DisplayInfo}"
                                                   Classes="Caption"
                                                   Foreground="{DynamicResource MutedColor}" />
                                    </StackPanel>

                                    <ToggleSwitch Grid.Column="1"
                                                  IsChecked="{Binding IsEnabled}"
                                                  OnContent="{x:Null}"
                                                  OffContent="{x:Null}"
                                                  VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2"
                                                VerticalAlignment="Center">
                                        <Button
                                                Click="EditButton_Click"
                                                DataContext="{Binding}"
                                                ToolTip.Tip="{x:Static lang:Resources.Edit}" Classes="Icon">
                                            <avalonia:MaterialIcon Kind="Pencil" Width="16" Height="16"
                                                                   Foreground="{DynamicResource MutedColor}" />
                                        </Button>
                                        <Button
                                                Click="DeleteButton_Click"
                                                DataContext="{Binding}"
                                                ToolTip.Tip="{x:Static lang:Resources.Delete}" Classes="Icon">
                                            <avalonia:MaterialIcon Kind="TrashCan" Width="16" Height="16"
                                                                   Foreground="{DynamicResource DestructiveColor}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{x:Static lang:Resources.NoFixedAreas}"
                           IsVisible="{Binding !HasAreas}"
                           Classes="Muted"
                           HorizontalAlignment="Center"
                           Margin="0,12" />

                <Button
                        Margin="0"
                        MinHeight="72"
                        Command="{Binding AddAreaCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" Background="{DynamicResource PrimaryColor10}" BorderBrush="{DynamicResource BorderColor60}" BorderThickness="1" CornerRadius="{DynamicResource LgCornerRadius}" Padding="14,12">
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                        <avalonia:MaterialIcon Kind="Plus" Width="18" Height="18"
                                               Foreground="{DynamicResource PrimaryColor}" />
                        <TextBlock Text="{x:Static lang:Resources.AddFixedArea}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource ForegroundColor}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Classes="DialogFooter" Margin="0,12,0,0" Padding="24">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{x:Static lang:Resources.Close}"
                        Classes="Ghost"
                        Command="{Binding CloseCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
