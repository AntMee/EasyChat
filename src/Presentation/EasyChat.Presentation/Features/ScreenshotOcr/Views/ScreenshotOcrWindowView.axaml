<shad:Window xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:vm="using:EasyChat.Presentation.Features.ScreenshotOcr"
                 xmlns:controls="using:EasyChat.Presentation.Features.ScreenshotOcr.Controls"
                 xmlns:lang="clr-namespace:EasyChat.Presentation.Lang"
                 xmlns:sharedControls="clr-namespace:EasyChat.Presentation.Shared.Controls;assembly=EasyChat.Presentation.Shared"
                 xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
                 xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
                 x:Class="EasyChat.Presentation.Features.ScreenshotOcr.Views.ScreenshotOcrWindowView"
                 x:DataType="vm:ScreenshotOcrWindowViewModel"
                  Title="{x:Static lang:Resources.Action_ScreenshotOcr}"
                 Width="1200" Height="720" MinWidth="900" MinHeight="560"
                 Foreground="{DynamicResource ForegroundColor}"
                 CanResize="True"
                 IsTitleBarVisible="True"
                 ShowTitlebarBackground="True"
                  RootCornerRadius="12"
                  ShowBottomBorder="True"
                  TransparencyLevelHint="Transparent"
                 WindowDecorations="None"
                 ShowActivated="True"
                 WindowStartupLocation="CenterScreen">
    <shad:Window.LogoContent>
        <Border Width="28" Height="28"
                Margin="14,0,0,0"
                CornerRadius="8"
                VerticalAlignment="Center"
                Background="{DynamicResource PrimaryColor10}">
            <icons:MaterialIcon Kind="TextRecognition" Width="16" Height="16"
                                Foreground="{DynamicResource PrimaryColor}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </shad:Window.LogoContent>

    <shad:Window.RightWindowTitleBarContent>
        <Button x:Name="PinButton" Classes="Icon"
                Width="32" Height="32" Padding="0"
                Margin="0,0,4,0"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                Click="Pin_OnClick" ToolTip.Tip="{x:Static lang:Resources.ScreenshotOcr_PinTooltip}">
            <icons:MaterialIcon x:Name="PinIcon" Kind="PinOutline" Width="16" Height="16" />
        </Button>
    </shad:Window.RightWindowTitleBarContent>

    <shad:Window.Hosts>
        <shad:DialogHost Manager="{Binding DialogManager}" />
    </shad:Window.Hosts>

    <shad:Window.Styles>
        <Style Selector="shad|Window /template/ Border#RootBorder">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Margin" Value="1" />
        </Style>
        <Style Selector="Button.ToolButton">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.ContextButton">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </shad:Window.Styles>

    <Grid>
        <Border x:Name="MainSurface"
                Background="{DynamicResource WindowBackgroundColor}">
            <Grid ColumnDefinitions="*,8,*" Background="{DynamicResource WindowBackgroundColor}">
                    <Grid Grid.Column="0" Margin="10,10,4,10">
                        <controls:OcrImageViewport x:Name="Viewport"
                                                   IsSelectionBusy="{Binding IsEditingImage}" />

                        <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="14"
                                Padding="4" CornerRadius="7"
                                Background="{DynamicResource CardBackgroundColor}"
                                IsEnabled="{Binding !IsEditingImage}"
                                IsVisible="{Binding HasSelection}">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button Classes="ContextButton" Click="CopySelection_OnClick" ToolTip.Tip="{x:Static lang:Resources.ScreenshotOcr_CopySelectionTooltip}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <icons:MaterialIcon Kind="ContentCopy" Width="16" Height="16" />
                                        <TextBlock Text="{x:Static lang:Resources.Copy}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="ContextButton" Click="TranslateSelection_OnClick" ToolTip.Tip="{x:Static lang:Resources.ScreenshotOcr_TranslateSelectionTooltip}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <icons:MaterialIcon Kind="Translate" Width="16" Height="16" />
                                        <TextBlock Text="{x:Static lang:Resources.TextAssistTranslate}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="ContextButton" Click="ExplainSelection_OnClick" ToolTip.Tip="{x:Static lang:Resources.ScreenshotOcr_ExplainSelectionTooltip}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <icons:MaterialIcon Kind="LightbulbOnOutline" Width="16" Height="16" />
                                        <TextBlock Text="{x:Static lang:Resources.TextAssistExplain}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="ContextButton" Click="ReplaceSelection_OnClick" ToolTip.Tip="{x:Static lang:Resources.ScreenshotOcr_ReplaceSelectionTooltip}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <icons:MaterialIcon Kind="ImageEditOutline" Width="16" Height="16" />
                                        <TextBlock Text="{x:Static lang:Resources.ScreenshotOcr_Replace}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14"
                                Padding="4" CornerRadius="7"
                                Background="{DynamicResource CardBackgroundColor}">
                            <StackPanel Orientation="Horizontal" Spacing="1">
                                <Button Classes="ToolButton" Click="ZoomOut_OnClick" ToolTip.Tip="{x:Static lang:Resources.ScreenshotOcr_ZoomOutTooltip}">
                                    <icons:MaterialIcon Kind="MagnifyMinusOutline" Width="18" Height="18" />
                                </Button>
                                <TextBlock Width="50" Text="{Binding ZoomText}" TextAlignment="Center" VerticalAlignment="Center" />
                                <Button Classes="ToolButton" Click="ZoomIn_OnClick" ToolTip.Tip="{x:Static lang:Resources.ScreenshotOcr_ZoomInTooltip}">
                                    <icons:MaterialIcon Kind="MagnifyPlusOutline" Width="18" Height="18" />
                                </Button>
                                <Border Width="1" Margin="4,6" Background="{DynamicResource BorderColor}" />
                                <Button Classes="ToolButton" Click="OpenImage_OnClick" ToolTip.Tip="{x:Static lang:Resources.ScreenshotOcr_OpenImageTooltip}">
                                    <icons:MaterialIcon Kind="FileImageOutline" Width="18" Height="18" />
                                </Button>
                                <Button Classes="ToolButton" Click="Recapture_OnClick" ToolTip.Tip="{x:Static lang:Resources.ScreenshotOcr_RecaptureTooltip}">
                                    <icons:MaterialIcon Kind="MonitorScreenshot" Width="18" Height="18" />
                                </Button>
                                <Button Classes="ToolButton" Click="CopyImage_OnClick" ToolTip.Tip="{x:Static lang:Resources.ScreenshotOcr_CopyImageTooltip}">
                                    <icons:MaterialIcon Kind="ImageMultipleOutline" Width="18" Height="18" />
                                </Button>
                                <Border Width="1" Margin="4,6" Background="{DynamicResource BorderColor}" />
                                <Button Classes="ToolButton" Click="Undo_OnClick" ToolTip.Tip="{x:Static lang:Resources.ScreenshotOcr_UndoTooltip}" IsEnabled="{Binding CanUndo}">
                                    <icons:MaterialIcon Kind="Undo" Width="18" Height="18" />
                                </Button>
                                <Button Classes="ToolButton" Click="Redo_OnClick" ToolTip.Tip="{x:Static lang:Resources.ScreenshotOcr_RedoTooltip}" IsEnabled="{Binding CanRedo}">
                                    <icons:MaterialIcon Kind="Redo" Width="18" Height="18" />
                                </Button>
                                <Button Classes="ToolButton" Click="Restore_OnClick" ToolTip.Tip="{x:Static lang:Resources.ScreenshotOcr_RestoreTooltip}">
                                    <icons:MaterialIcon Kind="BackupRestore" Width="18" Height="18" />
                                </Button>
                                <Button Classes="ToolButton" Click="TranslateImage_OnClick"
                                        ToolTip.Tip="{x:Static lang:Resources.ScreenshotOcr_TranslateImageTooltip}"
                                        IsEnabled="{Binding !IsBusy}">
                                    <Grid Width="18" Height="18">
                                        <icons:MaterialIcon Kind="Translate" Width="18" Height="18"
                                                            IsVisible="{Binding !IsEditingImage}" />
                                        <shad:Loading Width="18" Height="18"
                                                      IsVisible="{Binding IsEditingImage}" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Border Background="#73000000" CornerRadius="7" IsVisible="{Binding IsRecognizing}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                                <shad:Loading Width="34" Height="34" />
                                <TextBlock Text="{x:Static lang:Resources.ScreenshotOcr_Recognizing}" Foreground="White" FontSize="14" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <GridSplitter Grid.Column="1" Width="1" Margin="3,0"
                                  Background="{DynamicResource BorderColor}"
                                  HorizontalAlignment="Stretch" ResizeDirection="Columns" />

                    <Grid Grid.Column="2"
                          Margin="4,8,8,8"
                          RowDefinitions="Auto,*,Auto">
                            <Grid>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Static lang:Resources.ScreenshotOcr_RecognizedText}" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding SourceText.Length, StringFormat={x:Static lang:Resources.ScreenshotOcr_CharacterCount}}"
                                                   FontSize="11" Opacity="0.55" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding ErrorMessage}" Foreground="IndianRed"
                                               FontSize="11" TextWrapping="Wrap" MaxHeight="34" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,0,0,0">
                                <TextBox Text="{Binding SourceText, Mode=TwoWay}"
                                         IsVisible="{Binding !IsShowingTranslation}"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalContentAlignment="Top"
                                         Padding="12" CornerRadius="6" />
                                <TextBox Text="{Binding TranslatedText, Mode=TwoWay}"
                                         IsVisible="{Binding IsShowingTranslation}"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalContentAlignment="Top"
                                         Padding="12" CornerRadius="6" />
                                <Border Background="#50000000" CornerRadius="6"
                                        IsVisible="{Binding IsTranslating}">
                                    <shad:Loading Width="30" Height="30"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>

                            <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="4" Margin="0,8,0,0">
                                <Button Grid.Column="0" Classes="ToolButton" Click="Retry_OnClick" ToolTip.Tip="{x:Static lang:Resources.ScreenshotOcr_RetryTooltip}">
                                    <icons:MaterialIcon Kind="Refresh" Width="18" Height="18" />
                                </Button>
                                <Button Grid.Column="1" Classes="ToolButton" Click="CopyText_OnClick" ToolTip.Tip="{x:Static lang:Resources.ScreenshotOcr_CopyTextTooltip}">
                                    <icons:MaterialIcon Kind="ContentCopy" Width="18" Height="18" />
                                </Button>
                                <Button Grid.Column="2" Classes="ToolButton" Click="TranslateText_OnClick" ToolTip.Tip="{x:Static lang:Resources.ScreenshotOcr_TranslateTextTooltip}">
                                    <icons:MaterialIcon Kind="Translate" Width="18" Height="18" />
                                </Button>
                                <Button Grid.Column="3" Classes="ToolButton" Click="ShowOriginal_OnClick" ToolTip.Tip="{x:Static lang:Resources.ScreenshotOcr_ShowOriginalTooltip}">
                                    <icons:MaterialIcon Kind="TextBoxOutline" Width="18" Height="18" />
                                </Button>
                                <sharedControls:LanguageSelector Grid.Column="5" Width="178" Height="36" MinHeight="36"
                                                              Languages="{Binding Languages}"
                                                              SelectedLanguage="{Binding CandidateLanguage, Mode=TwoWay}" />
                            </Grid>
                    </Grid>
            </Grid>
        </Border>
    </Grid>
</shad:Window>
