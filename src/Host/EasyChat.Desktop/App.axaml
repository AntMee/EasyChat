<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EasyChat.Desktop.App"
             xmlns:local="using:EasyChat.Desktop"
             xmlns:md="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia"
             xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             RequestedThemeVariant="Default">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="EcDialogSurfaceBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="EcDialogFooterBrush" Color="#FFF7F7F8" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="EcDialogSurfaceBrush" Color="#FF000000" />
                    <SolidColorBrush x:Key="EcDialogFooterBrush" Color="#FF0D0D0D" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <FontFamily x:Key="ShadUiDemoFontFamily">avares://EasyChat.Desktop/Assets/Fonts#Manrope</FontFamily>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <shad:ShadTheme />
        <!-- ShadUI adds an 8px transparent root margin for maximized Windows. -->
        <Style Selector="shad|Window[WindowState=Maximized] /template/ Border#PART_WindowRoot">
            <Setter Property="Margin" Value="0" />
        </Style>
        <avalonia:MaterialIconStyles />
        <StyleInclude Source="avares://LiveMarkdown.Avalonia/Styles.axaml" />
        <Style Selector="md|MarkdownRenderer ScrollViewer.Table Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
        </Style>
        <!-- App-wide typeface: keeps CJK rendering across all controls. -->
        <Style Selector="TextElement">
            <Setter Property="TextElement.FontFamily" Value="Inter, Microsoft YaHei UI, Microsoft YaHei, PingFang SC, Hiragino Sans GB, Noto Sans CJK SC, Noto Sans SC, Segoe UI, sans-serif" />
        </Style>
        <!-- Keep the ColorPicker and its popup typography aligned with the ShadUI demo. -->
        <Style Selector="ColorPicker">
            <Setter Property="TextElement.FontFamily" Value="{StaticResource ShadUiDemoFontFamily}" />
        </Style>
        <Style Selector="ColorPicker TextElement">
            <Setter Property="TextElement.FontFamily" Value="{StaticResource ShadUiDemoFontFamily}" />
        </Style>
        <Style Selector="shad|DialogHost /template/ Border#PART_DialogBackground">
            <Setter Property="Background" Value="{DynamicResource EcDialogSurfaceBrush}" />
        </Style>
        <Style Selector="Border.DialogFooter">
            <Setter Property="Background" Value="{DynamicResource EcDialogFooterBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="CornerRadius" Value="0,0,8,8" />
        </Style>
        <Style Selector="ToolTip">
            <Setter Property="Background" Value="{DynamicResource PrimaryColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryColor}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundColor}" />
            <Setter Property="Padding" Value="8,4" />
        </Style>

        <!-- Keep update feedback consistent with the OCR model download progress bar. -->
        <Style Selector="ProgressBar.UpdateProgress">
            <Setter Property="Height" Value="7" />
            <Setter Property="MinHeight" Value="7" />
            <Setter Property="MaxHeight" Value="7" />
            <Setter Property="Background" Value="{DynamicResource BorderColor30}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryColor}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="ProgressBar.UpdateProgress /template/ Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="ProgressBar.UpdateProgress /template/ Rectangle">
            <Setter Property="RadiusX" Value="4" />
            <Setter Property="RadiusY" Value="4" />
        </Style>
        <Style Selector="Border.UpdateToastIconSurface">
            <Setter Property="Background" Value="{DynamicResource PrimaryColor10}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryColor}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="avalonia|MaterialIcon.UpdateToastIcon">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryColor}" />
        </Style>
    </Application.Styles>
</Application>
