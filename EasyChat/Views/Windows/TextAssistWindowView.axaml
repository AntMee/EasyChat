<suki:SukiWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:suki="https://github.com/kikipoulet/SukiUI"
                 xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
                 xmlns:lang="clr-namespace:EasyChat.Lang"
                 x:Class="EasyChat.Views.Windows.TextAssistWindowView"
                 Width="1000" Height="560" MinWidth="700" MinHeight="420"
                 WindowStartupLocation="CenterScreen"
                 WindowDecorations="None"
                 ExtendClientAreaToDecorationsHint="True"
                 TransparencyLevelHint="Blur"
                 Background="Transparent"
                 Foreground="{DynamicResource SukiText}"
                 IsTitleBarVisible="False"
                 RootCornerRadius="14"
                 Topmost="True"
                 ShowInTaskbar="False"
                 CornerRadius="14"
                 Title="Text Assist">
    <suki:GlassCard x:Name="MainCard"
                    CornerRadius="14"
                    Padding="0"
                    Background="{DynamicResource SukiBackground}"
                    BorderBrush="{DynamicResource SukiBorderBrush}"
                    BorderThickness="1">
        <Grid RowDefinitions="Auto,*">
            <Border Grid.Row="0"
                    Padding="16,12"
                    Background="{DynamicResource SukiCardBackground}"
                    BorderBrush="{DynamicResource SukiBorderBrush}"
                    BorderThickness="0,0,0,1"
                    PointerPressed="OnHeaderPointerPressed">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <avalonia:MaterialIcon Kind="Translate" Width="20" Height="20" Foreground="{DynamicResource SukiPrimaryColor}" />
                        <TextBlock Text="{x:Static lang:Resources.TextAssist}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource SukiText}" />
                    </StackPanel>
                    <Button Grid.Column="1" Click="OnCloseClick" Classes="Basic"
                            ToolTip.Tip="{x:Static lang:Resources.Close}">
                        <avalonia:MaterialIcon Kind="Close" />
                    </Button>
                </Grid>
            </Border>
            <ContentControl Grid.Row="1" x:Name="EditorHost" Margin="25" />
        </Grid>
    </suki:GlassCard>
</suki:SukiWindow>
