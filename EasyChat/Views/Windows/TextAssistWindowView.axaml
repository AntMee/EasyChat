<suki:SukiWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:suki="https://github.com/kikipoulet/SukiUI"
                 xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
                 xmlns:lang="clr-namespace:EasyChat.Lang"
                 xmlns:vm="using:EasyChat.ViewModels.Pages"
                 x:Class="EasyChat.Views.Windows.TextAssistWindowView"
                 x:DataType="vm:TextAssistViewModel"
                 Width="1000" Height="560" MinWidth="700" MinHeight="420"
                 CanResize="True"
                 WindowStartupLocation="CenterScreen"
                 WindowDecorations="None"
                 ExtendClientAreaToDecorationsHint="True"
                 TransparencyLevelHint="Blur"
                 Background="Transparent"
                 Foreground="{DynamicResource SukiText}"
                 IsTitleBarVisible="False"
                 RootCornerRadius="14"
                 Topmost="True"
                 ShowInTaskbar="False"
                 CornerRadius="14"
                 Title="{Binding WindowTitle}">
    <Grid>
        <suki:GlassCard x:Name="MainCard"
                        CornerRadius="14"
                        Padding="0"
                        Background="{DynamicResource SukiBackground}"
                        BorderBrush="{DynamicResource SukiBorderBrush}"
                        BorderThickness="1">
            <Grid RowDefinitions="Auto,*">
                <Border Grid.Row="0"
                        Padding="16,12"
                        Background="{DynamicResource SukiCardBackground}"
                        BorderBrush="{DynamicResource SukiBorderBrush}"
                        BorderThickness="0,0,0,1"
                        PointerPressed="OnHeaderPointerPressed">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <avalonia:MaterialIcon Kind="{Binding WindowIcon}" Width="20" Height="20" Foreground="{DynamicResource SukiPrimaryColor}" />
                            <TextBlock Text="{Binding WindowTitle}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource SukiText}" />
                        </StackPanel>
                        <suki:Loading Grid.Column="1" Width="18" Height="18" Margin="0,0,8,0"
                                      IsVisible="{Binding IsCapturingInput}" />
                        <Button Grid.Column="2" Click="OnCloseClick" Classes="Basic"
                                ToolTip.Tip="{x:Static lang:Resources.Close}">
                            <avalonia:MaterialIcon Kind="Close" />
                        </Button>
                    </Grid>
                </Border>
                <ContentControl Grid.Row="1" x:Name="EditorHost" Margin="25" />
            </Grid>
        </suki:GlassCard>

        <!-- A borderless window needs explicit hit targets for native resize drags. -->
        <Border Width="6" HorizontalAlignment="Left" Background="Transparent"
                Cursor="LeftSide" Tag="West" PointerPressed="OnResizePointerPressed" />
        <Border Width="6" HorizontalAlignment="Right" Background="Transparent"
                Cursor="RightSide" Tag="East" PointerPressed="OnResizePointerPressed" />
        <Border Height="6" VerticalAlignment="Top" Background="Transparent"
                Cursor="TopSide" Tag="North" PointerPressed="OnResizePointerPressed" />
        <Border Height="6" VerticalAlignment="Bottom" Background="Transparent"
                Cursor="BottomSide" Tag="South" PointerPressed="OnResizePointerPressed" />

        <Border Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="Transparent" Cursor="TopLeftCorner" Tag="NorthWest"
                PointerPressed="OnResizePointerPressed" />
        <Border Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Top"
                Background="Transparent" Cursor="TopRightCorner" Tag="NorthEast"
                PointerPressed="OnResizePointerPressed" />
        <Border Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Background="Transparent" Cursor="BottomLeftCorner" Tag="SouthWest"
                PointerPressed="OnResizePointerPressed" />
        <Border Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Background="Transparent" Cursor="BottomRightCorner" Tag="SouthEast"
                PointerPressed="OnResizePointerPressed">
            <avalonia:MaterialIcon Kind="ResizeBottomRight" Width="14" Height="14"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                   Margin="0,0,2,2" Opacity="0.45" IsHitTestVisible="False" />
        </Border>
    </Grid>
</suki:SukiWindow>
