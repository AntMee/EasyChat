<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EasyChat.ViewModels.Pages"
             xmlns:textAssist="using:EasyChat.Models.Translation.TextAssist"
             xmlns:lang="clr-namespace:EasyChat.Lang"
             xmlns:converters="clr-namespace:EasyChat.Converters"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="EasyChat.Views.Pages.TextAssistTranslationView"
             x:Name="TranslationView"
             x:DataType="vm:TextAssistTranslationViewModel">
    <UserControl.Styles>
        <Style Selector="ComboBox /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource SukiText}" />
        </Style>
        <Style Selector="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource SukiText}" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="*,Auto,Auto" RowSpacing="10" MinHeight="0">
        <Grid Grid.Row="0" RowSpacing="0" MinHeight="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="{Binding ShowAnnotations, Converter={x:Static converters:BoolToGridLengthConverter.Instance}, ConverterParameter=160}" />
            </Grid.RowDefinitions>
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,*" ColumnSpacing="4" MinHeight="150" VerticalAlignment="Stretch">
                <suki:GlassCard CornerRadius="10" Padding="16">
                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{x:Static lang:Resources.SourceLang}" FontWeight="SemiBold" FontSize="16" />
                            <Button Grid.Column="1" Classes="Basic" Command="{Binding SpeakSourceCommand}" ToolTip.Tip="{x:Static lang:Resources.ReadAloudMode_Source}">
                                <avalonia:MaterialIcon Kind="VolumeHigh" />
                            </Button>
                        </Grid>
                        <ComboBox Grid.Row="1" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedSourceLanguage}">
                            <ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="6">
                                <Panel Width="22" Height="16"><avalonia:MaterialIcon Kind="FlagOutline" Opacity="0.65" /><Image Width="22" Height="16" Source="{Binding Icon, Converter={x:Static converters:LanguageFlagConverters.ToIcon}}" /></Panel>
                                <TextBlock Text="{Binding DisplayName}" />
                            </StackPanel></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        <Grid Grid.Row="2">
                            <TextBox x:Name="SourceTextBox" Text="{Binding InputText, Mode=TwoWay}"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100"
                                     Watermark="{x:Static lang:Resources.TextAssistInputWatermark}"
                                     VerticalContentAlignment="Top" BorderThickness="0" Background="Transparent"
                                     />
                        </Grid>
                    </Grid>
                </suki:GlassCard>

                <Button Grid.Column="1" Classes="Basic" Padding="4" VerticalAlignment="Center" Command="{Binding SwapContentCommand}"
                        ToolTip.Tip="{x:Static lang:Resources.ReverseTranslateLanguageTip}">
                    <avalonia:MaterialIcon Kind="SwapHorizontal" Width="24" Height="24" />
                </Button>

                <suki:GlassCard Grid.Column="2" CornerRadius="10" Padding="16">
                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBlock Text="{x:Static lang:Resources.TargetLang}" FontWeight="SemiBold" FontSize="16" />
                            <Button Grid.Column="1" Classes="Basic" Click="OnCopyClick" ToolTip.Tip="{x:Static lang:Resources.Copy}">
                                <avalonia:MaterialIcon Kind="ContentCopy" />
                            </Button>
                            <Button Grid.Column="2" Classes="Basic" Command="{Binding SpeakResultCommand}" ToolTip.Tip="{x:Static lang:Resources.ReadAloudMode_Target}">
                                <avalonia:MaterialIcon Kind="VolumeHigh" />
                            </Button>
                        </Grid>
                        <ComboBox Grid.Row="1" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedTargetLanguage}">
                            <ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="6">
                                <Panel Width="22" Height="16"><avalonia:MaterialIcon Kind="FlagOutline" Opacity="0.65" /><Image Width="22" Height="16" Source="{Binding Icon, Converter={x:Static converters:LanguageFlagConverters.ToIcon}}" /></Panel>
                                <TextBlock Text="{Binding DisplayName}" />
                            </StackPanel></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        <Grid Grid.Row="2">
                            <TextBox x:Name="ResultTextBox" Text="{Binding TranslationResult}" IsReadOnly="True"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" FontSize="18"
                                     VerticalContentAlignment="Top" BorderThickness="0" Background="Transparent"
                                     Watermark="{x:Static lang:Resources.Loading}" />
                        </Grid>
                    </Grid>
                </suki:GlassCard>
        </Grid>

            <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch"
                          Margin="0,6,0,6"
                          Background="{DynamicResource SukiControlBorderBrush}"
                          Opacity="0.75" Cursor="SizeNorthSouth"
                          ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                          IsVisible="{Binding ShowAnnotations}" />

            <suki:GlassCard Grid.Row="2" CornerRadius="10" Padding="16" MinHeight="80"
                            IsVisible="{Binding ShowAnnotations}">
                <Grid RowDefinitions="Auto,*" RowSpacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <avalonia:MaterialIcon Kind="BookOpenVariant" Width="18" Height="18"
                                               Foreground="{DynamicResource SukiPrimaryColor}" />
                        <TextBlock Text="{x:Static lang:Resources.TextAssistAnnotations}"
                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Annotations}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="textAssist:TextAssistTranslationAnnotationEvent">
                                                <Border Margin="0,0,0,8" Padding="10" CornerRadius="6"
                                                        Background="{DynamicResource SukiCardBackground}"
                                                        BorderBrush="{DynamicResource SukiControlBorderBrush}"
                                                        BorderThickness="1">
                                                    <StackPanel Spacing="5">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <Button Classes="Basic" Padding="0"
                                                                    Command="{Binding #TranslationView.((vm:TextAssistTranslationViewModel)DataContext).LookupAnnotationCommand}"
                                                                    CommandParameter="{Binding Term}"
                                                                    ToolTip.Tip="{x:Static lang:Resources.ResultWindowMode_Dictionary}">
                                                                <TextBlock Text="{Binding Term}" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource SukiPrimaryColor}"
                                                                           TextDecorations="Underline" />
                                                            </Button>
                                                            <Border Padding="6,2" CornerRadius="4"
                                                                    Background="{DynamicResource SukiControlBorderBrush}">
                                                                <TextBlock Text="{Binding DisplayCategory}" FontSize="11" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Meaning}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Opacity="0.75"
                                                                   IsVisible="{Binding HasNote}" />
                                                        <StackPanel Orientation="Horizontal" Spacing="6"
                                                                    IsVisible="{Binding HasRelatedTerms}">
                                                            <TextBlock Text="{x:Static lang:Resources.TextAssistRelatedTerms}"
                                                                       FontSize="12" Opacity="0.65" VerticalAlignment="Center" />
                                                            <ItemsControl ItemsSource="{Binding RelatedTerms}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="x:String">
                                                                        <Button Classes="Basic" Padding="3,0"
                                                                                Command="{Binding #TranslationView.((vm:TextAssistTranslationViewModel)DataContext).LookupAnnotationCommand}"
                                                                                CommandParameter="{Binding}">
                                                                            <TextBlock Text="{Binding}"
                                                                                       Foreground="{DynamicResource SukiPrimaryColor}"
                                                                                       TextDecorations="Underline" FontSize="12" />
                                                                        </Button>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </suki:GlassCard>
        </Grid>

            <suki:GlassCard Grid.Row="1" CornerRadius="10" Padding="16">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{x:Static lang:Resources.TransEngine}" FontSize="12" Opacity="0.7" />
                            <ComboBox ItemsSource="{Binding AvailableProviders}" SelectedItem="{Binding SelectedProvider}">
                            <ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="6">
                                <avalonia:MaterialIcon Kind="{Binding Converter={x:Static converters:TranslationEngineStringToIconKindConverter.Instance}}" Width="18" />
                                <TextBlock Text="{Binding}" />
                            </StackPanel></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4" IsVisible="{Binding IsAiProvider}">
                            <TextBlock Text="{x:Static lang:Resources.UsingAiModel}" FontSize="12" Opacity="0.7" />
                            <ComboBox ItemsSource="{Binding AvailableAiModels}" SelectedItem="{Binding SelectedAiModel}">
                            <ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="6">
                                <Panel Width="18" Height="18"><avalonia:MaterialIcon Kind="Translate" Opacity="0.65" /><Image Width="18" Height="18" Source="{Binding ModelType, Converter={x:Static converters:AiModelTypeConverters.ToIcon}}" /></Panel>
                                <TextBlock Text="{Binding Name}" />
                            </StackPanel></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Text="{x:Static lang:Resources.Prompts}" FontSize="12" Opacity="0.7" />
                            <ComboBox ItemsSource="{Binding PromptEntries}" SelectedValue="{Binding SelectedPromptId}" SelectedValueBinding="{Binding Id}">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" IsVisible="{Binding IsMachineProvider}">
                        <TextBlock Text="{x:Static lang:Resources.MachineTranslation}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding MachineProviders}" SelectedItem="{Binding SelectedMachineProvider}">
                            <ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="6">
                                <Panel Width="18" Height="18"><avalonia:MaterialIcon Kind="Translate" Opacity="0.65" /><Image Width="18" Height="18" Source="{Binding Converter={x:Static converters:EngineConverters.ToIcon}}" /></Panel>
                                <TextBlock Text="{Binding}" />
                            </StackPanel></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"
                          ToolTip.Tip="{x:Static lang:Resources.TextAssistDetailedExplanationTip}">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <avalonia:MaterialIcon Kind="BookEducationOutline" Width="18" Height="18" />
                            <TextBlock Text="{x:Static lang:Resources.TextAssistDetailedExplanation}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding DetailedExplanation}"
                                      IsEnabled="{Binding IsAiProvider}" OnContent="" OffContent="" />
                    </Grid>
                </StackPanel>
            </suki:GlassCard>

            <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                <Button Command="{Binding RunCommand}" Classes="Flat">
                    <StackPanel Orientation="Horizontal" Spacing="6"><avalonia:MaterialIcon Kind="Translate" /><TextBlock Text="{x:Static lang:Resources.TextAssistTranslate}" /></StackPanel>
                </Button>
                <Button Grid.Column="1" Command="{Binding CancelCommand}" Classes="Flat" IsVisible="{Binding IsBusy}">
                    <StackPanel Orientation="Horizontal" Spacing="6"><avalonia:MaterialIcon Kind="Stop" /><TextBlock Text="{x:Static lang:Resources.Cancel}" /></StackPanel>
                </Button>
                <TextBlock Grid.Column="2" Text="{Binding ErrorMessage}" Foreground="IndianRed" TextWrapping="Wrap" VerticalAlignment="Center" />
            </Grid>
    </Grid>
</UserControl>
